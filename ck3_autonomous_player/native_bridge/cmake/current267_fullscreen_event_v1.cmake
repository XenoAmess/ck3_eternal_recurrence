get_filename_component(_xar_fullscreen_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_xar_fullscreen_new src/ck3_121003_fullscreen_event26785313_raw_v1.cpp src/ck3_121003_fullscreen_event26785313_owner_v1.cpp src/ck3_121003_fullscreen_event26785313_wire_v1.cpp src/ck3_121003_fullscreen_event26785313_dispatch_v1.cpp)
