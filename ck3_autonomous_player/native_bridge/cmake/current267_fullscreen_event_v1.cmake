  foreach(_xar_unit IN LISTS _xar_fullscreen_new ITEMS src/ck3_121003_date_advance26785313_v1.cpp src/ck3_121003_readonly26785313_v1.cpp src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp)
   set_property(SOURCE "${_xar_fullscreen_root}/${_xar_unit}" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_FULLSCREEN_EVENT_V1=1>")
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_FULLSCREEN_EVENT_V1)
 set_property(SOURCE "${_xar_fullscreen_root}/src/bridge.cpp" "${_xar_fullscreen_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_FULLSCREEN_EVENT_V1=1>")
endif()
if(BUILD_TESTING AND WIN32)
 add_executable(xar_ck3_current_fullscreen_event_wire_test EXCLUDE_FROM_ALL "${_xar_fullscreen_root}/src/ck3_121003_fullscreen_event26785313_wire_v1.cpp" "${_xar_fullscreen_root}/src/ck3_121003_fullscreen_event26785313_wire_v1_test.cpp")
 add_executable(xar_ck3_current_fullscreen_off_test EXCLUDE_FROM_ALL "${_xar_fullscreen_root}/src/ck3_121003_fullscreen_event26785313_raw_v1.cpp" "${_xar_fullscreen_root}/src/ck3_121003_fullscreen_event26785313_off_v1_test.cpp")
 foreach(_xar_test IN ITEMS xar_ck3_current_fullscreen_event_wire_test xar_ck3_current_fullscreen_off_test)
  target_include_directories(${_xar_test} PRIVATE "${_xar_fullscreen_root}/include" "${_xar_fullscreen_root}/src")
  target_compile_features(${_xar_test} PRIVATE cxx_std_20)
  target_compile_definitions(${_xar_test} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN XAR_CK3_ENABLE_121003_26785313_FULLSCREEN_EVENT_V1=0)
