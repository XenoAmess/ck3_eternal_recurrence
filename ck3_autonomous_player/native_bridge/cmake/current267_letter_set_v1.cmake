 add_executable(xar_ck3_current_letter_set_off_test EXCLUDE_FROM_ALL "${_xar_letter_set_root}/src/ck3_121003_letter_set26785313_raw_v1.cpp" "${_xar_letter_set_root}/src/ck3_121003_letter_set26785313_wire_v1.cpp" "${_xar_letter_set_root}/src/ck3_121003_letter_set26785313_off_v1_test.cpp")
 foreach(_xar_test IN ITEMS xar_ck3_current_letter_set_wire_test xar_ck3_current_letter_set_off_test)
  target_include_directories(${_xar_test} PRIVATE "${_xar_letter_set_root}/include" "${_xar_letter_set_root}/src")
