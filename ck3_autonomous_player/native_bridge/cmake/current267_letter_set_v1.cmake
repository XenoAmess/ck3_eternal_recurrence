 set_property(SOURCE "${_xar_letter_set_root}/src/bridge.cpp" "${_xar_letter_set_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_LETTER_SET_V1=1>")
