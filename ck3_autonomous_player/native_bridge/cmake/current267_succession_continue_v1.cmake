# Official default succession lifecycle; independent from living gameplay Core.
option(XAR_CK3_ENABLE_121003_26785313_SUCCESSION_CONTINUE_V1 "Enable exact current267 official succession default query/once Continue" OFF)
get_filename_component(_xar_succ_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_xar_succ_new src/ck3_121003_succession_continue26785313_raw_v1.cpp src/ck3_121003_succession_lifecycle26785313_owner_v1.cpp
 src/ck3_121003_succession_lifecycle26785313_wire_v1.cpp src/ck3_121003_succession_lifecycle26785313_dispatch_v1.cpp)
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(_xar_unit IN LISTS _xar_succ_new)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_xar_succ_root}/${_xar_unit}")
 endforeach()
 if(XAR_CK3_ENABLE_121003_26785313_SUCCESSION_CONTINUE_V1)
  if(NOT XAR_CK3_ENABLE_121003_26785313_CORE_ROUTE_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_GUI_WINDOW_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_GUI_ROOT_INDEX_V1)
   message(FATAL_ERROR "Official succession requires exact owner/image and widget source bindings")
  endif()
  foreach(_xar_unit IN LISTS _xar_succ_new ITEMS src/ck3_121003_readonly26785313_v1.cpp src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp)
   set_property(SOURCE "${_xar_succ_root}/${_xar_unit}" APPEND PROPERTY COMPILE_DEFINITIONS
    "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_SUCCESSION_CONTINUE_V1=1>")
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_SUCCESSION_CONTINUE_V1)
 set_property(SOURCE "${_xar_succ_root}/src/bridge.cpp" "${_xar_succ_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS
  "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_SUCCESSION_CONTINUE_V1=1>")
endif()
if(BUILD_TESTING AND WIN32)
 add_executable(xar_ck3_current_succession_wire_test EXCLUDE_FROM_ALL "${_xar_succ_root}/src/ck3_121003_succession_lifecycle26785313_wire_v1_test.cpp")
 add_executable(xar_ck3_current_succession_off_test EXCLUDE_FROM_ALL "${_xar_succ_root}/src/ck3_121003_succession_lifecycle26785313_off_test.cpp" "${_xar_succ_root}/src/ck3_121003_succession_continue26785313_raw_v1.cpp")
 foreach(_xar_test IN ITEMS xar_ck3_current_succession_wire_test xar_ck3_current_succession_off_test)
  target_include_directories(${_xar_test} PRIVATE "${_xar_succ_root}/include" "${_xar_succ_root}/src")
  target_compile_features(${_xar_test} PRIVATE cxx_std_20)
  target_compile_definitions(${_xar_test} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN XAR_CK3_ENABLE_121003_26785313_SUCCESSION_CONTINUE_V1=0)
  if(MSVC)
   target_compile_options(${_xar_test} PRIVATE /W4 /WX /permissive- /EHsc)
  endif()
  add_test(NAME ${_xar_test} COMMAND ${_xar_test})
 endforeach()
endif()
