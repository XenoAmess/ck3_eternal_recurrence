# Actual paused player's primary Title only. Default OFF, no action capability.
option(XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1 "Enable fixed current primary title readonly query" OFF)
get_filename_component(_rmtm_title_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_rmtm_title_units
 src/ck3_121003_rmtm_title26785313_raw_v1.cpp
 src/ck3_121003_rmtm_title_query26785313_capture_v1.cpp
 src/ck3_121003_rmtm_title_query26785313_wire_v1.cpp
 src/ck3_121003_rmtm_title_query26785313_owner_v1.cpp
 src/ck3_121003_rmtm_title_query26785313_dispatch_v1.cpp)
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(u IN LISTS _rmtm_title_units)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_rmtm_title_root}/${u}")
 endforeach()
 # Preserve the byte-exact previously tested private Raw includes.
 set_property(SOURCE "${_rmtm_title_root}/src/ck3_121003_rmtm_title26785313_raw_v1.cpp" APPEND PROPERTY INCLUDE_DIRECTORIES "${_rmtm_title_root}/include/xar_bridge")
 if(XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1)
  if(NOT XAR_CK3_ENABLE_121003_26785313_CORE_ROUTE_V1)
   message(FATAL_ERROR "Title query requires exact current Core owner, never old Title providers")
  endif()
  foreach(u IN LISTS _rmtm_title_units ITEMS src/ck3_121003_readonly26785313_v1.cpp src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp src/ck3_1210_adapter.cpp)
   foreach(f IN ITEMS RMTM_TITLE_V1 RMTM_TITLE_QUERY_V1)
    set_property(SOURCE "${_rmtm_title_root}/${u}" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_${f}=1>")
   endforeach()
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1)
 foreach(f IN ITEMS RMTM_TITLE_V1 RMTM_TITLE_QUERY_V1)
  set_property(SOURCE "${_rmtm_title_root}/src/bridge.cpp" "${_rmtm_title_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_${f}=1>")
 endforeach()
endif()
if(BUILD_TESTING AND WIN32)
 foreach(profile IN ITEMS on off health_only missing_raw)
  set(t xar_ck3_rmtm_title_query_step_${profile}_test)
  add_executable(${t} EXCLUDE_FROM_ALL "${_rmtm_title_root}/src/ck3_121003_rmtm_title_query26785313_dispatch_v1.cpp" "${_rmtm_title_root}/src/ck3_121003_rmtm_title_query26785313_step_enabled_v1_test.cpp")
  target_include_directories(${t} PRIVATE "${_rmtm_title_root}/include")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(profile STREQUAL "on")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1=1 XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_V1=1)
  elseif(profile STREQUAL "missing_raw")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1=1 XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_V1=0)
  elseif(profile STREQUAL "health_only")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_SUPERMAN_HEALTH_V1=1)
  endif()
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc /utf-8 /Gy)
   target_link_options(${t} PRIVATE /OPT:REF)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
 add_executable(xar_ck3_rmtm_title_query_wire_test EXCLUDE_FROM_ALL "${_rmtm_title_root}/src/ck3_121003_rmtm_title_query26785313_wire_v1.cpp" "${_rmtm_title_root}/src/ck3_121003_rmtm_title_query26785313_wire_v1_test.cpp")
 foreach(profile IN ITEMS on off)
  add_executable(xar_ck3_rmtm_title_query_owner_${profile}_test EXCLUDE_FROM_ALL "${_rmtm_title_root}/src/ck3_121003_rmtm_title_query26785313_session_v1_test.cpp")
 endforeach()
 foreach(t IN ITEMS xar_ck3_rmtm_title_query_wire_test xar_ck3_rmtm_title_query_owner_on_test xar_ck3_rmtm_title_query_owner_off_test)
  target_include_directories(${t} PRIVATE "${_rmtm_title_root}/include" "${_rmtm_title_root}/src")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(t STREQUAL "xar_ck3_rmtm_title_query_owner_on_test")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1=1 XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_V1=1)
  endif()
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc /utf-8 /Gy)
   target_link_options(${t} PRIVATE /OPT:REF)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
 foreach(profile IN ITEMS on off)
  set(t xar_ck3_rmtm_title_query_capture_${profile}_test)
  add_executable(${t} EXCLUDE_FROM_ALL "${_rmtm_title_root}/src/ck3_121003_rmtm_title_query26785313_capture_v1_test.cpp")
  target_include_directories(${t} PRIVATE "${_rmtm_title_root}/include" "${_rmtm_title_root}/include/xar_bridge" "${_rmtm_title_root}/src")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_V1=1)
  if(profile STREQUAL "on")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_RMTM_TITLE_QUERY_V1=1)
  endif()
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc /utf-8 /Gy)
   target_link_options(${t} PRIVATE /OPT:REF)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
endif()
