# Only the official CanCreate reason getter; no new mutation or identity actions.
option(XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1 "Enable read-only official current creation blockers" OFF)
get_filename_component(_xar_blockers_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_xar_blockers_new src/ck3_121003_rite_creation_blockers26785313_raw_v1.cpp src/ck3_121003_rite_creation_blockers26785313_wire_v1.cpp src/ck3_121003_rite_creation_blockers26785313_owner_v1.cpp src/ck3_121003_rite_creation_blockers26785313_dispatch_v1.cpp)
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(_xar_unit IN LISTS _xar_blockers_new)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_xar_blockers_root}/${_xar_unit}")
 endforeach()
 if(XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1)
  if(NOT XAR_CK3_ENABLE_121003_26785313_RITE_CREATE_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_CORE_ROUTE_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_RITE_DRAFT_V2 OR NOT XAR_CK3_ENABLE_121003_26785313_GUI_CONTROLS_V2 OR NOT XAR_CK3_ENABLE_121003_26785313_RITE_DOCTRINE_V1)
   message(FATAL_ERROR "Rite blockers requires exact current owner; no fallback or generic script permission")
  endif()
  foreach(_xar_unit IN LISTS _xar_blockers_new ITEMS src/ck3_121003_readonly26785313_v1.cpp src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp )
   set_property(SOURCE "${_xar_blockers_root}/${_xar_unit}" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1=1>")
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1)
 set_property(SOURCE "${_xar_blockers_root}/src/bridge.cpp" "${_xar_blockers_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1=1>")
endif()



if(BUILD_TESTING AND WIN32)
 add_executable(xar_ck3_current_rite_creation_blockers_wire_test EXCLUDE_FROM_ALL "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_wire_v1.cpp" "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_wire_v1_test.cpp")
 add_executable(xar_ck3_current_rite_creation_blockers_session_test EXCLUDE_FROM_ALL "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_session_v1_test.cpp")
 add_executable(xar_ck3_current_rite_creation_blockers_off_test EXCLUDE_FROM_ALL "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_owner_default_off_v1_test.cpp")
 add_executable(xar_ck3_current_rite_creation_blockers_native_test EXCLUDE_FROM_ALL "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_native_call_v1_test.cpp")
 foreach(kind IN ITEMS wire session off native)
  set(t xar_ck3_current_rite_creation_blockers_${kind}_test)
  target_include_directories(${t} PRIVATE "${_xar_blockers_root}/include" "${_xar_blockers_root}/src")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
 foreach(kind IN ITEMS session native)
  target_compile_definitions(xar_ck3_current_rite_creation_blockers_${kind}_test PRIVATE XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1=1)
 endforeach()
 target_compile_definitions(xar_ck3_current_rite_creation_blockers_off_test PRIVATE XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1=0)
 foreach(state IN ITEMS on off)
  set(t xar_ck3_current_rite_creation_blockers_step_${state}_test)
  add_executable(${t} EXCLUDE_FROM_ALL "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_dispatch_v1.cpp" "${_xar_blockers_root}/src/ck3_121003_rite_creation_blockers26785313_step_enabled_v1_test.cpp")
  target_include_directories(${t} PRIVATE "${_xar_blockers_root}/include")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(state STREQUAL "on")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1=1)
  else()
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_RITE_CREATION_BLOCKERS_V1=0)
  endif()
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
endif()

