function(xar_event_gui_queued_core_bind12002 source_file output_file)
  if(NOT EXISTS "${source_file}")
    message(FATAL_ERROR "Source file not found: ${source_file}")
  endif()
  file(READ "${source_file}" content)
  set(start_anchor "CoreBindings BindCoreImage(std::uintptr_t image_base,")
  set(end_anchor "void *ResolveCoreCharacter(const CoreBindings &bindings,")
  string(FIND "${content}" "${start_anchor}" start_pos)
  if(start_pos EQUAL -1)
    message(FATAL_ERROR "Start anchor not found")
  endif()
  string(FIND "${content}" "${end_anchor}" end_pos)
  if(end_pos EQUAL -1)
    message(FATAL_ERROR "End anchor not found")
  endif()
  if(end_pos LESS start_pos)
    message(FATAL_ERROR "End anchor precedes start anchor")
  endif()
  math(EXPR start_after "${start_pos} + 1")
  string(SUBSTRING "${content}" ${start_after} -1 start_tail)
  string(FIND "${start_tail}" "${start_anchor}" dup_start_pos)
  if(NOT dup_start_pos EQUAL -1)
    message(FATAL_ERROR "Duplicate start anchor")
  endif()
  math(EXPR end_after "${end_pos} + 1")
  string(SUBSTRING "${content}" ${end_after} -1 end_tail)
  string(FIND "${end_tail}" "${end_anchor}" dup_end_pos)
  if(NOT dup_end_pos EQUAL -1)
    message(FATAL_ERROR "Duplicate end anchor")
  endif()
  string(LENGTH "${start_anchor}" start_len)
  math(EXPR body_start "${start_pos}")
  math(EXPR body_len "${end_pos} - ${body_start}")
  string(SUBSTRING "${content}" ${body_start} ${body_len} function_body)
  set(wrapper "#include \"xar_bridge/ck3_12002.hpp\"\n\nnamespace xar::ck3_12002 {\n${function_body}\n} // namespace xar::ck3_12002\n")
  get_filename_component(output_dir "${output_file}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")
  file(CONFIGURE OUTPUT "${output_file}" CONTENT "${wrapper}" @ONLY NEWLINE_STYLE LF)
  if(DEFINED CMAKE_PROJECT_NAME)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_file}")
  endif()
endfunction()
