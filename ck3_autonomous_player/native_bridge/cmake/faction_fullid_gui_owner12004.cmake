# Only the two original GUI-owner functions needed by the fullid fixture.
function(xar_faction_fullid_gui_owner12004 source_file output_file)
  file(READ "${source_file}" content)
  set(bound_start "bool Actual4UiBoundV1(const ZhongguoScoreboardNativeEnvironmentV1 &env) noexcept {")
  set(bound_end "constexpr std::uintptr_t UiExactImageSizeV1(GuiAbiRevisionV1 revision) noexcept {")
  set(owner_start "bool ReadIngameUiGuiOwnerBindingV1(const ZhongguoScoreboardNativeEnvironmentV1 &env,")
  set(owner_end "namespace {\nbool AppointmentRead(void *,std::uintptr_t p,void *out,std::size_t n) noexcept {")
  foreach(part IN ITEMS bound owner)
    set(start_anchor "${${part}_start}")
    set(end_anchor "${${part}_end}")
    string(FIND "${content}" "${start_anchor}" start_pos)
    string(FIND "${content}" "${end_anchor}" end_pos)
    if(start_pos EQUAL -1 OR end_pos EQUAL -1 OR end_pos LESS start_pos)
      message(FATAL_ERROR "Missing or reversed fullid GUI-owner ${part} anchors")
    endif()
    math(EXPR start_after "${start_pos} + 1")
    string(SUBSTRING "${content}" ${start_after} -1 start_tail)
    string(FIND "${start_tail}" "${start_anchor}" duplicate_start)
    math(EXPR end_after "${end_pos} + 1")
    string(SUBSTRING "${content}" ${end_after} -1 end_tail)
    string(FIND "${end_tail}" "${end_anchor}" duplicate_end)
    if(NOT duplicate_start EQUAL -1 OR NOT duplicate_end EQUAL -1)
      message(FATAL_ERROR "Duplicate fullid GUI-owner ${part} anchor")
    endif()
    math(EXPR body_length "${end_pos} - ${start_pos}")
    string(SUBSTRING "${content}" ${start_pos} ${body_length} ${part}_body)
  endforeach()
  set(wrapper "#include \"xar_bridge/ingame_ui_navigation_v1.hpp\"\n#include \"xar_bridge/ck3_12004_ingame_ui.hpp\"\n\nnamespace xar::ck3_11906 {\nnamespace {\n${bound_body}} // namespace\n\n${owner_body}} // namespace xar::ck3_11906\n")
  get_filename_component(output_dir "${output_file}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")
  file(CONFIGURE OUTPUT "${output_file}" CONTENT "${wrapper}" @ONLY NEWLINE_STYLE LF)
  if(DEFINED CMAKE_PROJECT_NAME)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_file}")
  endif()
endfunction()
