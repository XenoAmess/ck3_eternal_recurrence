option(XAR_CK3_ENABLE_26757580_OPENING_READONLY56 "BB3 exact current government scope and present LIFE readonly profile" OFF)
option(XAR_CK3_ENABLE_26785313_OPENING_READONLY56 "Full111 exact current government scope and present LIFE readonly profile" OFF)
if(XAR_CK3_ENABLE_26757580_OPENING_READONLY56 AND NOT XAR_CK3_ENABLE_1210_HOTFIX_26757580_BASIC_V1)
  message(FATAL_ERROR "Opening56 requires the BB3 basic Full owner profile")
endif()
if(XAR_CK3_ENABLE_26785313_OPENING_READONLY56 AND NOT XAR_CK3_ENABLE_121003_FULL111)
  message(FATAL_ERROR "Opening56 for 26785313 requires the exact Full111 owner profile")
endif()
if(XAR_CK3_ENABLE_26757580_OPENING_READONLY56 OR XAR_CK3_ENABLE_26785313_OPENING_READONLY56)
  target_sources(xar_ck3_12002_runtime PRIVATE src/ck3_1210_opening_readonly56.cpp src/ck3_1210_opening_frame56.cpp src/ck3_1210_opening_serialize56.cpp)
  foreach(opening_build IN ITEMS 26757580 26785313)
    if(XAR_CK3_ENABLE_${opening_build}_OPENING_READONLY56)
      set_property(SOURCE src/ck3_1210_adapter.cpp src/ck3_1210_personal_gold_frame_v1.cpp
        src/ck3_1210_opening_readonly56.cpp APPEND PROPERTY COMPILE_DEFINITIONS
        "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_${opening_build}_OPENING_READONLY56=1>")
      set_property(SOURCE src/bridge.cpp APPEND PROPERTY COMPILE_DEFINITIONS
        "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_${opening_build}_OPENING_READONLY56=1>")
    endif()
  endforeach()
endif()
