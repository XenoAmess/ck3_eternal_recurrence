# Fixed stock bookmark.1070.c only; old LYD semantic roles and all public contracts remain unchanged.
option(XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1 "Enable exact owned stock bookmark1070 fixed c query/once" OFF)
get_filename_component(_xar_bookmark_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_xar_bookmark_units src/ck3_121003_stock_bookmark107026785313_raw_v1.cpp src/ck3_121003_stock_bookmark107026785313_wire_v1.cpp src/ck3_121003_stock_bookmark107026785313_owner_v1.cpp src/ck3_121003_stock_bookmark107026785313_dispatch_v1.cpp)
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(u IN LISTS _xar_bookmark_units)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_xar_bookmark_root}/${u}")
 endforeach()
 if(XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1)
  if(NOT XAR_CK3_ENABLE_121003_26785313_LYD_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_LETTER_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_CORE_ROUTE_V1)
   message(FATAL_ERROR "Fixed stock bookmark requires exact ordinary-event owner/primitives, no arbitrary event permission")
  endif()
  foreach(u IN LISTS _xar_bookmark_units ITEMS src/ck3_121003_readonly26785313_v1.cpp src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp)
   set_property(SOURCE "${_xar_bookmark_root}/${u}" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1=1>")
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1)
 set_property(SOURCE "${_xar_bookmark_root}/src/bridge.cpp" "${_xar_bookmark_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1=1>")
endif()

# Actual standalone qualifications; no synthetic substitute for StepEnabled.
if(BUILD_TESTING AND WIN32)
 add_executable(xar_ck3_stock_bookmark1070_wire_test EXCLUDE_FROM_ALL "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_wire_v1.cpp" "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_wire_v1_test.cpp")
 add_executable(xar_ck3_stock_bookmark1070_session_test EXCLUDE_FROM_ALL "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_session_v1_test.cpp")
 add_executable(xar_ck3_stock_bookmark1070_off_test EXCLUDE_FROM_ALL "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_owner_default_off_v1_test.cpp")
 add_executable(xar_ck3_stock_bookmark1070_native_test EXCLUDE_FROM_ALL "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_native_call_v1_test.cpp" "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_wire_v1.cpp")
 foreach(kind IN ITEMS wire session off native)
  set(t xar_ck3_stock_bookmark1070_${kind}_test)
  target_include_directories(${t} PRIVATE "${_xar_bookmark_root}/include" "${_xar_bookmark_root}/src")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
 foreach(kind IN ITEMS session native)
  target_compile_definitions(xar_ck3_stock_bookmark1070_${kind}_test PRIVATE XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1=1)
 endforeach()
 target_compile_definitions(xar_ck3_stock_bookmark1070_off_test PRIVATE XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1=0)
 foreach(state IN ITEMS on off lyd_only)
  set(t xar_ck3_stock_bookmark1070_step_${state}_test)
  add_executable(${t} EXCLUDE_FROM_ALL "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_dispatch_v1.cpp" "${_xar_bookmark_root}/src/ck3_121003_stock_bookmark107026785313_step_enabled_v1_test.cpp")
  target_include_directories(${t} PRIVATE "${_xar_bookmark_root}/include")
  target_compile_features(${t} PRIVATE cxx_std_20)
  target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(state STREQUAL "on")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1=1 XAR_STOCK_BOOKMARK_STEP_TEST_EXPECT_ENABLED=1)
  elseif(state STREQUAL "off")
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_STOCK_BOOKMARK1070_V1=0)
  else()
   target_compile_definitions(${t} PRIVATE XAR_CK3_ENABLE_121003_26785313_LYD_V1=1)
  endif()
  if(MSVC)
   target_compile_options(${t} PRIVATE /W4 /WX /permissive- /EHsc)
  endif()
  add_test(NAME ${t} COMMAND ${t})
 endforeach()
endif()
