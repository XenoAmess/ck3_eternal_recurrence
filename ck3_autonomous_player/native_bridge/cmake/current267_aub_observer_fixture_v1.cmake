# Fixed fixture only; does not expose arbitrary console or command text.
option(XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1 "Enable exact current267 fixed AUB observer fixture" OFF)
get_filename_component(_xar_aubfix_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_xar_aubfix_new src/ck3_121003_aub_private_console26785313_v1.cpp
 src/ck3_121003_aub_observer_fixture26785313_v1.cpp src/ck3_121003_aub_observer_fixture26785313_wire_v1.cpp
 src/ck3_121003_aub_observer_fixture26785313_dispatch_v1.cpp)
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(_xar_unit IN LISTS _xar_aubfix_new)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_xar_aubfix_root}/${_xar_unit}")
 endforeach()
 if(XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1)
  if(NOT XAR_CK3_ENABLE_121003_26785313_CORE_ROUTE_V1)
   message(FATAL_ERROR "The fixed AUB fixture requires exact current paused Core owner")
  endif()
  foreach(_xar_unit IN LISTS _xar_aubfix_new ITEMS src/ck3_121003_readonly26785313_v1.cpp
    src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp)
   set_property(SOURCE "${_xar_aubfix_root}/${_xar_unit}" APPEND PROPERTY COMPILE_DEFINITIONS
    "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1=1>")
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1)
 set_property(SOURCE "${_xar_aubfix_root}/src/bridge.cpp" "${_xar_aubfix_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS
  "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1=1>")
endif()

if(BUILD_TESTING AND WIN32)
 foreach(_xar_kind IN ITEMS wire resource file)
  set(_xar_test "xar_ck3_current_aub_observer_${_xar_kind}_test")
  if(_xar_kind STREQUAL "wire")
   set(_xar_src src/ck3_121003_aub_observer_fixture26785313_wire_v1_test.cpp)
  else()
   set(_xar_src "src/ck3_121003_aub_observer_fixture26785313_${_xar_kind}_test.cpp")
  endif()
  add_executable(${_xar_test} EXCLUDE_FROM_ALL "${_xar_aubfix_root}/${_xar_src}")
  target_include_directories(${_xar_test} PRIVATE "${_xar_aubfix_root}/include" "${_xar_aubfix_root}/src")
  target_compile_features(${_xar_test} PRIVATE cxx_std_20)
  target_compile_definitions(${_xar_test} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  if(MSVC)
   target_compile_options(${_xar_test} PRIVATE /W4 /WX /permissive- /EHsc)
  endif()
  if(_xar_kind STREQUAL "file")
   target_compile_definitions(${_xar_test} PRIVATE XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1=1)
   target_link_libraries(${_xar_test} PRIVATE shell32)
   set(_xar_fixture "${CMAKE_CURRENT_BINARY_DIR}/aub-observer-file-guard-fixture")
   file(MAKE_DIRECTORY "${_xar_fixture}/run")
   file(GENERATE OUTPUT "${_xar_fixture}/run/xar_mcp_inbox.txt"
    CONTENT "random_player = { trigger_event = { id = aubf.1 } }\n" NEWLINE_STYLE UNIX)
   add_test(NAME ${_xar_test} COMMAND ${_xar_test} --userdir "${_xar_fixture}")
  else()
   target_compile_definitions(${_xar_test} PRIVATE XAR_CK3_ENABLE_121003_26785313_AUB_PRIVATE_FIXTURE_V1=0)
   add_test(NAME ${_xar_test} COMMAND ${_xar_test})
  endif()
 endforeach()
endif()
