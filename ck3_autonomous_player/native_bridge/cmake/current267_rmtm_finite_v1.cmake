# Original finite RMTM closure. No arbitrary selectors, law writer or Send.
option(XAR_CK3_ENABLE_121003_26785313_RMTM_V1 "Enable the fixed RMTM finite backend" OFF)
get_filename_component(_rmtm_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_rmtm_units src/ck3_121003_rmtm_owner26785313_v1.cpp)
foreach(family IN ITEMS actor_transition event decision observation)
 foreach(part IN ITEMS raw wire owner dispatch)
  list(APPEND _rmtm_units "src/ck3_121003_rmtm_${family}26785313_${part}_v1.cpp")
 endforeach()
endforeach()
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(u IN LISTS _rmtm_units)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_rmtm_root}/${u}")
 endforeach()
 if(XAR_CK3_ENABLE_121003_26785313_RMTM_V1)
  foreach(dependency IN ITEMS CORE_ROUTE_V1 RMTM_TITLE_QUERY_V1 LYD_V1 FULLSCREEN_EVENT_V1 DATE_ADVANCE_V1)
   if(NOT XAR_CK3_ENABLE_121003_26785313_${dependency})
    message(FATAL_ERROR "RMTM finite closure requires actual current ${dependency}; old build providers cannot substitute")
   endif()
  endforeach()
  set(_rmtm_affected ${_rmtm_units} src/ck3_121003_readonly26785313_v1.cpp src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_date_advance26785313_v1.cpp src/ck3_1210_date_sentinel_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp)
  foreach(u IN LISTS _rmtm_affected)
   foreach(f IN ITEMS RMTM_V1 RMTM_TRANSITION_V1 RMTM_EVENT_V1 RMTM_DECISION_V1 RMTM_OBSERVATION_V1 RMTM_TITLE_V1 LYD_V1 FULLSCREEN_EVENT_V1)
    set_property(SOURCE "${_rmtm_root}/${u}" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_${f}=1>")
   endforeach()
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_RMTM_V1)
 foreach(f IN ITEMS RMTM_V1 RMTM_TRANSITION_V1 RMTM_EVENT_V1 RMTM_DECISION_V1 RMTM_OBSERVATION_V1 RMTM_TITLE_V1 LYD_V1 FULLSCREEN_EVENT_V1)
  set_property(SOURCE "${_rmtm_root}/src/bridge.cpp" "${_rmtm_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_${f}=1>")
 endforeach()
endif()

# Complete actual linked OFF methods; no extracted body or owner ABI is used.
if(BUILD_TESTING AND WIN32)
 add_executable(xar_ck3_rmtm_finite_step_off_test EXCLUDE_FROM_ALL
  "${_rmtm_root}/src/rmtm_whole_step_profile_v1_test.cpp")
 foreach(family IN ITEMS actor_transition event decision observation)
  target_sources(xar_ck3_rmtm_finite_step_off_test PRIVATE "${_rmtm_root}/src/ck3_121003_rmtm_${family}26785313_dispatch_v1.cpp")
 endforeach()
 target_include_directories(xar_ck3_rmtm_finite_step_off_test PRIVATE "${_rmtm_root}/include")
 target_compile_features(xar_ck3_rmtm_finite_step_off_test PRIVATE cxx_std_20)
 target_compile_definitions(xar_ck3_rmtm_finite_step_off_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN XAR_RMTM_PROFILE_EXPECT_ON=0)
 if(MSVC)
  target_compile_options(xar_ck3_rmtm_finite_step_off_test PRIVATE /W4 /WX /permissive- /EHsc /utf-8 /Gy)
  target_link_options(xar_ck3_rmtm_finite_step_off_test PRIVATE /OPT:REF)
 endif()
 add_test(NAME xar_ck3_rmtm_finite_step_off_test COMMAND xar_ck3_rmtm_finite_step_off_test)
endif()
