# Exact current frontend witness/quit; separate from all world Core contracts.
option(XAR_CK3_ENABLE_121003_26785313_FRONTEND_MENU_V1 "Enable current267 frontend witness and once application quit" OFF)
get_filename_component(_xar_menu267_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_xar_menu267_new src/ck3_121003_frontend_menu26785313_v1.cpp
 src/ck3_121003_frontend_menu26785313_wire_v1.cpp src/ck3_121003_frontend_menu26785313_dispatch_v1.cpp)
if(WIN32 AND TARGET xar_ck3_12002_runtime)
 foreach(_xar_unit IN LISTS _xar_menu267_new)
  target_sources(xar_ck3_12002_runtime PRIVATE "${_xar_menu267_root}/${_xar_unit}")
 endforeach()
 if(XAR_CK3_ENABLE_121003_26785313_FRONTEND_MENU_V1)
  if(NOT XAR_CK3_ENABLE_121003_26785313_CORE_ROUTE_V1 OR NOT XAR_CK3_ENABLE_121003_26785313_APPLICATION_EXIT_V1 OR
     NOT XAR_CK3_ENABLE_121003_26785313_GUI_WINDOW_V1)
   message(FATAL_ERROR "Current frontend requires exact current owner/image/application/window bindings")
  endif()
  foreach(_xar_unit IN LISTS _xar_menu267_new ITEMS src/ck3_121003_core_route26785313_v1.cpp src/ck3_121003_personal_gold26785313_v2.cpp)
   set_property(SOURCE "${_xar_menu267_root}/${_xar_unit}" APPEND PROPERTY COMPILE_DEFINITIONS
    "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_12002_runtime>:XAR_CK3_ENABLE_121003_26785313_FRONTEND_MENU_V1=1>")
  endforeach()
 endif()
endif()
if(WIN32 AND TARGET xar_ck3_bridge AND XAR_CK3_ENABLE_121003_26785313_FRONTEND_MENU_V1)
 set_property(SOURCE "${_xar_menu267_root}/src/bridge.cpp" "${_xar_menu267_root}/src/game_adapter.cpp" APPEND PROPERTY COMPILE_DEFINITIONS
  "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,xar_ck3_bridge>:XAR_CK3_ENABLE_121003_26785313_FRONTEND_MENU_V1=1>")
endif()
if(BUILD_TESTING AND WIN32)
 set(_xar_test xar_ck3_121003_26785313_frontend_menu_wire_test)
 add_executable(${_xar_test} EXCLUDE_FROM_ALL "${_xar_menu267_root}/src/ck3_121003_frontend_menu26785313_wire_v1_test.cpp")
 target_include_directories(${_xar_test} PRIVATE "${_xar_menu267_root}/include" "${_xar_menu267_root}/src")
 target_compile_features(${_xar_test} PRIVATE cxx_std_20)
 target_compile_definitions(${_xar_test} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
 if(MSVC)
  target_compile_options(${_xar_test} PRIVATE /W4 /WX /permissive- /EHsc)
 endif()
 add_test(NAME ${_xar_test} COMMAND ${_xar_test})
endif()
