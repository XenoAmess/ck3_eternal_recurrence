      "relative_path": "game/common/schemes/scheme_types/_schemes.info",
      "size": 11078,
      "sha256": "3F93B35DC6A63B5A2635C5D11CF091AA52F34CA60CC092FB1D3D6AA8E4404F90",
      "line_anchors": [
        {
          "line": 4,
          "text": "Success Chance is in the range of 0-100"
        },
        {
          "line": 5,
          "text": "Secrecy is in the range of 0-100"
        },
        {
          "line": 7,
          "text": "Scheme Progress goes from 0-10"
        },
        {
          "line": 9,
          "text": "(Note that accessing Success Chance and Secrecy in script is done as \"scheme_success_chance\" and \"scheme_secrecy\")"
        },
        {
          "line": 20,
          "text": "\ttarget_type = character/title/culture/faith/nothing # The type of scope the scheme will target."
        },
        {
          "line": 26,
          "text": "\tallow = {} # When this scheme can be started"
        },
        {
          "line": 28,
          "text": "\tvalid = {} # What conditions have to be fulfilled for the scheme to keep going; if invalid it will end. Checked daily."
        },
        {
          "line": 30,
          "text": "\tagent_join_threshold = 5 # How much does the AI have to want to join in order to actually join"
        },
        {
          "line": 35,
          "text": "\tis_basic = no # If a scheme is defined as basic, it won't have success chance growth every phase, won't use agents, and won't use opportunities."
        },
        {
          "line": 39,
          "text": "\t# List of groups of characters to be considered for agent slots. Available lists are in the \"ai_targets\" section of character_interaction.info"
        },
        {
          "line": 44,
          "text": "\t# Number in the 0-100 range indicating how likely this is to go well."
        },
        {
          "line": 57,
          "text": "\tagent_success_chance = {} # each agent adds this to the success chance of the scheme uses the same scopes as the join chance (agent as root)"
        },
        {
          "line": 62,
          "text": "\tbase_success_chance = {}"
        },
        {
          "line": 64,
          "text": "\tbase_maximum_success_chance = 100"
        },
        {
          "line": 68,
          "text": "\tbase_progress_goal = 20"
        },
        {
          "line": 69,
          "text": "\tmaximum_breaches = 7 # The number of secrecy breaches that can occur before the scheme forcibly ends."
        },
        {
          "line": 76,
          "text": "\tcooldown = { days = 0 } # After the scheme ends, how many days minimum before the same type of scheme can be used by the owner on the target"
        },
        {
          "line": 78,
          "text": "\tis_secret = yes #If the Scheme is secret, the secrecy mechanics are used (otherwise always 100% secrecy)"
        },
        {
          "line": 82,
          "text": "\tbase_secrecy = -20 #The base chance used for the monthly scheme expose check secrecy is based on: base_secrecy + success_chance + scheme_modifiers and clamped to 0-100"
        },
        {
          "line": 84,
          "text": "\ton_phase_completed = {} # What should happen when the scheme phase completes (ie when progress has reached it's maximum)"
        },
        {
          "line": 92,
          "text": "\ton_monthly = { # What should happen once a month while the scheme exists"
        },
        {
          "line": 100,
          "text": "\ton_semiyearly = { # What should happen twice a year while the scheme exists"
        },
        {
          "line": 117,
          "text": "\t# Progress chance each month is scheme speed minus scheme resistance. E.G., 50 speed, 25 resistance, means 25% chance"
        },
        {
          "line": 184,
          "text": "== Related loc/UI functions =="
        },
        {
          "line": 189,
          "text": "[SCHEME.GetSecrecy] - Gets as a number how secret the scheme is"
        },
        {
          "line": 190,
          "text": "[SCHEME.GetOwner] - Gets who owns the scheme"
        },
        {
          "line": 196,
          "text": "[SCHEME.GetProgress] - Gets the progress of the scheme as a number"
        }
      ]
    },
