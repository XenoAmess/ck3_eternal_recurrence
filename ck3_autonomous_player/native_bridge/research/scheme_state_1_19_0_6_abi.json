    {
      "relative_path": "game/common/scripted_effects/00_scheme_scripted_effects.txt",
      "size": 412683,
      "sha256": "478F4B1B9D94F28E33B83B8453F6BBCFD239830D821196D68120D5727723F6DF",
      "line_anchors": [
        {
          "line": 55,
          "text": "# What percentage chance is there that a scheme will be discovered per month?"
        },
        {
          "line": 57,
          "text": "hostile_scheme_monthly_discovery_chance_effect = {"
        },
        {
          "line": 61,
          "text": "\t\t\thas_variable = secrecy_grace_period"
        },
        {
          "line": 69,
          "text": "\t# Otherwise we want to start checking for discovery."
        },
        {
          "line": 71,
          "text": "\t\t# Without a spymaster, you can't discover schemes."
        },
        {
          "line": 116,
          "text": "\t\t\tvalue = monthly_scheme_discovery_chance_value"
        },
        {
          "line": 125,
          "text": "\t\t\trandom = {"
        },
        {
          "line": 129,
          "text": "\t\t\t\t\tlimit = { scheme_breaches >= scheme_breaches_about_to_hit_limit_value }"
        },
        {
          "line": 134,
          "text": "\t\t\t\t\tadd_scheme_breach = 1"
        },
        {
          "line": 242,
          "text": "generic_scheme_process_ending_effect = {"
        },
        {
          "line": 245,
          "text": "\tscheme_owner = { save_scope_as = owner }"
        },
        {
          "line": 247,
          "text": "\tscheme_target_character ?= { save_scope_as = target }"
        },
        {
          "line": 251,
          "text": "\t# Success roll."
        },
        {
          "line": 253,
          "text": "\t\tchance = scheme_success_chance"
        },
        {
          "line": 263,
          "text": "\t\t\tlimit = { is_savable_murder_scheme_trigger = yes }"
        },
        {
          "line": 280,
          "text": "\t# Secrecy roll."
        },
        {
          "line": 283,
          "text": "\t\tlimit = { is_type_secret = yes }"
        },
        {
          "line": 289,
          "text": "\t\t\t\tsubtract = scheme_secrecy"
        },
        {
          "line": 301,
          "text": "\t\t\t\tmin = 5"
        },
        {
          "line": 304,
          "text": "\t\trandom = {"
        },
        {
          "line": 305,
          "text": "\t\t\tchance = scope:discovery_chance"
        },
        {
          "line": 338,
          "text": "\t# Process ending on_actions."
        },
        {
          "line": 340,
          "text": "\tif = {"
        },
        {
          "line": 347,
          "text": "\telse_if = {"
        },
        {
          "line": 353,
          "text": "\t## Scheme successful."
        },
        {
          "line": 355,
          "text": "\t\tlimit = { exists = scope:scheme_successful }"
        },
        {
          "line": 366,
          "text": "\t\ttask_contract ?= { complete_task_contract = success_standard }"
        },
        {
          "line": 367,
          "text": "\t\ttrigger_event = { $SUCCESS_EVENT_TYPE$ = $SUCCESS_EVENT_ID$ }"
        },
        {
          "line": 373,
          "text": "\t## Scheme failed."
        },
        {
          "line": 385,
          "text": "\t\ttask_contract ?= { complete_task_contract = failure_standard }"
        },
        {
          "line": 386,
          "text": "\t\ttrigger_event = { $FAILURE_EVENT_TYPE$ = $FAILURE_EVENT_ID$ }"
        }
      ]
    },
