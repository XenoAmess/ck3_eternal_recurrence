  "stock_sources": [
    {
      "path": "common/religion/rite_types/_rite_types.info",
      "sha256": "60fd476d72be0941d9c6dff4e83834016d6e32d16e855f3b258389061850828f",
      "first_line": 31,
      "last_line": 74,
      "window": "31: \t# Rite founder will be first holder of provided title (unless set elsewhere in script)\n32: \t#\n33: \tfounder = title_key\n34: \n35: \t### brief: faith ( database key )\n36: \t# What is the parent faith of this Rite? If a faith has no scripted Rites a dynamic one with the same name will be created instead\n37: \t# if no parent faith is defined, the Rite will not be generated from history and will only be available via the create_rite_from_type effect.\n38: \t# you can still specify parent faith overrides in specific bookmarks (see below), starting the game in those dates will generate the rite from history\n39: \t#\n40: \tfaith = key\n41: \n42: \t# brief: cultures (database keys)\n43: \t# keys of cultures associated with this rite. refers to the cultures found in culture/cultures\n44: \t#\n45: \tcultures = { culture_1 culture_2 ... }\n46: \n47: \t### brief: convert (bool)\n48: \t# if set to no, characters cannot convert to this rite. default value is yes\n49: \t#\n50: \tconvert = yes\n51: \n52: \t### brief: create (bool)\n53: \t# if set to no, this rite will not be created until specified in history. default value is yes\n54: \t# warning! not created rites will error when accessed with rite:key. Always check if the object is valid in script\n55: \t#\n56: \tcreate = yes\n57: \n58: \t### brief: tenets ( database keys )\n59: \t# List of tenets associated with this Rite. If this is a faith's scripted main Rite, these are the faith's\n60: \t# effective core tenets; do not duplicate them in the faith type.\n61: \t#\n62: \ttenets = {\n63: \t\tkey\n64: \t\tkey\n65: \t}\n66: \n67: \t### brief: doctrines ( database keys )\n68: \t# List of doctrines associated with this Rite. Rite doctrines override parent-religion and faith doctrines from the\n69: \t# same doctrine group. Faith doctrines from otherwise unfilled groups are added to the instantiated main Rite.\n70: \t# Put doctrine choices intrinsic to the whole faith on the faith type and Rite-specific choices here.\n71: \t#\n72: \tdoctrines = {\n73: \t\tkey\n74: \t\tkey"
    },
    {
      "path": "common/defines/00_defines.txt",
      "sha256": "8e430d77eb6e8767030f34b1c53d5dae84277fb354bd73cc42f93dc500be8982",
      "first_line": 824,
      "last_line": 836,
      "window": "824: \t# how many relics can be extracted from a saint? must be positive\n825: \tMAX_RELICS_FROM_SAINT = 4\n826: }\n827: \n828: NRite = {\n829: \tRITE_CREATION_FERVOR_DISCOUNT_PER_MISSING_FERVOR = 1 # How much cheaper does creating a faith get per fervor below 100%? 1 means 1% per point\n830: \tRITE_CREATION_FERVOR_DISCOUNT_MAX = 50 # What percentage does the discount cap out at? With these numbers, 0-50 fervor means a 50% discount. Above 50 means between 0% and 50% discount\n831: \tRITE_CREATION_DIVERGENCE_FAITH_THRESHOLD = 100 # when creating a Rite, divergence values at or over this threshold will result in a Faith being created instead of a Rite\n832: \tRITE_CREATION_PIETY_COST = 1.0\t# Fixed cost how much piety it costs to branch off a Faith with new Rite\n833: \tRITE_DIVERGENCE_HERETICAL_THRESHOLD = 65 # Divergence above which a Rite is considered heretical\n834: \tRITE_DIVERGENCE_HOSTILITY_THRESHOLD = 1 # Divergence below that will lower faith hostility by 1 level\n835: \tRITE_DIVERGENCE_GRACE_THRESHOLD = 0 # rites below this divergence will not add to the yearly fervor decrease\n836: "
    },
    {
      "path": "common/on_action/religion_on_actions.txt",
      "sha256": "b446a8935566ebe17cfa3b76888b197c56fc5041629414167bd07a8f9f4a0475",
      "first_line": 3,
      "last_line": 18,
      "window": "3: # Code on-action: a new faith is created (character create/convert, or a rite detaching into its own faith)\n4: # Root is the new faith; its head/leader is root.main_rite.head_of_rite (use it for faith-setup effects)\n5: # scope:founder is the acting character that triggered the creation (creator/converter, heresy declarer, or on a divergence the head of the diverging rite)\n6: # scope:founder can be absent - the game creates faiths with no acting character, so it is entered with ?=\n7: # scope:old_faith is the faith they used to have\n8: # scope:old_rite is the rite they used to have\n9: # scope:diverged (true/false) optional scope, true if the faith was created because of a Rite diverging too much. Notice create a 100+ divergence heresy at the start does not count.\n10: on_faith_created = {\n11: \teffect = {\n12: \t\t# Faiths created by a rite diverging too far start at 0 fervor\n13: \t\tif = {\n14: \t\t\tlimit = {\n15: \t\t\t\tscope:diverged ?= yes\n16: \t\t\t}\n17: \t\t\tdiverged_faith_starting_fervor_effect = yes\n18: \t\t}"
    },
    {
      "path": "gui/window_rite_creation.gui",
      "sha256": "9476299fdbf0975e41923eac9b192d3fe0b2cd74a4da0d928d0da7974b7ea9f8",
      "first_line": 488,
      "last_line": 524,
      "window": "488: \t\t\t\t\tvbox = {\n489: \t\t\t\t\t\tname = \"divergence\"\n490: \n491: \t\t\t\t\t\ttext_single = {\n492: \t\t\t\t\t\t\ttext = \"RITE_CREATION_DIVERGENCE\"\n493: \n494: \t\t\t\t\t\t\ttooltipwidget = {\n495: \t\t\t\t\t\t\t\twidget_rite_divergence_tooltip = {\n496: \t\t\t\t\t\t\t\t\tdatacontext = \"[RiteCreationWindow.GetRite.GetFaith]\"\n497: \t\t\t\t\t\t\t\t\tdatacontext = \"[RiteCreationWindow.GetRiteDivergenceTooltip]\"\n498: \t\t\t\t\t\t\t\t\tblockoverride \"main_rite_header_visible\"\n499: \t\t\t\t\t\t\t\t\t{\n500: \t\t\t\t\t\t\t\t\t\tvisible = no\n501: \t\t\t\t\t\t\t\t\t}\n502: \t\t\t\t\t\t\t\t}\n503: \t\t\t\t\t\t\t}\n504: \t\t\t\t\t\t}\n505: \n506: \t\t\t\t\t\ttext_single = {\n507: \t\t\t\t\t\t\tdatacontext = \"[GetPlayer.GetFaith]\"\n508: \t\t\t\t\t\t\tdatacontext = \"[GetPlayer.GetRite]\"\n509: \t\t\t\t\t\t\tvisible = \"[And3( Or( Not( Rite.IsMain ), RiteCreationWindow.IsCreating ), Not( RiteCreationWindow.DivergenceResultsInFaithCreation ), LessThan_CFixedPoint( RiteCreationWindow.GetRiteDivergence, Faith.GetHeresyThreshold ) )]\"\n510: \t\t\t\t\t\t\ttext = \"RITE_CREATION_VIEW_HERETICAL_DIVERGENCE\"\n511: \t\t\t\t\t\t}\n512: \t\t\t\t\t\ttext_single = {\n513: \t\t\t\t\t\t\tdatacontext = \"[GetPlayer.GetFaith]\"\n514: \t\t\t\t\t\t\tdatacontext = \"[GetPlayer.GetRite]\"\n515: \t\t\t\t\t\t\tvisible = \"[Nor3( And( Rite.IsMain , RiteCreationWindow.IsEditing ), RiteCreationWindow.DivergenceResultsInFaithCreation, LessThan_CFixedPoint( RiteCreationWindow.GetRiteDivergence, Faith.GetHeresyThreshold ) )]\"\n516: \t\t\t\t\t\t\ttext = \"RITE_CREATION_WARNING_HERETICAL_DIVERGENCE\"\n517: \t\t\t\t\t\t}\n518: \t\t\t\t\t\ttext_multi = {\n519: \t\t\t\t\t\t\tvisible = \"[RiteCreationWindow.DivergenceResultsInFaithCreation]\"\n520: \t\t\t\t\t\t\tautoresize = yes\n521: \t\t\t\t\t\t\tmax_width = 420\n522: \t\t\t\t\t\t\ttext = \"RITE_CREATION_VIEW_CONFIRM_NEW_FAITH\"\n523: \t\t\t\t\t\t\talign = center\n524: \t\t\t\t\t\t}"
    }
