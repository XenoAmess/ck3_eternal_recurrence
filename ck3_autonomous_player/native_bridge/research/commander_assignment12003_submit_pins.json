      "lines": [
        {
          "line": 28,
          "text": "CommandBindings BindCommandImage(std::uintptr_t image_base,"
        },
        {
          "line": 29,
          "text": "                                 std::string_view executable_sha256) noexcept {"
        },
        {
          "line": 30,
          "text": "  CommandBindings bindings{};"
        },
        {
          "line": 31,
          "text": "  if (image_base == 0 || executable_sha256 != kExecutableSha256) {"
        },
        {
          "line": 32,
          "text": "    return bindings;"
        },
        {
          "line": 33,
          "text": "  }"
        },
        {
          "line": 34,
          "text": "  bindings.command_manager ="
        },
        {
          "line": 35,
          "text": "      reinterpret_cast<void *>(image_base + kCommandManagerRva);"
        },
        {
          "line": 36,
          "text": "  bindings.queue_owned_command = reinterpret_cast<QueueOwnedCommand>("
        },
        {
          "line": 37,
          "text": "      image_base + kQueueOwnedCommandRva);"
        },
        {
          "line": 38,
          "text": "  bindings.pause_primary_vtable = image_base + kPausePrimaryVtableRva;"
        },
        {
          "line": 39,
          "text": "  bindings.pause_secondary_vtable = image_base + kPauseSecondaryVtableRva;"
        },
        {
          "line": 40,
          "text": "  bindings.set_speed_primary_vtable = image_base + kSetSpeedPrimaryVtableRva;"
        },
        {
          "line": 41,
          "text": "  bindings.set_speed_secondary_vtable = image_base + kSetSpeedSecondaryVtableRva;"
        },
        {
          "line": 42,
          "text": "  bindings.auto_save_primary_vtable = image_base + kAutoSavePrimaryVtableRva;"
        },
        {
          "line": 43,
          "text": "  bindings.auto_save_secondary_vtable = image_base + kAutoSaveSecondaryVtableRva;"
        },
        {
          "line": 44,
          "text": "  bindings.enabled = true;"
        },
        {
          "line": 45,
          "text": "  return bindings;"
        },
        {
          "line": 48,
          "text": "bool DestroyOwnedCommand(void *&command) noexcept {"
        },
        {
          "line": 49,
          "text": "  if (command == nullptr) {"
        },
        {
          "line": 50,
          "text": "    return true;"
        },
        {
          "line": 51,
          "text": "  }"
        },
        {
          "line": 52,
          "text": "  const auto table = LoadAt<const void *>(command, 0);"
        },
        {
          "line": 53,
          "text": "  if (table == nullptr) {"
        },
        {
          "line": 54,
          "text": "    return false;"
        },
        {
          "line": 55,
          "text": "  }"
        },
        {
          "line": 56,
          "text": "  const auto destroy = LoadAt<DeleteCommand>(table, 0);"
        },
        {
          "line": 57,
          "text": "  if (destroy == nullptr) {"
        },
        {
          "line": 58,
          "text": "    return false;"
        },
        {
          "line": 59,
          "text": "  }"
        },
        {
          "line": 60,
          "text": "  void *const owned = command;"
        },
        {
          "line": 61,
          "text": "  command = nullptr;"
        },
        {
          "line": 62,
          "text": "  destroy(owned, 1);"
        },
        {
          "line": 63,
          "text": "  return true;"
        },
        {
          "line": 64,
          "text": "}"
        },
        {
          "line": 65,
          "text": ""
        },
        {
          "line": 66,
          "text": "CommandSubmitResult SubmitCommandCopy(const CommandBindings &bindings,"
        },
        {
          "line": 67,
          "text": "                                      const void *command,"
        },
        {
          "line": 68,
          "text": "                                      std::uint32_t channel_flags) noexcept {"
        },
        {
          "line": 69,
          "text": "  if (!bindings.enabled || bindings.command_manager == nullptr ||"
        },
        {
          "line": 70,
          "text": "      bindings.queue_owned_command == nullptr || command == nullptr) {"
        },
        {
          "line": 71,
          "text": "    return CommandSubmitResult::unavailable;"
        },
        {
          "line": 72,
          "text": "  }"
        },
        {
          "line": 73,
          "text": "  const auto table = LoadAt<const void *>(command, 0);"
        },
        {
          "line": 74,
          "text": "  if (table == nullptr) {"
        },
        {
          "line": 75,
          "text": "    return CommandSubmitResult::unavailable;"
        },
        {
          "line": 76,
          "text": "  }"
        },
        {
          "line": 77,
          "text": "  const auto clone = LoadAt<CloneCommand>(table, 0x40);"
        },
        {
          "line": 78,
          "text": "  if (clone == nullptr) {"
        },
        {
          "line": 79,
          "text": "    return CommandSubmitResult::unavailable;"
        },
        {
          "line": 80,
          "text": "  }"
        },
        {
          "line": 81,
          "text": "  void *clone_storage = nullptr;"
        },
        {
          "line": 82,
          "text": "  void **const returned_storage = clone(command, &clone_storage);"
        },
        {
          "line": 83,
          "text": "  if (returned_storage == nullptr || *returned_storage == nullptr) {"
        },
        {
          "line": 84,
          "text": "    DestroyOwnedCommand(clone_storage);"
        },
        {
          "line": 85,
          "text": "    return CommandSubmitResult::unavailable;"
        },
        {
          "line": 86,
          "text": "  }"
        },
        {
          "line": 87,
          "text": "  // Match 0x9E16C8..0x9E16E7: move ownership out of the clone's return"
        },
        {
          "line": 88,
          "text": "  // storage before invoking the manager. No bridge allocator participates."
        },
        {
          "line": 89,
          "text": "  void *queued_command = *returned_storage;"
        },
        {
          "line": 90,
          "text": "  *returned_storage = nullptr;"
        },
        {
          "line": 91,
          "text": "  const bool accepted = bindings.queue_owned_command("
        },
        {
          "line": 92,
          "text": "      bindings.command_manager, &queued_command, channel_flags);"
        },
        {
          "line": 93,
          "text": "  DestroyOwnedCommand(queued_command);"
        },
        {
          "line": 94,
          "text": "  DestroyOwnedCommand(clone_storage);"
        },
        {
          "line": 95,
          "text": "  return accepted ? CommandSubmitResult::submitted"
        },
        {
          "line": 96,
          "text": "                  : CommandSubmitResult::rejected;"
        },
        {
          "line": 97,
          "text": "}"
        }
      ]
