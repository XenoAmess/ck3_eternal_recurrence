    {
      "path": "Z:\\g36\\ck3_autonomous_player\\native_bridge\\include\\xar_bridge\\ck3_12002_commands.hpp",
      "sha256": "c2a783d4f49c880e5b9691486fbfa816504460a352e720be01c49f0725350fe1",
      "lines": [
        {
          "line": 14,
          "text": "inline constexpr std::uintptr_t kCommandManagerRva = 0x5CC1240;"
        },
        {
          "line": 15,
          "text": "inline constexpr std::uintptr_t kQueueOwnedCommandRva = 0x37F06F0;"
        },
        {
          "line": 16,
          "text": "inline constexpr std::uintptr_t kAutoSavePrimaryVtableRva = 0x44B5148;"
        },
        {
          "line": 17,
          "text": "inline constexpr std::uintptr_t kAutoSaveSecondaryVtableRva = 0x44B51E0;"
        },
        {
          "line": 18,
          "text": ""
        },
        {
          "line": 19,
          "text": "// Win64's native command clone writes an owning pointer into its return"
        },
        {
          "line": 20,
          "text": "// storage and returns the address of that storage (primary vtable +0x40)."
        },
        {
          "line": 21,
          "text": "using CloneCommand = void **(*)(const void *command, void **return_storage);"
        },
        {
          "line": 22,
          "text": "using DeleteCommand = void *(*)(void *command, std::uint32_t delete_flags);"
        },
        {
          "line": 23,
          "text": "// Native queue consumes *owned_command on both acceptance and rejection."
        },
        {
          "line": 24,
          "text": "// Its explicit AL return is a queue result, not a gameplay-state result."
        },
        {
          "line": 25,
          "text": "using QueueOwnedCommand = bool (*)(void *manager, void **owned_command,"
        },
        {
          "line": 26,
          "text": "                                  std::uint32_t channel_flags);"
        },
        {
          "line": 28,
          "text": "struct CommandBindings {"
        },
        {
          "line": 29,
          "text": "  bool enabled = false;"
        },
        {
          "line": 30,
          "text": "  void *command_manager = nullptr; // Embedded native object, not a pointer slot."
        },
        {
          "line": 31,
          "text": "  QueueOwnedCommand queue_owned_command = nullptr;"
        },
        {
          "line": 32,
          "text": "  std::uintptr_t pause_primary_vtable = 0;"
        },
        {
          "line": 33,
          "text": "  std::uintptr_t pause_secondary_vtable = 0;"
        },
        {
          "line": 34,
          "text": "  std::uintptr_t set_speed_primary_vtable = 0;"
        },
        {
          "line": 35,
          "text": "  std::uintptr_t set_speed_secondary_vtable = 0;"
        },
        {
          "line": 36,
          "text": "  std::uintptr_t auto_save_primary_vtable = 0;"
        },
        {
          "line": 37,
          "text": "  std::uintptr_t auto_save_secondary_vtable = 0;"
        },
        {
          "line": 38,
          "text": "};"
        },
        {
          "line": 39,
          "text": ""
        },
        {
          "line": 40,
          "text": "// Address calculation only: no process lookup, module reads or game mutation."
        },
        {
          "line": 41,
          "text": "CommandBindings BindCommandImage(std::uintptr_t image_base,"
        },
        {
          "line": 42,
          "text": "                                 std::string_view executable_sha256) noexcept;"
        },
        {
          "line": 43,
          "text": ""
        },
        {
          "line": 44,
          "text": "enum class CommandSubmitResult { unavailable, rejected, submitted };"
        },
        {
          "line": 45,
          "text": ""
        },
        {
          "line": 46,
          "text": "// Owning-thread callers provide a native-layout source object that remains"
        },
        {
          "line": 47,
          "text": "// caller-owned. The synchronous native clone, queue and residual deleting"
        },
        {
          "line": 48,
          "text": "// destructor all run through the game's allocator/ownership machinery."
        },
        {
          "line": 49,
          "text": "CommandSubmitResult SubmitCommandCopy(const CommandBindings &bindings,"
        },
        {
          "line": 50,
          "text": "                                      const void *command,"
        },
        {
          "line": 51,
          "text": "                                      std::uint32_t channel_flags = 7) noexcept;"
        },
        {
          "line": 52,
          "text": ""
        },
        {
          "line": 53,
          "text": "// For domain bindings that accept a bool(context, command, flags) callback."
        },
        {
          "line": 54,
          "text": "// context points to a CommandBindings object owned by the selected adapter."
        },
        {
          "line": 55,
          "text": "bool SubmitCommandCopyCompat(void *context, void *command,"
        },
        {
          "line": 56,
          "text": "                             std::uint32_t channel_flags) noexcept;"
        },
        {
          "line": 57,
          "text": ""
        },
        {
          "line": 58,
          "text": "// Same scalar-deleting-destructor path used by CK3's owning smart pointer."
        },
        {
          "line": 59,
          "text": "// Only for game-allocated command clones; never pass caller-owned storage."
        },
        {
          "line": 60,
          "text": "bool DestroyOwnedCommand(void *&command) noexcept;"
        }
      ]
    },
