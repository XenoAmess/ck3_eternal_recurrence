  "guard_caveat": "Consumer IsAllied/+1C0 guards target 0x25044D6, which still enters relation effect call. These gates guard only player-facing branch; not complete alliance creation legality.",
  "predicate_semantics": {
    "0x2C7C590": {
      "directly_observed": "Returns true for invalid first Character sentinel/type, identical first/second pointer, null object returned from 0x28C2E10, object+0x40 bit34 clear with bit33 clear, or true helper0x24F94F0 after second+0x1A1 sex-like byte projection. Returns false when object+0x40 bit33 set, or bit34 set and helper0x24F94F0 false. The object/helper semantic names are not certified here.",
      "details": [
        "first tag+0x1C == 0x43686172 and ID+0x18 != 0xFFFFFFFF test",
        "opaque helper0x28C2E10 receives first Character pointer",
        "when bit33 clear and bit34 set, first+0xB4 resolves object through global0x5D1E2F8 and native full-generation identity+8",
        "helper0x24F94F0 receives resolved object and DL=(second+0x1A1 != 0)"
      ],
      "unsupported_labels": [
        "No claim this standalone routine is complete marriage legality or guaranteed alliance creation",
        "No faith/doctrine/tenet/fervor interpretation"
      ]
    },
    "0x2911F00": {
      "directly_observed": "Native relation-class integer: identical pointers return1; helper0x28B3A50(first,second,r8d=0) true or reciprocal family-ID matches return2; helpers0x28B3840 in either direction, 0x28B3C30 in either direction, or0x28B3E70(first,second) true return3; otherwise0.",
      "family_id_matches": "For valid target Character, compare target+0x18 to dwords first.relationship_ptr(+0x1A8)+0 and +4; repeat reversed. No semantic name assigned to the opaque helpers."
    },
    "0x2C7C650": {
      "directly_observed": "Require first!=second, eligibility0x2C7C590(first,secondary_actor) true and eligibility0x2C7C590(second,secondary_recipient) true. If first==secondary_actor and second==secondary_recipient return true. Otherwise require two relation-class0x2911F00 values strictly >0, then signed sum <= runtime dword at0x5C69E0C.",
      "runtime_limit": "RIP-relative CMP at0x2C7C6C0 addresses0x5C69E0C; current-process configured value not read and no numeric default claimed."
    }
