  "purpose": "deterministic source vectors for the implemented production read-only projection; interaction keys and IDs are deliberately synthetic and assert no gameplay-specific semantics or live evidence",
  "override_application": "recursively merge each vector's overrides into defaults; arrays and scalar leaves replace the default value, and the key/hash pair is read evidence rather than a request to recompute the engine hash",
  "source_hashes": {
    "Crusader Kings III/game/common/character_interactions/_character_interactions.info": "F360C05B72CD2B0D87885E570FA55E70E41089DEFB4675BE5A82E390940D5D10",
