  "projection_invariants": {
    "exact_build": "reject before dereference unless the executable SHA-256 matches",
    "component_identity": "slot lookup by low 24 bits followed by complete ID equality and liveness",
    "normal_channel": "accept/reject/block additionally require exact local route and auto_accept_notification=false",
    "acknowledge_channel": "acknowledge requires exact local route and auto_accept_notification=true; raw validator enum 4 is ignored",
    "acknowledge_reachability": "production Snapshot preserves generation-valid locally routed +0x5C6 notifications, the paused mailbox can query them, and the strict fixed enum-4 action is unit-covered; live readiness remains false until a real nonreligious notification advances",
    "acknowledge_postcondition": "queue acceptance alone is not success; the native driver must observe a later snapshot in which the old full generation-bearing pending ID is absent or replaced",
    "malformed_observation": "publish status invalid and all action booleans false",
    "target_boundary": "a nonzero raw scope type has a stable registry type key; only canonical definition call_ally_interaction with exact type_index=16/type_key=war may publish a typed identity after the generation-safe full-ID resolver succeeds, while other definitions, unknown/non-war targets and resolver failures remain unavailable",
    "generic_cost_mapping": "all ten evaluator ordinals are mapped by the same-index render/formatter loop and independently cross-checked by the fixed-token serializer and affordability dispatch; no slot name is inferred from documentation order",
    "generic_cost_payment": "the actor paid the generic authored cost on_send, so an observed pending interaction reports already_applied history rather than a future responder liability",
    "generic_cost_signed_raw": "preserve signed int64 Q100000 because the native negative clamp is conditional",
    "special_war_binding": "only the three exact ordinary nonreligious definition/vptr pairs may join through 0x2610840 to one generation-valid active CWar; every other subtype remains typed opaque and no reply/effect/war mutator is called",
    "semantic_readiness": "legal reply availability alone never makes interaction_semantic_decision_ready true"
  },
