  "native_ai_tree": {
    "rare_task_tick_raw_days": [180, 720, 360, 180, 180, 180, 180],
    "law_opportunity": [
      "enumerate a visible/changeable group",
      "identify its active law and candidate laws",
      "evaluate candidate can_have plus realm/title applicability",
      "evaluate temporary can_pass and final pass_cost",
      "for stock AI only, keep able candidates with ai_will_do above zero and choose the highest score on RARE_TASK_TICK"
    ],
    "law_execution": [
      "the GUI obtains a GuiLaw and requires CanEnact before Enact",
      "schema defines on_pass immediately before the law change and on_after_pass immediately after it",
      "postcondition must re-query the active law, resources, and any affected successor vectors"
    ],
    "contract_opportunity": [
      "resolve the subject contract and require a modifiable, unblocked actual vassal relationship",
      "use obligation score for which side the proposed trade favors, while AI selection uses the separate liege/subject desire values",
      "only adjacent valid obligation levels compete with the current level",
      "ignore non-positive desire and desire not greater than the current level",
      "stock AI chooses by weighted random over valid desired levels after interaction cadence and hook/war gates"
    ],
    "contract_execution": [
      "the human UI builds a contract preview, selects enabled obligation levels, and sends the interaction",
      "on acceptance the script blocks modification and applies each changed obligation level",
      "AI routes trigger char_interaction.0250 or .0251, then apply the engine-selected most-desired level and consume the hook",
      "postcondition must re-query the same full-generation contract identity and active-level vector"
    ]
  },
