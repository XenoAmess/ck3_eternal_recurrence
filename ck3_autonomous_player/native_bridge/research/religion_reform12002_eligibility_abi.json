      "text": "\t\t\t\t\tbutton_primary = {\n\t\t\t\t\t\tname = \"edit_faith\"\n\t\t\t\t\t\tvisible = \"[And( RiteCreationWindow.IsEditing, Not( GetPlayer.GetFaith.IsUnreformed ) )]\"\n\t\t\t\t\t\tsize = { 400 60 }\n\n\t\t\t\t\t\tenabled = \"[And( RiteCreationWindow.CanEditRite, Not( IsObserver ) )]\"\n\t\t\t\t\t\tonclick = \"[RiteCreationWindow.EditRite]\"\n\t\t\t\t\t\ttooltip = \"RITE_CREATION_VIEW_EDIT_TT\"\n\n\t\t\t\t\t\ttext = \"RITE_CREATION_VIEW_EDIT\"\n\t\t\t\t\t\tusing = Font_Size_Medium\n\t\t\t\t\t}\n\n\t\t\t\t\tbutton_primary = {\n\t\t\t\t\t\tname = \"create_faith\"\n\t\t\t\t\t\tvisible = \"[And( RiteCreationWindow.IsCreating, Not( GetPlayer.GetFaith.IsUnreformed ) )]\"\n\t\t\t\t\t\tsize = { 400 60 }\n\n\t\t\t\t\t\tenabled = \"[And( RiteCreationWindow.CanCreateRite, Not( IsObserver ) )]\"\n\t\t\t\t\t\tonclick = \"[RiteCreationWindow.CreateRite]\"\n\t\t\t\t\t\ttooltip = \"RITE_CREATION_VIEW_CREATE_TT\"\n\n\t\t\t\t\t\ttext = \"RITE_CREATION_VIEW_CREATE\"\n\t\t\t\t\t\tusing = Font_Size_Medium\n\t\t\t\t\t}\n\n\t\t\t\t\tbutton_primary = {\n\t\t\t\t\t\tname = \"reform_faith\"\n\t\t\t\t\t\tvisible = \"[GetPlayer.GetFaith.IsUnreformed]\"\n\t\t\t\t\t\tsize = { 400 60 }\n\n\t\t\t\t\t\tenabled = \"[And( RiteCreationWindow.CanCreateRite, Not( IsObserver ) )]\"\n\t\t\t\t\t\tonclick = \"[RiteCreationWindow.CreateRite]\"\n\t\t\t\t\t\ttooltip = \"RITE_REFORM_BUTTON_TOOLTIP\"\n\n\t\t\t\t\t\ttext = \"RITE_CREATION_REFORM\"\n\t\t\t\t\t\tusing = Font_Size_Big"
    },
    {
      "path": "common/scripted_rules/00_rules.txt",
      "file_sha256": "c7ba2ae71e4461e88c6d5c86d8fc15fa7ccc73edae1e28fb3b65f0e362c4560f",
      "first_line": 22,
      "last_line": 33,
      "text": "# Determines if a rite can be edited, on top of the piety requirement, and the doctrine requirements\n# Root is the rite editor\ncan_edit_rite = {\n\tcan_edit_rite_trigger = yes\n}\n\n# Determines if a rite can be created, on top of the piety requirement, and the doctrine requirements\n# Also handles reforming a rite, check for the unreformed doctrine to enable those additional checks\n# Root is the rite creator\ncan_create_rite = {\n\tcan_create_rite_trigger = yes\n}"
    },
    {
      "path": "common/scripted_triggers/00_religious_triggers.txt",
      "file_sha256": "7dd3803989dffba22fdbf46cee084f68f29ddb9a32f90893726f6e5d311dd6f8",
      "first_line": 3140,
      "last_line": 3253,
      "text": "can_create_rite_trigger = {\n\n\tis_adult = yes\n\tis_at_war = no\n\t\n\ttrigger_if = {\n\t\tlimit = {\n\t\t\tis_clergy = no\n\t\t\thighest_held_title_tier = tier_county\n\t\t\ttop_liege != this\n\t\t}\n\t\tcustom_description = {\n\t\t\ttext = \"faith_creation_duchy_or_higher\"\n\t\t\thighest_held_title_tier >= tier_duchy\n\t\t}\n\t}\n\n\ttrigger_if = {\n\t\tlimit = {\n\t\t\trite = {\n\t\t\t\trite_has_doctrine = doctrine_theocracy_temporal\n\t\t\t}\n\t\t\tis_clergy = no\n\t\t\tOR = {\n\t\t\t\thas_puppet_type = theological_agent_puppet\n\t\t\t\thas_puppet_type = external_theological_agent_puppet\n\t\t\t}\n\t\t\t# Allow Mandala God-Kings and Son of Heaven to create and edit rites freely\n\t\t\ttrigger_if = {\n\t\t\t\tlimit = {\n\t\t\t\t\ttop_overlord = this\n\t\t\t\t}\n\t\t\t\tNOR = {\n\t\t\t\t\tgovernment_has_flag = government_is_mandala\n\t\t\t\t\tgovernment_has_flag = government_is_celestial\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tis_puppet_action_valid = puppet_trigger_can_create_rite\n\t}\n\t\n\tcustom_description = {\n\t\ttext = \"character_is_not_real_head\"\n\t\tfaith.religious_head != root\n\t}\n\n\tcustom_description = {\n\t\ttext = \"character_can_only_create_one_rite\"\n\t\tNOT = { exists = var:has_created_a_faith }\n\t}\n\n\ttrigger_if = {\n\t\tlimit = {\n\t\t\tfaith = { has_doctrine_parameter = unreformed }\n\t\t}\n\n\t\tNOT = {\n\t\t\tcustom_description = {\n\t\t\t\ttext = faith_has_been_reformed\n\t\t\t\tobject = faith\n\t\t\t\texists = faith.var:has_been_reformed\n\t\t\t}\n\t\t}\n\n\t\ttrigger_if = {\n\t\t\tlimit = {\n\t\t\t\tNOT = {\n\t\t\t\t\thas_character_flag = ignore_3_holy_site_rule\n\t\t\t\t}\n\t\t\t}\n\t\t\t# Empire Faith Gate: easier reformation path\n\t\t\ttrigger_if = {\n\t\t\t\tlimit = {\n\t\t\t\t\tempire_faith_gate_enabled_trigger = yes\n\t\t\t\t}\n\t\t\t\tcustom_tooltip = {\n\t\t\t\t\ttext = empire_faith_gate_reformation_piety_level\n\t\t\t\t\tpiety_level >= 2\n\t\t\t\t}\n\t\t\t\tcustom_tooltip = {\n\t\t\t\t\ttext = empire_faith_gate_reformation_tribal_authority\n\t\t\t\t\thas_realm_law = tribal_authority_3\n\t\t\t\t}\n\t\t\t\tcustom_tooltip = {\n\t\t\t\t\ttext = empire_faith_gate_reformation_holy_site\n\t\t\t\t\tfaith = {\n\t\t\t\t\t\tany_holy_site_barony = {\n\t\t\t\t\t\t\tcount >= 3\n\t\t\t\t\t\t\tcounty.holder = {\n\t\t\t\t\t\t\t\tfaith = root.faith\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\t# Vanilla: 3 holy sites\n\t\t\ttrigger_else = {\n\t\t\t\tfaith = {\n\t\t\t\t\tnum_realm_holy_sites_faithful_holders = {\n\t\t\t\t\t\tCHARACTER = root\n\t\t\t\t\t\tCOUNT = 3\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tcustom_tooltip = {\n\t\t\ttext = faith_reformation_via_decision\n\t\t\tfaith = {\n\t\t\t\tNOT = { has_variable = block_reformation_var }\n\t\t\t}\n\t\t}\n\t}\n}"
    }
