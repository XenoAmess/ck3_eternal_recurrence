{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenoamess.example/schemas/vanilla-event-portable-evidence-manifest-v1.schema.json",
  "title": "Vanilla event portable evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "ck3_build",
    "ck3_exe_sha256",
    "compression",
    "statistics",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "xar.ck3.vanilla-event-portable-evidence-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "ck3_build": {
      "const": "1.19.0.6"
    },
    "ck3_exe_sha256": {
      "const": "2D00FF3101EF70B566F2FCBAE292F09263199C80E9DC8F139B82D7D96F83DB86"
    },
    "compression": {
      "const": {
        "algorithm": "gzip",
        "filename": "",
        "mtime": 0
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "generated_definition_references",
        "lexical_caller_candidate_references",
        "manually_reviewed_analysis_source_references",
        "observation_artifacts",
        "observation_artifact_references",
        "references",
        "source_definitions"
      ],
      "properties": {
        "evidence": {"type": "integer", "minimum": 0},
        "generated_definition_references": {"type": "integer", "minimum": 0},
        "lexical_caller_candidate_references": {"type": "integer", "minimum": 0},
        "manually_reviewed_analysis_source_references": {"type": "integer", "minimum": 0},
        "observation_artifacts": {"type": "integer", "minimum": 0},
        "observation_artifact_references": {"type": "integer", "minimum": 0},
        "references": {"type": "integer", "minimum": 0},
        "source_definitions": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blob_bytes",
          "blob_path",
          "blob_sha256",
          "bytes",
          "evidence_id",
          "kind",
          "media_type",
          "references",
          "sha256"
        ],
        "properties": {
          "blob_bytes": {"type": "integer", "minimum": 1},
          "blob_path": {"type": "string", "pattern": "^blobs/[0-9a-f]{64}\\.gz$"},
          "blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "evidence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"enum": ["source_definition", "observation_artifact"]},
          "media_type": {
            "enum": [
              "application/json",
              "application/yaml; charset=utf-8",
              "image/png",
              "text/plain; charset=utf-8"
            ]
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caller_candidate_resolution",
                "event_definition_key",
                "logical_path",
                "origin",
                "provenance",
                "role",
                "source_column",
                "source_line"
              ],
              "properties": {
                "caller_candidate_resolution": {
                  "enum": ["external-definition-file", "same-definition-file-only", null]
                },
                "event_definition_key": {"type": "string", "minLength": 1},
                "logical_path": {"type": "string", "minLength": 1},
                "origin": {"enum": ["ck3_game", "runtime"]},
                "provenance": {
                  "enum": [
                    "captured-observation-artifact",
                    "generated-definition-index",
                    "lexical-caller-candidate-not-proven-runtime-caller",
                    "manually-reviewed-analysis-source"
                  ]
                },
                "role": {"type": "string", "minLength": 1},
                "source_column": {"type": ["integer", "null"], "minimum": 1},
                "source_line": {"type": ["integer", "null"], "minimum": 1}
              }
            }
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
