{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xar.local/schemas/reflection-v1.schema.json",
  "title": "Constrained post-episode reflection",
  "type": "object",
  "required": [
    "format_version",
    "episode_id",
    "strategy_id",
    "evidence_episode_count",
    "driver_failures",
    "strategic_findings",
    "proposed_experiments"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "episode_id": { "type": "string" },
    "strategy_id": { "type": "string" },
    "evidence_episode_count": { "type": "integer", "minimum": 1 },
    "driver_failures": { "type": "array", "items": { "type": "object" } },
    "strategic_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "proposed_experiments": { "type": "array", "items": { "type": "object" } }
  }
}

