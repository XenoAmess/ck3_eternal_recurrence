{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xar.local/schemas/environment-v1.schema.json",
  "title": "XAR autonomous-player environment",
  "type": "object",
  "required": [
    "format_version",
    "agent_version",
    "agent_runtime",
    "game",
    "mod",
    "load_profile",
    "rules",
    "display",
    "legality",
    "environment_sha256"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "agent_version": { "type": "string" },
    "agent_runtime": {
      "type": "object",
      "required": ["file_count", "sha256", "files"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": { "type": "array", "minItems": 1 }
      }
    },
    "environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "game": {
      "type": "object",
      "required": ["raw_version", "executable", "debug_mode"],
      "properties": {
        "raw_version": { "type": "string" },
        "executable": { "type": "string" },
        "debug_mode": { "const": false }
      }
    },
    "mod": {
      "type": "object",
      "required": [
        "name",
        "git_revision",
        "production_path",
        "production_tree_sha256"
      ],
      "properties": {
        "name": { "const": "琉焰卿的永恒轮回" },
        "git_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "production_path": { "type": "string" },
        "production_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "load_profile": {
      "type": "object",
      "required": ["enabled_mods", "disabled_dlcs"],
      "properties": {
        "enabled_mods": {
          "const": ["mod/xar_autoplayer.mod"]
        },
        "disabled_dlcs": {
          "const": []
        }
      }
    },
    "rules": {
      "type": "object",
      "required": ["profile", "profile_sha256", "ironman"],
      "properties": {
        "profile": { "type": "array", "minItems": 73 },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ironman": { "const": false }
      }
    },
    "display": {
      "type": "object",
      "required": ["language", "resolution"],
      "properties": {
        "language": { "const": "l_simp_chinese" },
        "resolution": { "const": [2560, 1440] }
      }
    },
    "legality": { "type": "object" }
  }
}
