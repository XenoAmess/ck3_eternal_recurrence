{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenoamess.example/schemas/vanilla-event-evidence-list-v1.schema.json",
  "title": "Vanilla event portable evidence list v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "ck3_build",
    "ck3_exe_sha256",
    "event_definition_key",
    "kind",
    "after_evidence_id",
    "limit",
    "dataset_sha256",
    "total_matches",
    "evidence",
    "next_after_evidence_id",
    "unavailable_reason",
    "invalid_parameter"
  ],
  "properties": {
    "schema": {
      "const": "xar.ck3.vanilla-event-evidence-list"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["available", "unavailable"]
    },
    "ck3_build": {
      "const": "1.19.0.6"
    },
    "ck3_exe_sha256": {
      "const": "2D00FF3101EF70B566F2FCBAE292F09263199C80E9DC8F139B82D7D96F83DB86"
    },
    "event_definition_key": {
      "type": ["string", "null"]
    },
    "kind": {
      "enum": ["source_definition", "observation_artifact", null]
    },
    "after_evidence_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "limit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "dataset_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9A-F]{64}$"
    },
    "total_matches": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "next_after_evidence_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "unavailable_reason": {
      "type": ["string", "null"],
      "enum": [
        "unsupported_ck3_build",
        "invalid_event_definition_key",
        "invalid_evidence_kind",
        "invalid_cursor",
        "invalid_limit",
        "bundle_integrity_error",
        "event_definition_key_not_indexed",
        null
      ]
    },
    "invalid_parameter": {
      "type": ["string", "null"],
      "enum": [
        "ck3_build",
        "event_definition_key",
        "kind",
        "after_evidence_id",
        "limit",
        null
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caller_candidate_resolution",
        "event_definition_key",
        "logical_path",
        "origin",
        "provenance",
        "role",
        "source_column",
        "source_line"
      ],
      "properties": {
        "caller_candidate_resolution": {
          "enum": ["external-definition-file", "same-definition-file-only", null]
        },
        "event_definition_key": {
          "type": "string",
          "minLength": 1
        },
        "logical_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:[A-Za-z]:|/|\\\\)"
          }
        },
        "origin": {
          "enum": ["ck3_game", "runtime"]
        },
        "provenance": {
          "enum": [
            "captured-observation-artifact",
            "generated-definition-index",
            "lexical-caller-candidate-not-proven-runtime-caller",
            "manually-reviewed-analysis-source"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "source_column": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_line": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "evidence_id",
        "kind",
        "media_type",
        "references",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_id": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": ["source_definition", "observation_artifact"]
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/yaml; charset=utf-8",
            "image/png",
            "text/plain; charset=utf-8"
          ]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
