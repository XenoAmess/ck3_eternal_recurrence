    "heir_character_id": {"type": "integer", "minimum": 1},
    "candidate_character_id": {"type": "integer", "minimum": 1}
  },
  "oneOf": [
    {"properties": {"status": {"const": "receipt_pending"}, "step": {"const": "submit-observed-first-heir-marriage-v1-private"}, "material_result": {"const": false}}, "required": ["played_character_id"]},
    {"properties": {"status": {"const": "pending"}, "step": {"const": "query-observed-first-heir-marriage-result-v1-private"}, "material_result": {"const": false}}, "required": ["post_native_revision"]},
    {"properties": {"status": {"enum": ["marriage", "betrothal"]}, "step": {"const": "query-observed-first-heir-marriage-result-v1-private"}, "material_result": {"const": true}}, "required": ["post_native_revision"]}
  ]
}
