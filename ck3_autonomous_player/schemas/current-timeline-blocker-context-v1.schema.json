{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xar.invalid/schemas/current-timeline-blocker-context-v1.schema.json",
  "title": "CK3 current timeline blocker context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "snapshot_revision",
    "date_raw",
    "identity",
    "blocks_simulation",
    "has_open_succession",
    "can_continue",
    "evidence_source",
    "unavailable_reason"
  ],
  "properties": {
    "schema": {"const": "current-timeline-blocker-context-v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["available", "unavailable"]},
    "snapshot_revision": {"type": "integer", "minimum": 1},
    "date_raw": {"type": "integer"},
    "identity": {
      "enum": [
        "none",
        "death_succession_modal",
        "game_over_modal",
        "succession_select_destiny_modal"
      ]
    },
    "blocks_simulation": {"$ref": "#/$defs/typedBoolean"},
    "has_open_succession": {"$ref": "#/$defs/typedBoolean"},
    "can_continue": {"$ref": "#/$defs/typedBoolean"},
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "root_name", "decisive_widget_name"],
      "properties": {
        "kind": {"type": "string"},
        "path": {"type": "string"},
        "root_name": {"type": "string"},
        "decisive_widget_name": {"type": "string"}
      }
    },
    "unavailable_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "typedBoolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unavailable_reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "value": {"type": ["boolean", "null"]},
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {
            "properties": {
              "value": {"type": "boolean"},
              "unavailable_reason": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "value": {"type": "null"},
              "unavailable_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
