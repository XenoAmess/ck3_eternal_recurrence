l_english:
 lyd_c3_declare_claim_decision:0 "Present a Lineage Claim"
 lyd_c3_declare_claim_decision_desc:0 "I present my own claim to the transmission of this rite. This claim has not been recognized and does not replace the current common religious leader."
 lyd_c3_declare_claim_decision_tooltip:0 "Record an independent lineage claim"
 lyd_c3_declare_claim_decision_confirm:0 "Present My Claim"
 lyd_c3_withdraw_claim_decision:0 "Withdraw My Lineage Claim"
 lyd_c3_withdraw_claim_decision_desc:0 "Withdraw my claim and its own office. Other claimants retain their claims."
 lyd_c3_withdraw_claim_decision_tooltip:0 "Withdraw only my own claim"
 lyd_c3_withdraw_claim_decision_confirm:0 "Withdraw My Claim"
 lyd_c3_begin_council_decision:0 "Request Common Recognition"
 lyd_c3_begin_council_decision_desc:0 "Request recognition as the common religious leader from the existing rites and every affected player. An incumbent must also consent to surrender this office. This round lasts ninety days."
 lyd_c3_begin_council_decision_tooltip:0 "Request recognition from the rites and incumbent"
 lyd_c3_begin_council_decision_confirm:0 "Open the Deliberation"
 lyd_c3_review_council_decision:0 "Review Common Recognition"
 lyd_c3_review_council_decision_desc:0 "The consents apply only to this round's candidate, incumbent and rite affiliations. I may assume this office only after every required consent is present."
 lyd_c3_review_council_decision_tooltip:0 "Review this round's consents"
 lyd_c3_review_council_decision_confirm:0 "Review the Deliberation"
 lyd_c3_cancel_council_decision:0 "End My Deliberation"
 lyd_c3_cancel_council_decision_desc:0 "End this round and release its reservations. My lineage claim remains and may be proposed again."
 lyd_c3_cancel_council_decision_tooltip:0 "Release only this round's reservations"
 lyd_c3_cancel_council_decision_confirm:0 "End the Deliberation"
 lyd_c3_reconcile_decision:0 "Review Teaching and Office Records"
 lyd_c3_reconcile_decision_desc:0 "Review my teaching, claim and recognition records. Reservations left by dead or expired initiators may be cleared; current deliberations remain intact."
 lyd_c3_reconcile_decision_tooltip:0 "Clear records that are no longer current"
 lyd_c3_reconcile_decision_confirm:0 "Review the Records"
 lyd_c3_abdicate_decision:0 "Resign the Common Office"
 lyd_c3_abdicate_decision_desc:0 "Resign this common religious office while retaining my other titles. The rites may deliberate over a replacement."
 lyd_c3_abdicate_decision_tooltip:0 "Resign the religious office established by this mod"
 lyd_c3_abdicate_decision_confirm:0 "Resign This Office"
 lyd_c3_leave_teacher_decision:0 "End My Teaching Link"
 lyd_c3_leave_teacher_decision_desc:0 "End my private teaching link. This does not change the representatives of my rite or the common religious leader."
 lyd_c3_leave_teacher_decision_tooltip:0 "End private teaching"
 lyd_c3_leave_teacher_decision_confirm:0 "End the Link"
 lyd_c3_request_teacher_interaction:0 "Request Personal Teaching"
 lyd_c3_request_teacher_interaction_desc:0 "Ask this person to accept a private teaching link. It is established only after they accept."
 lyd_c3_nominate_claim_interaction:0 "Nominate a Lineage Claimant"
 lyd_c3_nominate_claim_interaction_desc:0 "Ask this person to present an independent lineage claim. They may accept or refuse. Nomination does not replace the common religious leader."
 lyd_c3_request_withdraw_interaction:0 "Request Withdrawal of Their Claim"
 lyd_c3_request_withdraw_interaction_desc:0 "Ask a claimant I nominated to withdraw voluntarily. They may refuse."
 lyd_c3_claim_title_name:0 "Lineage Challenger Office"
 lyd_c3_claim_title_adj:0 "Lineage Challenger"
 lyd_c3_delegate_t:0 "A Rite's Recognition"
 lyd_c3_delegate_desc:0 "A follower of our common faith requests recognition. As the current representative of my rite, I may consent or refuse this particular round."
 lyd_c3_player_consent_t:0 "Consent to the Common Office"
 lyd_c3_player_consent_desc:0 "This deliberation affects my common faith. I may consent or refuse. This round cannot appoint the candidate without my consent."
 lyd_c3_incumbent_t:0 "Relinquishing the Common Office"
 lyd_c3_incumbent_desc:0 "A follower requests to succeed me in the common office. My consent concerns only the religious title established by this mod. My other titles are not included in the transfer."
 lyd_c3_review_t:0 "Common Recognition"
 lyd_c3_review_desc:0 "The existing rites, every affected player and the incumbent must consent. Changes in affiliation or office invalidate this round and require a fresh proposal."
 lyd_c3_yes:0 "Consent to this round"
 lyd_c3_no:0 "Refuse this round"
 lyd_c3_release_office:0 "Consent to relinquish the common office"
 lyd_c3_recognize:0 "Accept recognition and assume the common office"
 lyd_c3_recognize_tt:0 "Recognition is recorded only after all current consents and the actual appointment succeed. Other challengers retain their claims."
 lyd_c3_wait:0 "Continue waiting"
 lyd_c3_cancel:0 "End this round"
