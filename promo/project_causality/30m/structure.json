  "status": "argument-lock-in-progress",
  "segments": [
    {"id": "00-result-question", "start": 0, "end": 55, "chapter": "开场", "argument": "多个可见结果是否来自同一套系统，而不是手工偶然？"},
    {"id": "01-project-thesis", "start": 55, "end": 120, "chapter": "开场", "argument": "独立产品共享工程方法、证据和演进机制。"},
    {"id": "02-four-layer-map", "start": 120, "end": 190, "chapter": "开场", "argument": "咒、术、道与辉煌愿景是结果、方法、原则与方向。"},
    {"id": "03-spell-declaration", "start": 190, "end": 210, "chapter": "章门", "argument": "咒。先看结果：玩家今天究竟得到了什么？"},
    {"id": "04-eternal-recurrence", "start": 210, "end": 420, "chapter": "咒", "argument": "旗舰产品把一生变成可构筑、结算和跨局消费的 episode。"},
    {"id": "05-vivhite", "start": 420, "end": 480, "chapter": "咒", "argument": "独立廷臣版说明能力可以拆成边界清楚的原子产品。"},
    {"id": "06-zhongguo-361-public", "start": 480, "end": 570, "chapter": "咒", "argument": "361 公开能力是制度模拟，不是按钮数量宣传。"},
    {"id": "07-independent-products", "start": 570, "end": 670, "chapter": "咒", "argument": "六个小产品各自解决一个明确玩家问题并保持独立边界。"},
    {"id": "08-coat-of-arms-editor", "start": 670, "end": 730, "chapter": "咒", "argument": "浏览器工具在不连接 CK3、不上传图片的前提下编辑与拟合家徽。"},
    {"id": "09-agent-current-state", "start": 730, "end": 820, "chapter": "咒", "argument": "自动玩家已经闭合部分真实 OODA，但尚不是通用 CK3 玩家。"},
    {"id": "10-method-declaration", "start": 820, "end": 840, "chapter": "章门", "argument": "术。再追因果：这些结果，怎样被稳定制造？"},
    {"id": "10-documents", "start": 840, "end": 900, "chapter": "术", "argument": "文档是可施工的权威入口，而不是事后说明。"},
    {"id": "11-generation", "start": 900, "end": 975, "chapter": "术", "argument": "单一权威数据通过生成器投影到脚本、界面、测试和文档。"},
    {"id": "12-validation-open-kaishek", "start": 975, "end": 1065, "chapter": "术", "argument": "四层验证与 open_kaishek 分担离线可证和 CK3 必须裁决的语义。"},
    {"id": "13-mcp", "start": 1065, "end": 1140, "chapter": "术", "argument": "MCP 是版本绑定、权限明确的 typed capability，不是万能后门。"},
    {"id": "14-ocr-boundary", "start": 1140, "end": 1200, "chapter": "术", "argument": "OCR 负责可见事实，native typed state 负责隐藏真值，两者互证且有禁区。"},
    {"id": "15-agent-construction", "start": 1200, "end": 1240, "chapter": "术", "argument": "自动玩家从原生研究和观察口开始，再获得动作、策略与记忆。"},
    {"id": "16-release-promo", "start": 1240, "end": 1270, "chapter": "术", "argument": "GREEN 必须进入可复现发行、回读和可信展示。"},
    {"id": "17-principle-declaration", "start": 1270, "end": 1290, "chapter": "章门", "argument": "道。然后校准尺度：我们凭什么说，它是真的？"},
    {"id": "18-doc-test-code", "start": 1290, "end": 1350, "chapter": "道", "argument": "文档决定应然，测试使其可判定，代码负责实现。"},
    {"id": "19-state-over-ack", "start": 1350, "end": 1395, "chapter": "道", "argument": "独立后置状态高于 click、ACK 和 schema。"},
    {"id": "20-evidence-exact-build", "start": 1395, "end": 1450, "chapter": "道", "argument": "证据有等级，exact build 和原生事实属于能力本身。"},
    {"id": "21-value-boundaries", "start": 1450, "end": 1510, "chapter": "道", "argument": "最终尺度是玩家价值，边界与交付节奏不能被形式主义替代。"},
    {"id": "22-vision-declaration", "start": 1510, "end": 1530, "chapter": "章门", "argument": "辉煌愿景。最后闭合因果：下一次创造，怎样从这一次生长？"},
    {"id": "23-why-loops", "start": 1530, "end": 1560, "chapter": "辉煌愿景", "argument": "每次交付必须留下下一次能够消费的结构化输入。"},
    {"id": "24-loop-a", "start": 1560, "end": 1600, "chapter": "辉煌愿景", "argument": "玩家产品 Loop 把真实游玩反馈送回下一版合同。"},
    {"id": "25-loop-b", "start": 1600, "end": 1640, "chapter": "辉煌愿景", "argument": "智能体 Loop 由真实 blocker 驱动观察、动作和策略扩张。"},
    {"id": "26-loop-c", "start": 1640, "end": 1680, "chapter": "辉煌愿景", "argument": "工具链 Loop 把新语义和 RED 变成可复用能力。"},
    {"id": "27-loop-d", "start": 1680, "end": 1720, "chapter": "辉煌愿景", "argument": "证据与发行 Loop 把 GREEN 送往外部世界并带回反馈。"},
    {"id": "28-interlock-human", "start": 1720, "end": 1755, "chapter": "辉煌愿景", "argument": "四环互相供给，人类仍掌握愿景、价值、边界与签核。"},
    {"id": "29-finale", "start": 1755, "end": 1800, "chapter": "终幕", "argument": "让下一次创造拥有自己的轮回。"}
  ]
}
