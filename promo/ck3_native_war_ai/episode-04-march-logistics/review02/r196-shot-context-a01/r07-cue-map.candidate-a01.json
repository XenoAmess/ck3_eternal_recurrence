      "sentences": [
        {
          "index": 1,
          "frozen_zh": "这一轮跟着一点二零点零点四里的罗贝尔。",
          "actual_provider_offset_100ns": 1000000,
          "actual_provider_duration_100ns": 42657895,
          "r196_use": "版本与人物来源可保留；R196是同一.4罗贝尔的独立fresh treatment。"
        },
        {
          "index": 2,
