      "sentences": [
        {
          "index": 1,
          "frozen_zh": "路线提示“会支付登船费”，是下令前的警告；实际扣款要另看。",
          "actual_provider_offset_100ns": 1000000,
          "actual_provider_duration_100ns": 63842106,
          "r196_use": "原句是下令前警告机制；R196开录在Move之后，本片无source-bound quote或该提示展开，仍pending。"
        },
        {
          "index": 2,
          "frozen_zh": "这次军队进入海区后，独立现金查询和原生支付链对上了一笔三金币扣款，属于这个账户的这一次登船。",
          "actual_provider_offset_100ns": 64342106,
          "actual_provider_duration_100ns": 101710527,
          "r196_use": "R196生产链给出personal31254 SUB3，回调余额260.10399→257.10399；可复用口播但标新run，不沿用R173钱包。"
        },
        {
          "index": 3,
          "frozen_zh": "它不自动成为所有军队的固定费率。",
          "actual_provider_offset_100ns": 166052633,
          "actual_provider_duration_100ns": 34605263,
          "r196_use": "个案范围正确；不能推出固定费率、每百人收费或commander付款因果。"
        },
        {
          "index": 4,
          "frozen_zh": "县域损失预算也一样：提示的是特定条件下的计算，不能说每经过一个省就必定少同样多的兵。",
          "actual_provider_offset_100ns": 200657897,
          "actual_provider_duration_100ns": 91315790,
          "r196_use": "县损失是另一个source机制；R196登船片不证明县损失正例。"
        }
      ]
