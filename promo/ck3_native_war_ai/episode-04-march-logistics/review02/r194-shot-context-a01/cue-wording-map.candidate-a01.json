      "sentences": [
        {
          "index": 1,
          "frozen_zh": "拆军和合军，对补给不是同一种处理。",
          "actual_provider_offset_100ns": 1000000,
          "actual_provider_duration_100ns": 38447368,
          "r194_use": "拆／合不同处理的机制概述。"
        },
        {
          "index": 2,
          "frozen_zh": "拆出的新军先复制来源库存，不按人数除半；两军容量却要各自看当前统帅和条件。",
          "actual_provider_offset_100ns": 38947368,
          "actual_provider_duration_100ns": 87631580,
          "r194_use": "复制库存与各自容量用既有source；本场100/100，不证明容量差。"
        },
        {
          "index": 3,
          "frozen_zh": "合军先保存两侧原库存和各自角色权重，选将、调整编成以后，再读取合后容量。",
          "actual_provider_offset_100ns": 126578948,
          "actual_provider_duration_100ns": 87631580,
          "r194_use": "执行顺序与角色权重来自既有source；本场native权重75/175与实际后态另证。"
        },
        {
          "index": 4,
          "frozen_zh": "这次小军实体兵员二百五十人守恒，不代表库存也按同一种方式守恒。",
          "actual_provider_offset_100ns": 214210529,
          "actual_provider_duration_100ns": 72894737,
          "r194_use": "本次R194实体250守恒；cache251另列，不能说库存和人数同口径守恒。"
        },
        {
          "index": 5,
          "frozen_zh": "合后库存、容量和统帅，都要分别读回。",
          "actual_provider_offset_100ns": 287105266,
          "actual_provider_duration_100ns": 44473684,
          "r194_use": "读回方法；本场stock100/cap100/commander34232来自native。"
