      "sentences": [
        {
          "index": 1,
          "frozen_zh": "在已核的普通正权重路径里，合军先分别算两军的权重份额，各自取整；再各自乘原来的库存，再取整，最后相加。",
          "actual_provider_offset_100ns": 1000000,
          "actual_provider_duration_100ns": 116236843,
          "r194_use": "普通正权重fast路径source公式；本场75/175与30/70实际核对。"
        },
        {
          "index": 2,
          "frozen_zh": "两个份额合计可能略低于百分之一百，游戏不会把余数补回去。",
          "actual_provider_offset_100ns": 117236843,
          "actual_provider_duration_100ns": 62500000,
          "r194_use": "这是源码允许的可能性；本场份额恰为30/70，没有观测份额缺口。"
        },
        {
          "index": 3,
          "frozen_zh": "合计库存还要按零和合后实际容量截断，所以不能化成一次普通平均。",
          "actual_provider_offset_100ns": 179736844,
          "actual_provider_duration_100ns": 75526316,
          "r194_use": "clamp规则来自source；本场preclamp=cap，upper-clamp正例仍false。"
        },
        {
          "index": 4,
          "frozen_zh": "大值另有保护分支，不能套这条简式。",
          "actual_provider_offset_100ns": 255263161,
          "actual_provider_duration_100ns": 39210526,
          "r194_use": "大值保护分支source；不是本场执行样本。"
        },
        {
          "index": 5,
          "frozen_zh": "真正合后库存，再用实际读数核对。",
          "actual_provider_offset_100ns": 294473687,
          "actual_provider_duration_100ns": 38815789,
          "r194_use": "本场actual stock100；精确raw读回与UI100/100分开。"
        }
