[
  {
    "type": "SentenceBoundary",
    "offset": 1000000,
    "duration": 58315790,
    "text": "这支军队的补给先被受控地设为零，不是行军中自然耗尽。"
  },
  {
    "type": "SentenceBoundary",
    "offset": 58815790,
    "duration": 85657895,
    "text": "二月四日到五日，兵数从六千七百四十六变为六千三百四十二，画面净少四百零四。"
  },
  {
    "type": "SentenceBoundary",
    "offset": 144473686,
    "duration": 82763158,
    "text": "原生写入分别证实：供给扣兵三百三十七；围城与劫掠共用阶段另扣六十七。"
  }
]
