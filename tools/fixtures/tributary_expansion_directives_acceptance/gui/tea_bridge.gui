window = {
	name = "tea_bridge_window"
	size = { 1 1 }
	layer = tutorial
	position = { 0 0 }
	visible = "[GetPlayer.IsValid]"
	alwaystransparent = yes
	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }
	state = { name = "tea_initialize" trigger_when = "[GetScriptedGui('tea_initialize_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('tea_initialize_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "tea_setup" trigger_when = "[GetScriptedGui('tea_setup_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('tea_setup_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "tea_verify_attacker" trigger_when = "[GetScriptedGui('tea_verify_attacker_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('tea_verify_attacker_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
}
