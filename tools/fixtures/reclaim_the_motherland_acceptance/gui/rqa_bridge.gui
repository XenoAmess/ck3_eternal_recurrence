window = {
	name = "rqa_bridge_window"
	size = { 1 1 }
	layer = tutorial
	position = { 0 0 }
	visible = "[GetPlayer.IsValid]"
	alwaystransparent = yes
	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }
	state = { name = "rqa_initialize" trigger_when = "[GetScriptedGui('rqa_initialize_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_initialize_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_chaos" trigger_when = "[GetScriptedGui('rqa_enter_chaos_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_enter_chaos_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_dispatch_chaos" trigger_when = "[GetScriptedGui('rqa_dispatch_chaos_event_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_dispatch_chaos_event_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_verify_chaos" trigger_when = "[GetScriptedGui('rqa_verify_chaos_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_verify_chaos_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_execute_succession" trigger_when = "[GetScriptedGui('rqa_execute_succession_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_execute_succession_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_verify_succession" trigger_when = "[GetScriptedGui('rqa_verify_succession_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_verify_succession_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_verify_recent_independence_expiry" trigger_when = "[GetScriptedGui('rqa_verify_recent_independence_expiry_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_verify_recent_independence_expiry_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_threshold" trigger_when = "[GetScriptedGui('rqa_prepare_threshold_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_prepare_threshold_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "rqa_restoration" trigger_when = "[GetScriptedGui('rqa_verify_restoration_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('rqa_verify_restoration_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
}
