window = {
	name = "zqa_bridge_window"
	size = { 1 1 }
	layer = tutorial
	position = { 0 0 }
	visible = "[GetPlayer.IsValid]"
	alwaystransparent = yes
	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }
	state = { name = "zqa_initialize" trigger_when = "[GetScriptedGui('zqa_initialize_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_initialize_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_enabled" trigger_when = "[GetScriptedGui('zqa_enabled_matrix_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_enabled_matrix_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_death" trigger_when = "[GetScriptedGui('zqa_death_matrix_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_death_matrix_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_disabled" trigger_when = "[GetScriptedGui('zqa_disabled_matrix_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_disabled_matrix_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
}
