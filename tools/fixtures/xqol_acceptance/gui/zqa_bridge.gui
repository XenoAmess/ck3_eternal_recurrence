window = {
	name = "zqa_bridge_window"
	size = { 1 1 }
	layer = tutorial
	position = { 0 0 }
	visible = "[GetPlayer.IsValid]"
	alwaystransparent = yes
	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }
	state = { name = "zqa_initialize" trigger_when = "[GetScriptedGui('zqa_initialize_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_initialize_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_defense_initialize" trigger_when = "[GetScriptedGui('zqa_defense_initialize_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_defense_initialize_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_defense_setup_after_switch" trigger_when = "[GetScriptedGui('zqa_defense_setup_after_switch_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_defense_setup_after_switch_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_enabled" trigger_when = "[GetScriptedGui('zqa_enabled_matrix_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_enabled_matrix_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_death" trigger_when = "[GetScriptedGui('zqa_death_matrix_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_death_matrix_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_disabled" trigger_when = "[GetScriptedGui('zqa_disabled_matrix_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_disabled_matrix_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_payment_full" trigger_when = "[GetScriptedGui('zqa_payment_full_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_payment_full_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_payment_any" trigger_when = "[GetScriptedGui('zqa_payment_any_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_payment_any_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_conversion" trigger_when = "[GetScriptedGui('zqa_phase2_conversion_verify_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_phase2_conversion_verify_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_ransom_full" trigger_when = "[GetScriptedGui('zqa_phase2_ransom_full_verify_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_phase2_ransom_full_verify_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_ransom_any" trigger_when = "[GetScriptedGui('zqa_phase2_ransom_any_verify_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_phase2_ransom_any_verify_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_release" trigger_when = "[GetScriptedGui('zqa_phase2_release_verify_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_phase2_release_verify_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
	state = { name = "zqa_defense" trigger_when = "[GetScriptedGui('zqa_phase2_defense_verify_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" on_start = "[GetScriptedGui('zqa_phase2_defense_verify_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
}
