include("${CMAKE_BINARY_DIR}/../attempt02/runtime-source-macro-restore.cmake")

function(xar_native30_replace_tracking_fixture05)
  set(_target xar_ck3_camera_tracking_v1_test)
  if(NOT MSVC OR NOT TARGET ${_target})
    message(FATAL_ERROR "Native30 fixture05 requires its exact MSVC test target")
  endif()
  get_target_property(_sources ${_target} SOURCES)
  set(_old "${CMAKE_SOURCE_DIR}/src/camera_tracking_v1_test.cpp")
  set(_new "${CMAKE_BINARY_DIR}/native30-fixture05/camera_tracking_v1_test.cpp")
  set(_replacements 0)
  set(_result)
  foreach(_source IN LISTS _sources)
    get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(_absolute STREQUAL _old)
      list(APPEND _result "${_new}")
      math(EXPR _replacements "${_replacements}+1")
    else()
      list(APPEND _result "${_source}")
    endif()
  endforeach()
  if(NOT _replacements EQUAL 1 OR NOT EXISTS "${_new}")
    message(FATAL_ERROR "Native30 fixture05 requires one old TU and one fixed generated copy")
  endif()
  set_property(TARGET ${_target} PROPERTY SOURCES "${_result}")
  set_source_files_properties("${_new}" PROPERTIES GENERATED TRUE)
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL xar_native30_replace_tracking_fixture05)
