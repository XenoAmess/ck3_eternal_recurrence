{
  "scope": "One fresh plan, at most twelve actual natural days; inherited immutable Song/PID/generation/pause guards, immediate FAIL rejection after each day. Active events stop the plan and require real UI; no automatic reply or callback.",
  "steps": [
    {
      "id": "qol-ordinary-async-initial-map",
      "tool": "ck3_take_snapshot",
      "args": {},
      "expect": {
        "paused": true,
        "map_ready": true,
        "played_character.alive": true,
        "played_character.source": "native",
        "episode_projection": "native_campaign",
        "active_event": null,
        "backend_id": "native-headless",
        "source": "injected-dll-named-pipe"
      }
    },
    {
      "id": "qol-ordinary-async-initial-root",
      "tool": "ck3_query_campaign_root_context_v1",
      "args": {},
      "continue_on_error": true
    },
    {
      "id": "qol-ordinary-async-startup-proof",
      "tool": "ck3_query_engine_log_literals_v1",
      "args": {
        "log_name": "debug.log",
        "literals": [
          "ZQR120QUAL: SCOPE BEGIN actual_song_actor_D0",
          "ZQR120QUAL: TEST PASS actual_song_actor_D0",
          "ZQR120QUAL: SCOPE END actual_song_actor_D0",
          "ZQN120: TEST READY ordinary_courtiers_valid",
          "ZQN120: TEST BEGIN seeded_two_actual_async_replies",
          "ZQN120: TEST BEGIN engine_startup"
        ],
        "sample_limit": 2
      },
      "expect": {
        "exists": true,
        "matches.0.literal": "ZQR120QUAL: SCOPE BEGIN actual_song_actor_D0",
        "matches.0.line_count": 1,
        "matches.1.literal": "ZQR120QUAL: TEST PASS actual_song_actor_D0",
        "matches.1.line_count": 1,
        "matches.2.literal": "ZQR120QUAL: SCOPE END actual_song_actor_D0",
        "matches.2.line_count": 1,
        "matches.3.literal": "ZQN120: TEST READY ordinary_courtiers_valid",
        "matches.3.line_count": 1,
        "matches.4.literal": "ZQN120: TEST BEGIN seeded_two_actual_async_replies",
        "matches.4.line_count": 1,
        "matches.5.literal": "ZQN120: TEST BEGIN engine_startup",
        "matches.5.line_count": 1
      }
    },
