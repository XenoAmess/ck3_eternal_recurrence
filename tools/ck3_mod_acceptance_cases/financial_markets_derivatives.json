      "actual_changed_completed_day_mark_yields_integer_zero_sum_variation_from_loser_margin_to_winner_once",
      "actual_native_amount_checks_include_absolute_variation_and_ck3_upper_lower_clamp_semantics",
      "actual_gap_loss_keeps_original_day_parties_amount_and_source_identity_in_pending_and_debt_receipt",
