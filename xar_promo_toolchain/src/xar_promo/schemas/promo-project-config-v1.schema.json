{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xar-promo:schema:project-config:v1",
  "title": "XAR Promo ProjectConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "project", "pipeline", "locales", "constraints", "chapters"],
  "properties": {
    "format_version": {"const": 1},
    "kind": {"const": "xar_promo_project_config"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "preset"],
      "properties": {"adapter": {"$ref": "#/$defs/id"}, "preset": {"$ref": "#/$defs/id"}}
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration", "subtitles"],
      "properties": {
        "narration": {"type": "string", "minLength": 1},
        "subtitles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_limit_seconds"],
      "properties": {"duration_limit_seconds": {"type": ["integer", "null"], "minimum": 1}}
    },
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "localized": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "narration", "subtitles"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "narration": {"$ref": "#/$defs/localized"},
        "subtitles": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "state", "title", "cues", "artifact_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"$ref": "#/$defs/id"},
        "state": {"enum": ["planned", "ready"]},
        "title": {"$ref": "#/$defs/localized"},
        "cues": {"type": "array", "items": {"$ref": "#/$defs/cue"}},
        "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
