{
  "schema": "xar-promo-install-contract-v1",
  "schema_version": 1,
  "package": {
    "distribution_name": "xar-promo-toolchain",
    "import_name": "xar_promo",
    "version": "0.1.0",
    "python_requires": ">=3.11",
    "build_backend": "setuptools.build_meta",
    "license": "GPL-3.0-only"
  },
  "compatibility": {
    "supported_os": [
      "windows",
      "linux",
      "macos"
    ],
    "core_wheel_tag": "py3-none-any",
    "core_architecture_independent": true,
    "target_specific_components": [
      "optional dependencies may resolve to wheels specific to the target OS, CPU architecture, and Python version",
      "ffmpeg and ffprobe executables must match the target OS and CPU architecture"
    ]
  },
  "entry_points": {
    "console": {
      "name": "xar-promo",
      "target": "xar_promo.cli:main"
    },
    "module": {
      "argv": [
        "python",
        "-m",
        "xar_promo"
      ]
    },
    "plugin_groups": {
      "adapters": "xar_promo.adapters",
      "presets": "xar_promo.presets"
    }
  },
  "requirements": {
    "core_python_dependencies": [],
    "build_dependencies": [
      "setuptools>=77"
    ],
    "external_executables": [
      {
        "name": "ffmpeg",
        "required_for": [
          "full human-review frame extraction",
          "project composers that render media with FFmpeg"
        ],
        "installed_by_pip": false
      },
      {
        "name": "ffprobe",
        "required_for": [
          "creating a byte-bound media probe before human review",
          "project composers that inspect media with ffprobe"
        ],
        "installed_by_pip": false
      }
    ]
  },
  "acquisition": {
    "public_index_published": false,
    "trusted_sources": [
      "a local wheel supplied through a trusted project channel",
      "a reviewed trusted source checkout"
    ],
    "preferred_install_source": "a trusted local wheel verified against an independently supplied SHA-256 value",
    "integrity": {
      "algorithm": "SHA-256",
      "expected_digest_provenance": "a trusted project manifest or SHA-256 sidecar delivered and authenticated independently of the wheel bytes",
      "expected_digest_must_be_external_to_artifact": true,
      "note": "a digest verifies transfer identity but does not make an untrusted source trusted"
    }
  },
  "extras": {
    "tts": {
      "requirements": [
        "edge-tts==7.2.8"
      ],
      "purpose": "live Microsoft Edge TTS synthesis; live synthesis may require network access"
    },
    "visual": {
      "requirements": [
        "Pillow==12.3.0"
      ],
      "purpose": "raster visual-source operations"
    },
    "render": {
      "requirements": [
        "Pillow==12.3.0"
      ],
      "purpose": "raster rendering and layout operations"
    }
  },
  "artifacts": {
    "wheel": {
      "filename": "xar_promo_toolchain-0.1.0-py3-none-any.whl",
      "installable": true
    },
    "sdist": {
      "filename": "xar_promo_toolchain-0.1.0.tar.gz",
      "installable": true
    },
    "source_tree": {
      "project_file": "pyproject.toml",
      "installable": true,
      "editable": true
    },
    "installed_resources": [
      "xar_promo/schemas/install-contract-v1.json",
      "xar_promo/schemas/promo-project-config-v1.schema.json",
      "xar_promo/schemas/promo-run-manifest-v1.schema.json",
      "xar_promo/schemas/phase2-capture-contract-v1.schema.json"
    ],
    "source_documentation": [
      "README.md",
      "docs/installation.md"
    ]
  },
  "verification": {
    "python_token": "python",
    "expected_subcommands": [
      "init",
      "start-run",
      "validate",
      "preserve",
      "signoff",
      "plan",
      "build",
      "audit",
      "review",
      "export"
    ],
    "commands": [
      {
        "id": "console-version",
        "argv": [
          "xar-promo",
          "--version"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "module-version",
        "argv": [
          "python",
          "-m",
          "xar_promo",
          "--version"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "installed-schema-resources",
        "argv": [
          "python",
          "-c",
          "from importlib.resources import files; root=files('xar_promo').joinpath('schemas'); names=('install-contract-v1.json','promo-project-config-v1.schema.json','promo-run-manifest-v1.schema.json','phase2-capture-contract-v1.schema.json'); missing=[name for name in names if not root.joinpath(name).is_file()]; raise SystemExit('missing installed resources: '+','.join(missing) if missing else 0)"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-init",
        "argv": [
          "xar-promo",
          "init",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-start-run",
        "argv": [
          "xar-promo",
          "start-run",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-validate",
        "argv": [
          "xar-promo",
          "validate",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-preserve",
        "argv": [
          "xar-promo",
          "preserve",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-signoff",
        "argv": [
          "xar-promo",
          "signoff",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-plan",
        "argv": [
          "xar-promo",
          "plan",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-build",
        "argv": [
          "xar-promo",
          "build",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-audit",
        "argv": [
          "xar-promo",
          "audit",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-review",
        "argv": [
          "xar-promo",
          "review",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      },
      {
        "id": "help-export",
        "argv": [
          "xar-promo",
          "export",
          "--help"
        ],
        "expected_exit_code": 0,
        "project_writes": false
      }
    ]
  },
  "side_effect_boundaries": {
    "installation": {
      "writes": [
        "the selected virtual environment or interpreter site-packages",
        "pip and build-tool caches"
      ],
      "network_by_default": "dependency resolution may contact configured indexes unless --no-index is used; version 0.1.0 itself is not published on a public Python index"
    },
    "verification": {
      "project_writes": false,
      "network": false,
      "media_processes": false,
      "note": "the interpreter may create normal bytecode cache files outside a promo project"
    },
    "read_only_runtime_modes": [
      "validate",
      "plan",
      "review --plan-only",
      "export --validate-only",
      "export --dry-run"
    ],
    "mutating_runtime_modes": [
      "init",
      "start-run",
      "preserve",
      "signoff",
      "build",
      "audit",
      "review without --plan-only",
      "export without --validate-only or --dry-run"
    ],
    "provider_and_process_boundary": "plan never invokes providers or media executables; build and full review may invoke only dependencies selected by the project composer or command arguments",
    "network_boundary": "the core has no publish or upload command; export is local and offline; a live edge-tts provider may use the network",
    "human_signoff_boundary": "audit and review cannot approve a deliverable; signoff records only an explicit named human decision bound to exact preserved artifact bytes",
    "retention_boundary": "preserve copies source bytes; build retains declared successful outputs and discoverable failure material instead of deleting an attempt"
  }
}
