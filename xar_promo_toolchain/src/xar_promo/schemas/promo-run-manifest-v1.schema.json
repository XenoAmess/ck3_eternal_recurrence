{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xar-promo:schema:run-manifest:v1",
  "title": "XAR Promo append-only RunManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "run", "project_config", "artifact_policy", "phase_history", "artifacts", "audits", "signoffs"],
  "properties": {
    "format_version": {"const": 1},
    "kind": {"const": "xar_promo_run_manifest"},
    "run": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}},
    "project_config": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1, "allOf": [{"pattern": "^(?!/)(?![A-Za-z]:).+$"}, {"not": {"pattern": "\\\\"}}, {"not": {"pattern": "(^|/)\\.\\.?(/|$)"}}]}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "artifact_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "raw_directory", "derived_directory", "manifest_history_directory", "preserve_process_material"],
      "properties": {
        "strategy": {"const": "append-only-content-addressed"},
        "raw_directory": {"type": "string", "minLength": 1},
        "derived_directory": {"type": "string", "minLength": 1},
        "manifest_history_directory": {"type": "string", "minLength": 1},
        "preserve_process_material": {"const": true}
      }
    },
    "phase_history": {"type": "array", "items": {"type": "object", "required": ["sequence"], "properties": {"sequence": {"type": "integer", "minimum": 1}}}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "audits": {"type": "array", "items": {"type": "object", "required": ["sequence"], "properties": {"sequence": {"type": "integer", "minimum": 1}}}},
    "signoffs": {"type": "array", "items": {"$ref": "#/$defs/signoff"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "collection", "role", "path", "label", "bytes", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "collection": {"enum": ["raw", "derived"]}, "role": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha"}, "media_type": {"type": "string", "minLength": 1}, "source_name": {"type": "string", "minLength": 1}
      }
    },
    "signoff": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "id", "artifact_id", "artifact_bytes", "artifact_sha256", "reviewer", "decision", "reviewed_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1}, "id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_bytes": {"type": "integer", "minimum": 0}, "artifact_sha256": {"$ref": "#/$defs/sha"},
        "reviewer": {"type": "string", "minLength": 1}, "decision": {"enum": ["approved", "rejected"]},
        "reviewed_at": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
