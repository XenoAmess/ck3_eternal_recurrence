types FinancialMarketSpotTicket {
    type xfm_market_spot_ticket = vbox {
        layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
        hbox = { spacing = 8 button_standard = { name = "xfm_market_lots_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_lots_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_lots_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_lots_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } text_single = { text = "xfm_market_ticket_lots" } button_standard = { name = "xfm_market_lots_up" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_market_lots_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_lots_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_lots_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
        hbox = { spacing = 8 button_standard = { name = "xfm_market_price_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_price_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_price_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_price_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } text_single = { text = "xfm_market_ticket_limit" } button_standard = { name = "xfm_market_price_up" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_market_price_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_price_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_price_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
        button_standard = { name = "xfm_market_ioc" size = { 390 34 } text = "xfm_market_ioc" enabled = "[GetScriptedGui( 'xfm_market_ioc_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_ioc_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_ioc_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        hbox = { spacing = 10 button_standard = { name = "xfm_market_buy" size = { 190 34 } text = "xfm_market_buy" enabled = "[GetScriptedGui( 'xfm_market_buy_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_buy_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_buy_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } button_standard = { name = "xfm_market_sell" size = { 190 34 } text = "xfm_market_sell" enabled = "[GetScriptedGui( 'xfm_market_sell_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_sell_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_sell_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
        text_multi = { text = "xfm_market_spot_terms_brief" tooltip = "xfm_market_spot_terms" max_width = 410 autoresize = yes default_format = "#weak" }
        text_label_left = { text = "xfm_market_book_title" }
        hbox = { size = { 400 150 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 8
            vbox = { size = { 192 150 } layoutpolicy_vertical = fixed spacing = 4
                text_single = { text = "xfm_market_bid" }
                vbox = { layoutpolicy_horizontal = expanding datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_bids' )]" item = { text_single = { text = "xfm_market_book_row" } } }
                expand = { layoutpolicy_vertical = growing }
            }
            vbox = { size = { 192 150 } layoutpolicy_vertical = fixed spacing = 4
                text_single = { text = "xfm_market_ask" }
                vbox = { layoutpolicy_horizontal = expanding datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_asks' )]" item = { text_single = { text = "xfm_market_book_row" } } }
                expand = { layoutpolicy_vertical = growing }
            }
        }
        text_multi = { visible = "[GetScriptedGui( 'xfm_market_receipt_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_market_last_receipt" max_width = 400 autoresize = yes }
        text_multi = { text = "xfm_market_settlement_notice" max_width = 400 autoresize = yes default_format = "#weak" }
        xfm_market_otc_panel = {}
        xfm_market_redemption_panel = {}
    }
}
