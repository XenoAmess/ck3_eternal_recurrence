types FinancialMarketIssuer {
    type xfm_market_issuer_content = vbox {
        layoutpolicy_horizontal = expanding spacing = 8
        text_label_left = { text = "xfm_market_issuer_title" }
        text_multi = { text = "xfm_market_issuance_terms" max_width = 730 autoresize = yes }
        button_standard = { name = "xfm_market_issuer_tier" size = { 720 34 } text = "xfm_market_issuer_tier" enabled = "[GetScriptedGui( 'xfm_market_issuer_tier_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_issuer_tier_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        button_standard = { name = "xfm_market_entity_type" size = { 720 34 } text = "xfm_market_entity_type" enabled = "[GetScriptedGui( 'xfm_market_entity_type_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_entity_type_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_entity_type_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        hbox = { spacing = 8
            button_standard = { name = "xfm_market_target_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_target_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_target_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_target_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
            text_single = { text = "xfm_market_funding_target" }
            button_standard = { name = "xfm_market_target_up" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_market_target_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_target_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_target_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        }
        text_multi = { text = "xfm_market_issuance_costs" max_width = 730 autoresize = yes }
        hbox = { spacing = 8 button_standard = { name = "xfm_market_issue_micro" size = { 355 34 } text = "xfm_market_register_micro" enabled = "[GetScriptedGui( 'xfm_market_issue_micro_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_issue_micro_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_issue_micro_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } button_standard = { name = "xfm_market_issue_standard" size = { 355 34 } text = "xfm_market_register_standard" enabled = "[GetScriptedGui( 'xfm_market_issue_standard_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_issue_standard_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_issue_standard_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
        divider = { layoutpolicy_horizontal = expanding }
        text_label_left = { text = "xfm_market_selected_issuer" }
        button_standard = { name = "xfm_market_charter" size = { 720 34 } text = "xfm_market_charter" enabled = "[GetScriptedGui( 'xfm_market_charter_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_charter_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        text_multi = { visible = "[GetScriptedGui( 'xfm_market_coin_selected_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_market_issuer_selected_details" max_width = 730 autoresize = yes }
        text_multi = { text = "xfm_market_issuer_controls_help" max_width = 730 autoresize = yes }
        hbox = { spacing = 8
            button_standard = { name = "xfm_market_subscription_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_subscription_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_subscription_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_subscription_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
