        hbox = { spacing = 8 button_standard = { name = "xfm_market_promote" size = { 355 34 } text = "xfm_market_promote" enabled = "[GetScriptedGui( 'xfm_market_promote_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_promote_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_promote_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } button_standard = { name = "xfm_market_topup" size = { 355 34 } text = "xfm_market_topup" enabled = "[GetScriptedGui( 'xfm_market_topup_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_topup_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_topup_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
