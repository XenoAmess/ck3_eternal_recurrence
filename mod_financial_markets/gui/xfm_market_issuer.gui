    }
    type xfm_market_issuer_panel = vbox {
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        scrollbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            blockoverride "scrollbox_content" { xfm_market_issuer_content = {} }
        }
    }
}
