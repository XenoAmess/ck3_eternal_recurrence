        button_standard = { name = "xfm_market_announce_delisting" size = { 720 34 } text = "xfm_market_delist" enabled = "[GetScriptedGui( 'xfm_market_announce_delisting_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_announce_delisting_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_announce_delisting_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        hbox = { spacing = 8 button_standard = { name = "xfm_market_concealed_mint" size = { 355 34 } text = "xfm_market_concealed_mint" enabled = "[GetScriptedGui( 'xfm_market_concealed_mint_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_concealed_mint_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } button_standard = { name = "xfm_market_withdraw_liquidity" size = { 355 34 } text = "xfm_market_withdraw_liquidity" enabled = "[GetScriptedGui( 'xfm_market_withdraw_liquidity_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_withdraw_liquidity_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
