                    vbox = { visible = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' )]" size = { 100% 100% } spacing = 8 text_multi = { text = "xfm_market_orders_help" max_width = 720 autoresize = yes }scrollbox = { name = "xfm_market_orders_scroll" layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_orders_page' )]" item = { vbox = {

