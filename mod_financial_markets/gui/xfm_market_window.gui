window = {
    name = "xfm_market_window"
    parentanchor = center
    size = { 1320 920 }
    layer = middle
    movable = yes
    visible = "[And( GetPlayer.IsValid, GetScriptedGui( 'xfm_market_window_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
    using = Window_Background
    using = Window_Decoration
    state = { name = _show using = Animation_FadeIn_Quick on_start = "[GetVariableSystem.Set( 'xfm_market_tab', 'market' )]" on_start = "[GetVariableSystem.Set( 'xfm_market_ticket', 'spot' )]" }
    state = { name = _hide using = Animation_FadeOut_Quick }
    # A bounded root box assigns actual child rectangles. Keep rows in flow;
    # a layout box is not an absolutely positioned widget slot.
    vbox = {
        name = "xfm_market_content"
        size = { 100% 100% }
        margin_left = 24 margin_right = 24 margin_top = 14 margin_bottom = 28
        layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
        spacing = 10
        header_pattern = {
            layoutpolicy_horizontal = expanding
            size = { 1272 52 }
            blockoverride "header_text" { text = "xfm_market_title" }
            blockoverride "button_close" { onclick = "[GetScriptedGui( 'xfm_market_close_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        }
        hbox = { name = "xfm_market_tabs" layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed size = { 1272 42 }
            button_tab = { name = "xfm_tab_market" size = { 212 42 } down = "[Not( Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'debts' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'issuer' ), GetVariableSystem.HasValue( 'xfm_market_tab', 'news' ) ) ) ) ) )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'market' )]" blockoverride "tab_label" { text = "xfm_market_tab_market" } }
            button_tab = { name = "xfm_tab_positions" size = { 212 42 } down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'positions' )]" blockoverride "tab_label" { text = "xfm_market_tab_positions" } }
            button_tab = { name = "xfm_tab_orders" size = { 212 42 } down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'orders' )]" blockoverride "tab_label" { text = "xfm_market_tab_orders" } }
            button_tab = { name = "xfm_tab_debts" size = { 212 42 } down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'debts' )]" enabled = "[GetScriptedGui( 'xfm_market_debts_tab_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_debts_tab_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'debts' )]" blockoverride "tab_label" { text = "xfm_market_tab_debts" } }
            button_tab = { name = "xfm_tab_issuer" size = { 212 42 } down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'issuer' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'issuer' )]" blockoverride "tab_label" { text = "xfm_market_tab_issuer" } }
            button_tab = { name = "xfm_tab_news" size = { 212 42 } down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'news' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'news' )]" blockoverride "tab_label" { text = "xfm_market_tab_news" } }
        }
        hbox = { name = "xfm_market_body" size = { 1272 100 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding spacing = 10
            vbox = { name = "xfm_market_browser" size = { 790 100% } layoutpolicy_vertical = expanding spacing = 8
              vbox = { name = "xfm_market_wallet" size = { 790 116 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 6
                text_multi = { text = "xfm_market_wallet_summary" max_width = 780 autoresize = yes }
                hbox = { size = { 790 34 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 6
                    button_standard = { name = "xfm_market_cash_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_cash_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_cash_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_cash_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    text_single = { text = "xfm_market_cash_amount" }
                    button_standard = { name = "xfm_market_cash_up" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_market_cash_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_cash_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_cash_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_deposit" size = { 115 34 } text = "xfm_market_deposit" enabled = "[GetScriptedGui( 'xfm_market_deposit_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_deposit_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_deposit_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_withdraw" size = { 115 34 } text = "xfm_market_withdraw" enabled = "[GetScriptedGui( 'xfm_market_withdraw_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_withdraw_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_withdraw_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_step" size = { 130 34 } text = "xfm_market_step" enabled = "[GetScriptedGui( 'xfm_market_step_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_step_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_step_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_fund_donate" size = { 130 34 } text = "xfm_market_fund_donate" enabled = "[GetScriptedGui( 'xfm_market_fund_donate_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_fund_donate_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                }
                scrollbox = { name = "xfm_market_accounts" size = { 790 44 } blockoverride "scrollbox_margins" { margin_top = 4 margin_bottom = 4 margin_left = 8 margin_right = 16 } blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_accounts' )]" item = { xfm_market_account_row = {} } } } }
              }
                hbox = { name = "xfm_market_indexes" size = { 790 34 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 8 button_standard = { name = "xfm_market_index_grain" size = { 258 34 } text = "xfm_market_index_grain" enabled = "[GetScriptedGui( 'xfm_market_index_grain_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_index_grain_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_ticket', 'futures' )]" } button_standard = { name = "xfm_market_index_military" size = { 258 34 } text = "xfm_market_index_military" enabled = "[GetScriptedGui( 'xfm_market_index_military_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_index_military_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_ticket', 'futures' )]" } button_standard = { name = "xfm_market_index_trade" size = { 258 34 } text = "xfm_market_index_trade" enabled = "[GetScriptedGui( 'xfm_market_index_trade_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_index_trade_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_ticket', 'futures' )]" } }
                widget = { name = "xfm_market_pages" parentanchor = top|left size = { 790 100 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
                    vbox = { name = "xfm_market_page_market" visible = "[Not( Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'debts' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'issuer' ), GetVariableSystem.HasValue( 'xfm_market_tab', 'news' ) ) ) ) ) )]" parentanchor = top|left size = { 100% 100% } layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding spacing = 8 ignoreinvisible = yes
                        hbox = { name = "xfm_market_filters" size = { 790 34 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 6
                            button_standard = { name = "xfm_market_sort" size = { 175 34 } text = "xfm_market_sort" enabled = "[GetScriptedGui( 'xfm_market_sort_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_sort_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_sort_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            button_standard = { name = "xfm_market_type_filter" size = { 175 34 } text = "xfm_market_type_filter" enabled = "[GetScriptedGui( 'xfm_market_type_filter_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_type_filter_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_type_filter_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            button_standard = { name = "xfm_market_holdings_filter" size = { 150 34 } text = "xfm_market_holdings_filter" enabled = "[GetScriptedGui( 'xfm_market_holdings_filter_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_holdings_filter_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_holdings_filter_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
