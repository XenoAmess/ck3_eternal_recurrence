                            button_standard = { name = "xfm_market_previous" size = { 145 34 } text = "xfm_market_previous" enabled = "[GetScriptedGui( 'xfm_market_previous_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "xfm_market_previous_page_tooltip" onclick = "[GetScriptedGui( 'xfm_market_previous_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
