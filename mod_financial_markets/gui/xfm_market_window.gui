window = {
    name = "xfm_market_window"
    parentanchor = center
    size = { 1280 920 }
    layer = middle
    movable = yes
    visible = "[And( GetPlayer.IsValid, GetScriptedGui( 'xfm_market_window_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
    using = Window_Background
    using = Window_Decoration
    state = { name = _show using = Animation_FadeIn_Quick on_start = "[GetVariableSystem.Set( 'xfm_market_tab', 'market' )]" on_start = "[GetVariableSystem.Set( 'xfm_market_ticket', 'spot' )]" }
    state = { name = _hide using = Animation_FadeOut_Quick }
    vbox = {
        using = Window_Margins spacing = 10
        header_pattern = {
            layoutpolicy_horizontal = expanding
            blockoverride "header_text" { text = "xfm_market_title" }
            blockoverride "button_close" { onclick = "[GetScriptedGui( 'xfm_market_close_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        }
        hbox = { spacing = 6 layoutpolicy_horizontal = expanding
            button_tab = { name = "xfm_tab_market" down = "[Not( Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'debts' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'issuer' ), GetVariableSystem.HasValue( 'xfm_market_tab', 'news' ) ) ) ) ) )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'market' )]" blockoverride "tab_label" { text = "xfm_market_tab_market" } }
            button_tab = { name = "xfm_tab_positions" down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'positions' )]" blockoverride "tab_label" { text = "xfm_market_tab_positions" } }
            button_tab = { name = "xfm_tab_orders" down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'orders' )]" blockoverride "tab_label" { text = "xfm_market_tab_orders" } }
            button_tab = { name = "xfm_tab_debts" down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'debts' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'debts' )]" blockoverride "tab_label" { text = "xfm_market_tab_debts" } }
            button_tab = { name = "xfm_tab_issuer" down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'issuer' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'issuer' )]" blockoverride "tab_label" { text = "xfm_market_tab_issuer" } }
            button_tab = { name = "xfm_tab_news" down = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'news' )]" onclick = "[GetVariableSystem.Set( 'xfm_market_tab', 'news' )]" blockoverride "tab_label" { text = "xfm_market_tab_news" } }
        }
        hbox = { spacing = 12 layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
            vbox = { size = { 760 100% } spacing = 8
                text_multi = { text = "xfm_market_wallet_summary" max_width = 745 autoresize = yes }
                hbox = { spacing = 6
                    button_standard = { name = "xfm_market_cash_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_cash_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_cash_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_cash_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    text_single = { text = "xfm_market_cash_amount" }
                    button_standard = { name = "xfm_market_cash_up" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_market_cash_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_cash_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_cash_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_deposit" size = { 115 34 } text = "xfm_market_deposit" enabled = "[GetScriptedGui( 'xfm_market_deposit_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_deposit_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_deposit_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_withdraw" size = { 115 34 } text = "xfm_market_withdraw" enabled = "[GetScriptedGui( 'xfm_market_withdraw_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_withdraw_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_withdraw_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_step" size = { 130 34 } text = "xfm_market_step" enabled = "[GetScriptedGui( 'xfm_market_step_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_step_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_step_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                    button_standard = { name = "xfm_market_fund_donate" size = { 130 34 } text = "xfm_market_fund_donate" enabled = "[GetScriptedGui( 'xfm_market_fund_donate_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_fund_donate_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                }
                scrollbox = { name = "xfm_market_accounts" layoutpolicy_horizontal = expanding size = { 750 45 } blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_accounts' )]" item = { xfm_market_account_row = {} } } } }
                hbox = { spacing = 6 button_standard = { name = "xfm_market_index_grain" size = { 235 32 } text = "xfm_market_index_grain" enabled = "[GetScriptedGui( 'xfm_market_index_grain_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_index_grain_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_ticket', 'futures' )]" } button_standard = { name = "xfm_market_index_military" size = { 235 32 } text = "xfm_market_index_military" enabled = "[GetScriptedGui( 'xfm_market_index_military_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_index_military_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_ticket', 'futures' )]" } button_standard = { name = "xfm_market_index_trade" size = { 235 32 } text = "xfm_market_index_trade" enabled = "[GetScriptedGui( 'xfm_market_index_trade_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_index_trade_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetVariableSystem.Set( 'xfm_market_ticket', 'futures' )]" } }
                widget = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
                    vbox = { visible = "[Not( Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'orders' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'debts' ), Or( GetVariableSystem.HasValue( 'xfm_market_tab', 'issuer' ), GetVariableSystem.HasValue( 'xfm_market_tab', 'news' ) ) ) ) ) )]" size = { 100% 100% } spacing = 8
                        hbox = { spacing = 6
                            button_standard = { name = "xfm_market_sort" size = { 175 34 } text = "xfm_market_sort" enabled = "[GetScriptedGui( 'xfm_market_sort_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_sort_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_sort_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            button_standard = { name = "xfm_market_type_filter" size = { 175 34 } text = "xfm_market_type_filter" enabled = "[GetScriptedGui( 'xfm_market_type_filter_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_type_filter_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_type_filter_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            button_standard = { name = "xfm_market_holdings_filter" size = { 150 34 } text = "xfm_market_holdings_filter" enabled = "[GetScriptedGui( 'xfm_market_holdings_filter_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_holdings_filter_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_holdings_filter_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            button_standard = { name = "xfm_market_clear_filters" size = { 135 34 } text = "xfm_market_clear_filters" enabled = "[GetScriptedGui( 'xfm_market_clear_filters_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_clear_filters_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_clear_filters_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                        }
                        hbox = { spacing = 6
                            text_single = { text = "xfm_market_coin_id_label" }
                            button_standard = { name = "xfm_market_id_down" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_market_id_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_id_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_id_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            text_single = { text = "[GetPlayer.MakeScope.Var( 'xfm_ui_id_filter' ).GetValue|0]" }
                            button_standard = { name = "xfm_market_id_up" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_market_id_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_id_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_id_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            expand = {}
                            button_standard = { name = "xfm_market_refresh" size = { 130 34 } text = "xfm_market_refresh" enabled = "[GetScriptedGui( 'xfm_market_refresh_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_refresh_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_refresh_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                        }
                        text_multi = { visible = "[GetScriptedGui( 'xfm_market_issuer_filter_active_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_market_issuer_filter_active" max_width = 720 autoresize = yes }
                        text_multi = { text = "xfm_market_columns" max_width = 720 autoresize = yes }
                        scrollbox = { name = "xfm_market_coin_scroll" layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_coin_page' )]" item = { xfm_market_coin_row = {} } } } }
                        text_multi = { visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'xfm_ui_coin_page' ) )]" text = "xfm_market_no_matching_coins" max_width = 730 autoresize = yes }
                        hbox = { spacing = 10
                            button_standard = { name = "xfm_market_previous" size = { 145 34 } text = "xfm_market_previous" enabled = "[GetScriptedGui( 'xfm_market_previous_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_previous_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_previous_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                            expand = {} text_single = { text = "xfm_market_page" } expand = {}
                            button_standard = { name = "xfm_market_next" size = { 145 34 } text = "xfm_market_next" enabled = "[GetScriptedGui( 'xfm_market_next_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_next_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_next_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
                        }
                     }
                    vbox = { visible = "[GetVariableSystem.HasValue( 'xfm_market_tab', 'positions' )]" size = { 100% 100% } spacing = 8 text_multi = { text = "xfm_market_positions_help" max_width = 720 autoresize = yes }scrollbox = { name = "xfm_market_positions_scroll" layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_positions_page' )]" item = { xfm_market_position_row = {} } } } } hbox = { spacing = 8
