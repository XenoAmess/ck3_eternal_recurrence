types FinancialMarketNews {
    type xfm_market_news_panel = vbox {
        layoutpolicy_horizontal = expanding spacing = 8
        text_multi = { text = "xfm_market_news_help" max_width = 730 autoresize = yes }
        hbox = { spacing = 8 button_standard = { name = "xfm_market_news_latest" size = { 175 34 } text = "xfm_market_news_latest" enabled = "[GetScriptedGui( 'xfm_market_news_latest_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_news_latest_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } button_standard = { name = "xfm_market_news_newer" size = { 175 34 } text = "xfm_market_news_newer" enabled = "[GetScriptedGui( 'xfm_market_news_newer_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_news_newer_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } button_standard = { name = "xfm_market_news_older" size = { 175 34 } text = "xfm_market_news_older" enabled = "[GetScriptedGui( 'xfm_market_news_older_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_news_older_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
        scrollbox = { name = "xfm_market_news_scroll" size = { 735 330 } blockoverride "scrollbox_content" {
            vbox = { layoutpolicy_horizontal = expanding spacing = 5 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_news' )]" item = { xfm_market_news_row = {} } }
        } }
        text_multi = { visible = "[GetScriptedGui( 'xfm_market_news_selected_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_market_selected_news" max_width = 730 autoresize = yes }
        text_multi = { visible = "[And( GetScriptedGui( 'xfm_market_news_selected_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('xfm_selected_news').Var('xfm_news_kind').GetValue, '(CFixedPoint)5' ) )]" text = "[Localize( Concatenate( 'xfm_crisis_scene_', Concatenate( IntToString( FixedPointToInt( GetPlayer.MakeScope.Var('xfm_selected_news').Var('xfm_news_scene').GetValue ) ), '_title' ) ) )]" max_width = 730 autoresize = yes }
        text_single = { visible = "[GetScriptedGui( 'xfm_market_news_selected_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_market_news_full_report" tooltip = "[GetScriptedGui( 'xfm_market_news_report_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'xfm_news_actor', GetPlayer.MakeScope.Var('xfm_selected_news').Var('xfm_news_actor').Char.MakeScope ).End )]" }
        button_standard = { name = "xfm_market_news_aid" size = { 720 34 } text = "xfm_market_news_aid" enabled = "[GetScriptedGui( 'xfm_market_news_aid_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_market_news_aid_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_market_news_aid_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
        scrollbox = { name = "xfm_market_aid_scroll" size = { 735 100 } blockoverride "scrollbox_content" {
            vbox = { layoutpolicy_horizontal = expanding spacing = 5 datamodel = "[GetPlayer.MakeScope.GetList( 'xfm_ui_aid_debts' )]" item = { xfm_market_debt_row = {} } }
        } }
        text_multi = { text = "xfm_market_aid_help" max_width = 730 autoresize = yes }
    }
    type xfm_market_news_row = button_standard_list {
        name = "xfm_market_news_row"
        size = { 725 55 }
        text = "xfm_market_news_row_text"
        enabled = "[GetScriptedGui( 'xfm_market_select_news_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'xfm_ui_item', Scope.Self ).End )]"
        onclick = "[GetScriptedGui( 'xfm_market_select_news_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'xfm_ui_item', Scope.Self ).End )]"
    }
}
