types FinancialMarketHistory {
    type xfm_market_history_panel = vbox {
        layoutpolicy_horizontal = expanding spacing = 6
        text_multi = { text = "xfm_market_history_header" max_width = 400 autoresize = yes }
        scrollbox = { name = "xfm_market_daily_history" size = { 400 420 } blockoverride "scrollbox_content" {
            vbox = { layoutpolicy_horizontal = expanding spacing = 6
