types FinancialMarketRedemption {
 type xfm_market_redemption_panel = vbox {
  visible = "[GetScriptedGui( 'xfm_redemption_coin_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
  layoutpolicy_horizontal = expanding spacing = 6
  divider = { layoutpolicy_horizontal = expanding }
  text_label_left = { text = "xfm_redemption_panel_title" }
  text_multi = { text = "xfm_redemption_disclosure" max_width = 390 autoresize = yes }
  button_standard = { name = "xfm_redemption_initialize_gui_button" size = { 390 34 } text = "xfm_redemption_initialize" enabled = "[GetScriptedGui( 'xfm_redemption_initialize_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_initialize_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_initialize_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
  vbox = {
   visible = "[GetScriptedGui( 'xfm_redemption_window_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" spacing = 4
   text_multi = { text = "xfm_redemption_live_terms" max_width = 390 autoresize = yes }
   text_multi = { visible = "[GetScriptedGui( 'xfm_redemption_sold_out_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_redemption_sold_out" max_width = 390 autoresize = yes }
   text_multi = { visible = "[GetScriptedGui( 'xfm_redemption_expired_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_redemption_expired" max_width = 390 autoresize = yes }
   hbox = { spacing = 8 button_standard = { name = "xfm_redemption_lots_down_gui_button" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_redemption_lots_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_lots_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_lots_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } text_single = { text = "xfm_redemption_lots" } button_standard = { name = "xfm_redemption_lots_up_gui_button" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_redemption_lots_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_lots_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_lots_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
   button_standard = { name = "xfm_redemption_redeem_gui_button" size = { 390 34 } text = "xfm_redemption_redeem" enabled = "[GetScriptedGui( 'xfm_redemption_redeem_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_redeem_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_redeem_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
  }
  vbox = {
   visible = "[GetScriptedGui( 'xfm_redemption_controller_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" spacing = 4
   text_label_left = { text = "xfm_redemption_controller_title" }
   text_multi = { text = "xfm_redemption_controller_terms" max_width = 390 autoresize = yes }
   hbox = { spacing = 8 button_standard = { name = "xfm_redemption_price_down_gui_button" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_redemption_price_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_price_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_price_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } text_single = { text = "xfm_redemption_input_price" } button_standard = { name = "xfm_redemption_price_up_gui_button" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_redemption_price_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_price_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_price_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
   hbox = { spacing = 8 button_standard = { name = "xfm_redemption_budget_down_gui_button" size = { 40 34 } text = "xfm_market_minus" enabled = "[GetScriptedGui( 'xfm_redemption_budget_down_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_budget_down_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_budget_down_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } text_single = { text = "xfm_redemption_input_budget" } button_standard = { name = "xfm_redemption_budget_up_gui_button" size = { 40 34 } text = "xfm_market_plus" enabled = "[GetScriptedGui( 'xfm_redemption_budget_up_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_budget_up_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_budget_up_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
   button_standard = { name = "xfm_redemption_duration_gui_button" size = { 390 34 } text = "xfm_redemption_input_duration" enabled = "[GetScriptedGui( 'xfm_redemption_duration_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_duration_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_duration_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
   button_standard = { name = "xfm_redemption_publish_gui_button" size = { 390 34 } text = "xfm_redemption_publish" enabled = "[GetScriptedGui( 'xfm_redemption_publish_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_publish_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_publish_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
   button_standard = { name = "xfm_redemption_reclaim_gui_button" size = { 390 34 } text = "xfm_redemption_reclaim" enabled = "[GetScriptedGui( 'xfm_redemption_reclaim_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" tooltip = "[GetScriptedGui( 'xfm_redemption_reclaim_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'xfm_redemption_reclaim_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
  }
  text_multi = { visible = "[GetScriptedGui( 'xfm_redemption_action_result_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_redemption_action_result" max_width = 390 autoresize = yes }
  text_multi = { visible = "[GetScriptedGui( 'xfm_redemption_receipt_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text = "xfm_redemption_last_receipt" max_width = 390 autoresize = yes }
 }
}
