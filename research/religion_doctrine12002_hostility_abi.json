      "start_line": 170,
      "end_line": 194,
      "window": "\t\t# hostility override map depending on the relation between the other faith and this one.\n\t\t# See the \"hostility\" section for more info\n\t\t#\n\t\thostility_levels = {\n\n\t\t\t# same_religion: How hostile is this faith towards other faiths of the same religion?\n\t\t\tsame_religion = astray\n\n\t\t\t# How hostile is this faith towards other faiths of the same religion family, but not same religion?\n\t\t\tsame_family = hostile\n\n\t\t\t# How hostile is this faith towards faiths from different religion families?\n\t\t\tunrelated = evil\n\t\t}\n\n\t\t# hostility override map depending on whether the target faith has the given doctrine\n\t\t#\n\t\thostility_level_override = {\n\t\t\tdoctrine_key = astray\n\t\t}\n\n\t\t# How hostile is this faith towards faith who they share Head of Faith with? Takes precedence over other hostility overrides.\n\t\t# has no default\n\t\t#\n\t\tsame_hof_hostility_override = righteous"
    },
    {
      "path": "common/religion/doctrine_types/_doctrine_types.info",
      "sha256": "7a8f6f8e78f88f7c83de3c43239a5da2709777e9d56fed4ae031e98b76af2ffc",
      "start_line": 260,
      "end_line": 275,
      "window": "# All rites have a hostility level towards one another. What each level means is entirely scriptable.\n# The levels are, in increasing order of hostility:\n#\t* righteous (0)\n#\t* astray\t(1)\n#\t* hostile\t(2)\n#\t* evil\t\t(3)\n#\n# A rite always has a 'righteous' hostility level towards itself.\n# If no override is defined the target rite will be considered to be righteous\n#\n# The opinion effect of hostility is defined by the define HOSTILITY_OPINION_EFFECTS.\n# The multiplier applied to tolerance_advantage_mod is defined by the define HOSTILITY_COMBAT_MOD_MULT.\n# The name of each hostility level is defined by the define HOSTILITY_LEVEL_NAMES\n#\n# Hostility level can be accessed in script. E.G., faith_hostility_level = { target = scope:some_faith value >= 1 } or rite_hostility_level = { target = scope:some_rite value >= 1 }.\n# You can also compare to see which faith you're most hostile to. E.G., faith_hostility_level_comparison = { scope:some_faith > scope:some_other_faith }"
    },
    {
      "path": "common/defines/00_defines.txt",
      "sha256": "8e430d77eb6e8767030f34b1c53d5dae84277fb354bd73cc42f93dc500be8982",
      "start_line": 834,
      "end_line": 834,
      "window": "\tRITE_DIVERGENCE_HOSTILITY_THRESHOLD = 1 # Divergence below that will lower faith hostility by 1 level"
    },
    {
      "path": "common/defines/00_defines.txt",
      "sha256": "8e430d77eb6e8767030f34b1c53d5dae84277fb354bd73cc42f93dc500be8982",
      "start_line": 870,
      "end_line": 875,
      "window": "\tHOSTILITY_LEVEL_NAMES = {\t# Localization for each hostility level. See _doctrine_types.info for more info\n\t\t\"FAITH_HOSTILITY_RIGHTEOUS\"\n\t\t\"FAITH_HOSTILITY_ASTRAY\"\n\t\t\"FAITH_HOSTILITY_HOSTILE\"\n\t\t\"FAITH_HOSTILITY_EVIL\"\n\t}"
    },
    {
      "path": "common/scripted_modifiers/00_marriage_scripted_modifiers.txt",
      "sha256": "329c570ae4fdd9cd8e898ffd32ea9b30c689446eb7874b0ce2cdf12fe842d630",
      "start_line": 1127,
      "end_line": 1265,
      "window": "marriage_ai_accept_faith_hostility_modifier = {\n\t#########\n\t# FAITH #\n\t#########\n\tmodifier = { # A recipient will be reluctant (to differing degrees) to agree to marriages sent from an puppet_or_actor of a different faith\n\t\t#Same faith is always fully accepted, so we can skip the hostility level check below\n\t\tscope:recipient.faith != scope:puppet_or_actor.faith\n\t\t# Nomads care little of Faith within the Steppe, and Tributaries are willing to marry them, too.\n\t\ttrigger_if = {\n\t\t\tlimit = {\n\t\t\t\tscope:puppet_or_actor = {\n\t\t\t\t\tgovernment_has_flag = government_is_in_steppe\n\t\t\t\t}\n\t\t\t}\n\t\t\tscope:recipient = {\n\t\t\t\tNOR = {\n\t\t\t\t\tgovernment_has_flag = government_is_in_steppe\n\t\t\t\t\tis_tributary_of = scope:puppet_or_actor\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\ttrigger_if = {\n\t\t\tlimit = {\n\t\t\t\tscope:recipient = {\n\t\t\t\t\tgovernment_has_flag = government_is_in_steppe\n\t\t\t\t}\n\t\t\t}\n\t\t\tscope:puppet_or_actor = {\n\t\t\t\tNOR = {\n\t\t\t\t\tgovernment_has_flag = government_is_in_steppe\n\t\t\t\t\tis_tributary_of = scope:recipient\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tscope:recipient.rite = {\n\t\t\trite_hostility_level = {\n\t\t\t\ttarget = scope:puppet_or_actor.rite\n\t\t\t\tvalue > faith_fully_accepted_level\n\t\t\t}\n\t\t}\n\t\tadd = {\n\t\t\tvalue = -10\n\t\t\tif = {\n\t\t\t\tlimit = {\n\t\t\t\t\tNOR = {\n\t\t\t\t\t\t# Exempt certain struggle phases.\n\t\t\t\t\t\tis_struggle_parameter_active_interfaith_marriages_available_between_involved_characters_trigger = yes\n\t\t\t\t\t\t# Exempt Conciliation struggle resolution\n\t\t\t\t\t\tAND = {\n\t\t\t\t\t\t\thas_global_variable = fp2_struggle_conciliation_ending\n\t\t\t\t\t\t\tfp2_struggle_conciliation_special_cultural_rules_trigger = { C1 = scope:recipient C2 = scope:puppet_or_actor }\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif = {\n\t\t\t\t\tlimit = {\n\t\t\t\t\t\tscope:recipient.rite = {\n\t\t\t\t\t\t\trite_hostility_level = {\n\t\t\t\t\t\t\t\ttarget = scope:puppet_or_actor.rite\n\t\t\t\t\t\t\t\tvalue > faith_astray_level\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tsubtract = 15\n\t\t\t\t}\n\t\t\t\tif = {\n\t\t\t\t\tlimit = {\n\t\t\t\t\t\tscope:recipient.rite = {\n\t\t\t\t\t\t\trite_hostility_level = {\n\t\t\t\t\t\t\t\ttarget = scope:puppet_or_actor.rite\n\t\t\t\t\t\t\t\tvalue >= faith_hostility_prevents_marriage_level\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tsubtract = 975\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tdesc = MARRY_DIFFERENT_FAITH_REASON\n\t}\n\t#Divergence\n\tfirst_valid = {\n\t\tmodifier = {\n\t\t\tadd = -50\n\t\t\tscope:recipient.faith = scope:puppet_or_actor.faith\n\t\t\tscope:puppet_or_actor.rite != scope:recipient.rite\n\t\t\tscope:recipient.rite = {\n\t\t\t\t\"divergence(scope:puppet_or_actor.rite)\" >= monumental_rite_divergence_value\n\t\t\t}\n\t\t\tdesc = marriage_monumental_divergence_reason\n\t\t}\n\t\tmodifier = {\n\t\t\tadd = -30\n\t\t\tscope:recipient.faith = scope:puppet_or_actor.faith\n\t\t\tscope:puppet_or_actor.rite != scope:recipient.rite\n\t\t\tscope:recipient.rite = {\n\t\t\t\t\"divergence(scope:puppet_or_actor.rite)\" >= massive_rite_divergence_value\n\t\t\t}\n\t\t\tdesc = marriage_massive_divergence_reason\n\t\t}\n\t\tmodifier = {\n\t\t\tadd = -20\n\t\t\tscope:recipient.faith = scope:puppet_or_actor.faith\n\t\t\tscope:puppet_or_actor.rite != scope:recipient.rite\n\t\t\tscope:recipient.rite = {\n\t\t\t\t\"divergence(scope:puppet_or_actor.rite)\" >= major_rite_divergence_value\n\t\t\t}\n\t\t\tdesc = marriage_major_divergence_reason\n\t\t}\n\t\tmodifier = {\n\t\t\tadd = -10\n\t\t\tscope:recipient.faith = scope:puppet_or_actor.faith\n\t\t\tscope:puppet_or_actor.rite != scope:recipient.rite\n\t\t\tscope:recipient.rite = {\n\t\t\t\t\"divergence(scope:puppet_or_actor.rite)\" >= medium_rite_divergence_value\n\t\t\t}\n\t\t\tdesc = marriage_medium_divergence_reason\n\t\t}\n\t\tmodifier = {\n\t\t\tadd = -5\n\t\t\tscope:recipient.faith = scope:puppet_or_actor.faith\n\t\t\tscope:puppet_or_actor.rite != scope:recipient.rite\n\t\t\tscope:recipient.rite = {\n\t\t\t\t\"divergence(scope:puppet_or_actor.rite)\" >= minor_rite_divergence_value\n\t\t\t}\n\t\t\tdesc = marriage_minor_divergence_reason\n\t\t}\n\t}\n}\n\nmarriage_ai_accept_fertility_modifier = {\n\tmodifier = { # A debuff for no fertility to same-sex marriage\n\t\tadd = -200\n\t\tdesc = SAME_SEX_MARRIAGE_FERTILITY_REASON\n\n\t\tscope:secondary_recipient = {\n\t\t\tallowed_to_marry_same_sex_trigger = yes"
    }
