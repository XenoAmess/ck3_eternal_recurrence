      "text": "\ttype vbox_doctrine_picker_item = vbox {\n\t\tlayoutpolicy_horizontal = expanding\n\n\t\tbutton_standard_hover = {\n\t\t\tname = \"faith_list_item\"\n\t\t\tdatacontext = \"[DoctrineItem.GetDoctrine]\"\n\t\t\tdatacontext = \"[DoctrineType.GetGroup.GetCategory]\"\n\t\t\tdatacontext = \"[DoctrineItem.GetFaith]\"\n\t\t\tdatacontext = \"[DoctrineItem.GetRite]\"\n\t\t\tdatacontext = \"[GetVariableSystem]\"\n\t\t\tvisible = \"[DoctrineItem.ShouldDisplay( TopScope.Self )]\"\n\t\t\tsize = { 430 80 }\n\n\t\t\tlayoutpolicy_horizontal = expanding\n\n\t\t\tenabled = \"[And( DoctrineItem.CanPick( TopScope.Self ), GetScriptedGui( 'pam_know_doctrine' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'doctrine', DoctrineType.MakeScope ).End ) )]\"\n\n\t\t\tonclick = \"[RiteCreationWindow.SelectDoctrine( DoctrineItem.Self )]\"\n\t\t\tonclick = \"[VariableSystem.Clear( 'faith_creation_right_view' )]\"\n\t\t\tdown = \"[RiteCreationWindow.HasDoctrineSelected( DoctrineType.Self )]\""
    },
