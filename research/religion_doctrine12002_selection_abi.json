      "text": "\t\t\t{\n\t\t\t\tvbox = {\n\t\t\t\t\tdatacontext = \"[RiteCreationWindow.GetDoctrineCategoryWindow]\"\n\t\t\t\t\tdatacontext = \"[RiteCreationWindow.GetFaithScope]\"\n\n\t\t\t\t\tlayoutpolicy_horizontal = expanding\n\n\t\t\t\t\tdatamodel = \"[DoctrineCategoryWindow.GetDoctrineItems]\"\n\t\t\t\t\titem = {\n\t\t\t\t\t\tvbox_doctrine_picker_item = {}\n\t\t\t\t\t}\n\t\t\t\t}"
