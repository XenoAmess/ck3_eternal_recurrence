    GREEN["GREEN<br/>冻结 artifact · report · media · hashes"] GCLEAN["受控回收<br/>停止进程 · 恢复现场 · 释放锁"] RCLEAN["受控回收<br/>停止进程 · 恢复现场 · 释放锁"] RED["RED<br/>区分 product / capability / harness / environment"]
    GATE["发布候选<br/>fresh-cache / Workshop 回读 / claim 审计"] space space NEXT["↺ 最小下一施工入口<br/>修订合同、工具或能力后再验"]

    I --> G --> L0 --> OKQ
    OKQ -- "支持" --> OK --> BLD
    OKQ -- "不支持" --> NA --> BLD
    OK -.-> NOTE
    BLD --> ISO --> RUN --> CK --> MCP --> OODA --> POST --> CLS
    CLS -- "一致" --> GREEN --> GCLEAN --> GATE
    CLS -- "不一致 / 超时 / 环境故障" --> RED --> RCLEAN --> NEXT

