    "sources": [
      {
        "id": "launch",
        "title": "Now Available: Silk & Silver and 1.21 Florin Free Update",
        "published_at_utc": "2026-11-17T17:09:01Z",
        "steam_news_gid": "1849458702694555",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/746069122013463406",
        "summary": "Release confirms the free economic overhaul, trade goods, building needs, roads and new building system. Paid expansion introduces playable Merchant and Republic governments, merchant specializations, monopolies and republican politics.",
        "limits": "Feature announcement, not the full release changelog or API reference."
      },
      {
        "id": "dd1",
        "title": "Silk & Silver Dev Diary #1 - The Vision of Silk & Silver",
        "published_at_utc": "2026-04-21T11:58:32Z",
        "steam_news_gid": "1830163047268303",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/552395313313219182",
        "summary": "Explains the free county-economy redesign: districts containing buildings, prosperity separated from settlement size, and control/popular-opinion baselines. Design aims to reduce runaway economic bonuses and strengthen regional specialization.",
        "limits": "Early vision. Later diaries replace or refine several details."
      },
      {
        "id": "dd2",
        "title": "Silk & Silver Dev Diary #2 - Trade Vision",
        "published_at_utc": "2026-05-12T11:58:26Z",
        "steam_news_gid": "1832065502823661",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/690882808486299148",
        "summary": "Introduces category-based needs and expertise, merchant acumen, competition for route shares, monopolies and roads. Expertise and company progression are separate from spendable gold.",
        "limits": "Use DD8 for the later route and settlement model."
      },
      {
        "id": "dd3",
        "title": "Silk & Silver Dev Diary #3 - Merchants Vision",
        "published_at_utc": "2026-05-26T11:57:33Z",
        "steam_news_gid": "1833334318579167",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/677373278422041850",
        "summary": "Describes merchant company progression, domicile investment, patron charters and trade opportunities. Wealth, prestige and accumulated business success play different progression roles.",
        "limits": "Company purposes changed later; War Profiteer should not be presented as an independently confirmed release specialization."
      },
      {
        "id": "dd4",
        "title": "Silk & Silver Dev Diary #4 - Republics Vision",
        "published_at_utc": "2026-06-09T12:00:47Z",
        "steam_news_gid": "1834602721201563",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/677374546802640261",
        "summary": "Separates republican public treasury and Assembly-controlled decrees from the patrician political economy. Discusses public spending on buildings, decrees and title men-at-arms, plus trade posts in foreign lands.",
        "limits": "Government-specific design; does not prove every ruler has a distinct usable public treasury or specify a release getter."
      },
      {
        "id": "dd5",
        "title": "Silk & Silver Dev Diary #5 - Iteration",
        "published_at_utc": "2026-09-01T12:00:55Z",
        "steam_news_gid": "1842212951313198",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/687515256220549926",
        "summary": "Replaces earlier Acquisition Routes with priority Distribution Routes. Introduces toll income and explains entrepots as relay trade points, including directional-origin constraints intended to prevent circular re-export exploitation.",
        "limits": "Basic-goods lists and other details changed later. Prefer DD8 and release files."
      },
      {
        "id": "dd6",
        "title": "Silk & Silver Dev Diary #6 - Merchants, Republics, & the Silk Road",
        "published_at_utc": "2026-09-15T11:58:43Z",
        "steam_news_gid": "1843481262704375",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/711160422578783399",
        "summary": "Explains commissioned transport with an upfront fee, creditor loans with hooks and inheritance, religious usury rules, merchant rivalry and republican popular-opinion spending. Silk Road interactions are available with Silk & Silver; Dynastic Cycle consequences also require All Under Heaven.",
        "limits": "Loan rate examples and commission limits are pre-release values; do not treat as installed defaults."
      },
      {
        "id": "dd8",
        "title": "Silk & Silver Dev Diary #8 - Trade in Practice",
        "published_at_utc": "2026-10-27T13:01:00Z",
        "steam_news_gid": "1847286114048834",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/701031128264350037",
        "summary": "Technical account of production, needs, surplus/deficit pools, route competition, periodic settlement, tolls and roads. Explicitly excludes supply and demand from the price formula; scarcity restricts quantities. Also explains districts, settlement size, food needs, control and specialized taxes.",
        "limits": "Most detailed retrieved trade source, but it still labels numeric values as provisional. Several formulae are images; this report does not transcribe an unverified exact formula."
      },
      {
        "id": "dd9",
        "title": "Silk & Silver Dev Diary #9 - 3D Art, Music, Modding",
        "published_at_utc": "2026-11-03T12:57:11Z",
        "steam_news_gid": "1847920302251844",
        "url": "https://steamcommunity.com/games/1158310/announcements/detail/699905862545705792",
        "summary": "Documents trade and district scopes, data-driven goods/categories/tolls, generated production and price modifiers, trade on_actions, decision pickers and Variable Maps. Lists eleven tax categories and major script renames.",
        "limits": "Does not prove exact getters for final prices, actual trades, inventories or arbitrary native settlement calls. The illustrative silk definition is not evidence of release basic-good classification."
      }
    ]
  },
