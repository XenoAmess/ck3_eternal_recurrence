+            if isinstance(conflict, dict)
+            and conflict.get("kind") == "same_province"
+            and conflict.get("province_id") == first_hop
+            and conflict.get("overlap_start_date_raw") == date_raw + 24
+            and conflict.get("overlap_end_date_raw") == date_raw + 24
+        } != set(hostile_army_ids)
+    ):
+        return None
+    friendly_soldiers = strength_balance.get("friendly_current_soldiers")
+    enemy_soldiers = strength_balance.get("enemy_current_soldiers")
+    friendly_power = strength_balance.get("friendly_ai_base_power_raw")
+    enemy_power = strength_balance.get("enemy_ai_base_power_raw")
+    if (
+        any(type(value) is not int or value <= 0 for value in (
+            friendly_soldiers, enemy_soldiers, friendly_power, enemy_power
