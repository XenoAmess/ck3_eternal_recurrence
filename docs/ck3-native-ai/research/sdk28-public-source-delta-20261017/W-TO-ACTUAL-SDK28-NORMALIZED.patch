+    if not controlled or existing_army_id not in {army["army_id"] for army in controlled}:
+        return {**denied, "reason": "existing_subject_or_war_roster_unavailable"}
+    if any(
+        army.get("army_state") in {"combat", "retreating", "gathering"}
+        or army.get("in_combat") is True
+        or army.get("retreating") is True
+        or army.get("move_target_province_id") is not None
+        or army.get("route_province_ids") != []
+        for army in controlled
+    ):
+        return {**denied, "reason": "controlled_army_not_quiet"}
+    if len({army["army_id"] for army in controlled}) != len(controlled):
+        return {**denied, "reason": "duplicate_public_army"}
+    indexed: dict[int, Mapping[str, object]] = {}
+    for row in strength_rows:
+        if not isinstance(row, Mapping) or not _positive_int(row.get("army_id")):
+            continue
