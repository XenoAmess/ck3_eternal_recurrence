+def _guard_remote_ghost_day_v1(
+    plan: dict[str, object], commands: list[dict[str, object]],
+    snapshot: dict[str, object] | None, action_steps: set[str],
+) -> dict[str, object]:
+    """Require one closed-window proof for an idle real army and remote ghost."""
+    if not is_life_advance_step(plan.get("selected_step")) or not isinstance(snapshot, dict):
+        return plan
+    wars = plan.get("active_wars")
+    if not isinstance(wars, list) or not wars:
+        return plan
+    proofs = [war.get("threatened_ghost_preview_subject_v1")
+              for war in wars if isinstance(war, dict)]
+    if (len(proofs) != len(wars) or not all(isinstance(p, dict) for p in proofs)
+            or any(p != proofs[0] for p in proofs)):
+        return plan
+    proof = proofs[0]
+    if not (
+        proof.get("status") == "threatened_ghost_preview_subject_candidate"
+        and proof.get("source_snapshot_id") == snapshot.get("snapshot_id")
+        and proof.get("source_revision") == snapshot.get("revision")
+        and proof.get("ghost_risk_cleared") is False
+        and proof.get("movement_authorized") is False
+        and proof.get("battle_authorized") is False
+    ):
+        return plan
+    ghost_province = _native_int(proof.get("ghost_threat_province_id"))
+    real_id = _public_cunit_int(proof.get("selected_army_id"))
+    armies = snapshot.get("player_armies")
+    real = next((army for army in armies if isinstance(army, dict)
+                 and army.get("army_id") == real_id), None) if isinstance(armies, list) else None
+    if not isinstance(real, dict) or ghost_province is None:
+        return {**plan, "phase": "native_war_remote_ghost_binding_invalid",
+                "selected_step": None}
+    real_province = _native_int(real.get("current_province_id"))
+    if real_province is None or real_province == ghost_province:
+        return plan
+    if (real.get("move_target_province_id") is not None
+            or real.get("route_province_ids") != []):
+        # Active routes already use the existing complete global conjunction.
+        return plan
+    active_wars = snapshot.get("active_wars")
+    if not isinstance(active_wars, list):
+        return {**plan, "phase": "native_war_remote_ghost_wars_unavailable",
+                "selected_step": None}
+    enemies = [army for army in enemy_armies_from_wars(active_wars)
+               if _army_tactical_state(army) != "retreating"]
+    enemy_ids = [_public_cunit_int(army.get("army_id")) for army in enemies]
+    if (not enemy_ids or any(enemy_id is None for enemy_id in enemy_ids)
+            or len(set(enemy_ids)) > MAX_ROUTE_CONTACT_HOSTILE_IDS):
+        return {**plan, "phase": "native_war_remote_ghost_hostile_scope_unavailable",
+                "selected_step": None}
+    hostile_ids = tuple(sorted(set(enemy_ids)))
+    gate = {"ghost_army_id": proof["ghost_army_id"],
+            "ghost_province_id": ghost_province,
+            "real_army_id": real_id, "real_province_id": real_province,
+            "hostile_army_ids": list(hostile_ids),
+            "original_selected_step": plan.get("selected_step"),
+            "contact_risk_status": "unresolved_one_day_watch",
+            "ghost_risk_cleared": False, "battle_authorized": False,
+            "movement_authorized": False}
+    # A stationary CArmy has no route for Native's route-horizon builder.
+    # Never present a zero-hop query as a safety proof or let the existing
+    # seven-day objective hold hide the remote ghost. Watch only one day,
+    # with the full hostile scope retained for the next fresh plan.
+    close_or_next_hop = []
+    for enemy in enemies:
+        current = _native_int(enemy.get("current_province_id"))
+        route = enemy.get("route_province_ids")
+        first_hop = _native_int(route[0]) if isinstance(route, list) and route else None
+        if current in {ghost_province, real_province} or first_hop in {
+            ghost_province, real_province
+        }:
+            close_or_next_hop.append(enemy.get("army_id"))
+    if close_or_next_hop:
+        return {**plan, "phase": "native_war_remote_ghost_immediate_contact_risk",
+                "selected_step": None,
+                "remote_ghost_contact_gate_v1": {
+                    **gate, "close_or_next_hop_hostile_army_ids": sorted(close_or_next_hop)}}
+    step = "life-advance-one-day"
+    return {**plan, "phase": "native_war_remote_ghost_one_day_watch",
+            "selected_step": step if step in action_steps else None,
+            "required_step": step,
+            "reason": "the controlled CArmy has no active route and the ghost CUnit has no native CArmy; observe one day without clearing the ghost or claiming contact safety",
+            "remote_ghost_contact_gate_v1": gate}
