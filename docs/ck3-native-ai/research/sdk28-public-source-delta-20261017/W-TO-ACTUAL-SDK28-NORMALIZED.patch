+"""Bounded prospective pause diagnostics; no dispatch or recovery decisions."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import uuid
+
+from ..environment import write_json_atomic
+
+
+def _scalar(value):
+    return value[:256] if isinstance(value, str) else value if type(value) in (int, bool, float) or value is None else None
+
+
+def _frame(snapshot):
+    if not isinstance(snapshot, dict):
+        return {"status": "unavailable"}
+    fields = ("snapshot_id", "revision", "native_revision", "date_raw", "paused", "speed", "map_ready",
+              "episode_run_id", "episode_character_id", "local_player_id", "one_life_terminal_reason")
+    value = {key: _scalar(snapshot.get(key)) for key in fields}
+    for key, names in (("played_character", ("character_id", "alive")),
+                       ("diagnostics", ("bridge_pid", "connection_generation", "connected")),
+                       ("pending_character_interaction", ("id", "instance_id", "interaction_id", "sender_character_id", "recipient_character_id"))):
+        row = snapshot.get(key)
+        value[key] = {name: _scalar(row.get(name)) for name in names} if isinstance(row, dict) else None
+    event = snapshot.get("active_event")
+    if isinstance(event, dict):
+        value["active_event"] = {key: _scalar(event.get(key)) for key in ("instance_id", "option_count", "event_definition_key")}
+        options = event.get("options")
+        value["active_event"]["options"] = [{key: _scalar(row.get(key)) for key in
+            ("index", "option_number", "enabled", "label")} for row in options[:8] if isinstance(row, dict)] if isinstance(options, list) else []
+        value["active_event"]["option_rows_truncated"] = isinstance(options, list) and len(options) > 8
+    else:
+        value["active_event"] = None
+    return value
+
+
+def _original(value):
+    if not isinstance(value, dict):
+        return {"status": "unavailable_not_retained_by_exception"}
+    try:
+        raw = json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode("utf-8")
+    except Exception:
+        return {"status": "unavailable_not_JSON_serializable"}
+    proof = {"json_utf8_bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}
+    if len(raw) <= 4096:
+        return {"status": "original_parsed_frame_preserved", **proof, "frame": value}
+    return {"status": "oversize_original_not_copied", **proof,
+            "prefix_utf8": raw[:512].decode("utf-8", errors="replace")}
+
+
+class LifeAdvancePauseFaultEvidenceV1:
+    def __init__(self, driver, starting):
+        self.driver = driver
+        self.path = None
+        self.last_write_error = None
+        self.frames = [{"stage": "starting", "frame": _frame(starting)}]
+        self.attempts = []
+        self.failed = False
+
+    def __enter__(self):
+        return self
+
+    def frame(self, stage, snapshot):
+        if len(self.frames) < 12:
+            self.frames.append({"stage": stage, "frame": _frame(snapshot)})
+        return snapshot
+
+    def rejection(self, stage, error):
+        self.failed = True
+        request = getattr(error, "native_request_frame", None)
+        reply = getattr(error, "native_command_result_frame", None)
+        request_id = getattr(error, "native_request_id", None)
+        self.attempts.append({"stage": stage, "status": "exception",
+            "exception_type": type(error).__name__, "error": str(error)[:512],
+            "native_request_id": request_id if isinstance(request_id, str) else None,
+            "request_id_status": "available" if isinstance(request_id, str) else "unavailable_not_retained_by_exception",
+            "original_request": _original(request), "original_command_result": _original(reply),
+            "request_reply_ID_binding_matches": bool(isinstance(request_id, str) and isinstance(request, dict)
+                and isinstance(reply, dict) and request.get("request_id") == request_id and reply.get("request_id") == request_id),
+            "original_wire_bytes": "unavailable_exception_retains_parsed_frames_only"})
+        self._write("rejection_observed")
+
+    def ack(self, stage, result):
+        request_id = result.get("native_request_id") if isinstance(result, dict) else None
+        self.attempts.append({"stage": stage, "status": "returned", "native_request_id": request_id,
+            "request_id_status": "available" if isinstance(request_id, str) else "unavailable_success_result_does_not_retain_request_ID",
+            "result": {key: _scalar(result.get(key)) for key in ("step", "accepted", "status")} if isinstance(result, dict) else None})
+
+    def _write(self, status, error=None):
+        # Evidence must never mask an original pause error or change its return.
+        try:
+            root = getattr(self.driver, "state_dir", None)
+            if root is None:
+                self.last_write_error = "state_dir_unavailable"
+                return
+            if self.path is None:
+                self.path = Path(root) / "evidence/life-advance-pause" / (uuid.uuid4().hex + ".json")
+            payload = {"schema": "xar.life-advance-pause-fault-evidence/v1", "status": status,
+                "attempts": self.attempts[:4], "frames": self.frames,
+                "error_type": type(error).__name__ if error else None,
+                "error": str(error)[:512] if error else None,
+                "replay_allowed": False, "action_or_material_credit": False}
+            raw = json.dumps(payload, ensure_ascii=False, indent=2).encode("utf-8")
+            if len(raw) > 49152:
+                payload["frames"] = self.frames[-2:]
+                payload["capture_truncated"] = True
+            raw = json.dumps(payload, ensure_ascii=False, indent=2).encode("utf-8")
+            if len(raw) > 65535:
+                # Keep exact hashes/IDs when original parsed frames are too big
+                # together, instead of writing an oversized failure artifact.
+                payload["attempts"] = [{**row, **{key: {k: v for k, v in row[key].items() if k != "frame"}
+                    for key in ("original_request", "original_command_result") if key in row}}
+                    for row in payload["attempts"]]
+                payload["capture_truncated"] = True
+            write_json_atomic(self.path, payload)
+        except Exception as failure:
+            self.last_write_error = type(failure).__name__ + ": " + str(failure)[:256]
+
+    def __exit__(self, kind, error, traceback):
+        if error is not None or self.failed:
+            self._write("pause_failed" if error is not None else "pause_returned_after_rejection", error)
+            if error is not None:
+                try:
+                    error.life_advance_pause_fault_evidence = {
+                        "path": str(self.path) if self.path else None,
+                        "write_error": self.last_write_error}
+                except Exception:
+                    pass
+        return False
