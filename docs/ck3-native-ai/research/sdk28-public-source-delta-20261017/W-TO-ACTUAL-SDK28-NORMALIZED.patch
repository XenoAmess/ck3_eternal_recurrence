+) -> dict[str, object]:
+    """Rank a quiet preview subject using Driver's exact-frame Army cache.
+
+    The caller still previews this army's route, verifies contact/battle guards,
+    and audits every other controlled army. An unreadable CArmy is unknown, not
+    zero strength or disposable. This helper never returns an action step.
+    """
+    denied = {"status": "unavailable", "selected_army_id": None,
+              "native_preview_required": True, "movement_authorized": False,
+              "battle_authorized": False, "other_army_risk_cleared": False}
+    if tuple(stationary_threat_army_ids) or tuple(unsafe_route_army_ids):
+        return {**denied, "reason": "not_quiet"}
+    actor = snapshot.get("played_character")
+    diagnostics = snapshot.get("diagnostics")
+    if not (
+        snapshot.get("paused") is True
+        and snapshot.get("map_ready") is True
+        and isinstance(snapshot.get("snapshot_id"), str)
+        and snapshot["snapshot_id"]
+        and _positive_int(snapshot.get("revision"))
+        and _positive_int(snapshot.get("native_revision"))
+        and _positive_int(snapshot.get("date_raw"))
+        and isinstance(snapshot.get("episode_run_id"), str)
+        and snapshot["episode_run_id"]
+        and isinstance(actor, Mapping)
+        and _positive_int(actor.get("character_id"))
+        and isinstance(diagnostics, Mapping)
+        and _positive_int(diagnostics.get("connection_generation"))
+        and _positive_int(diagnostics.get("bridge_pid"))
+        and snapshot.get("army_strengths_profile") == "ordinary_core_v1"
+        and snapshot.get("army_strengths_status") in {"available", "partial"}
+        and _positive_int(snapshot.get("army_strengths_query_sequence"))
+        and snapshot.get("army_strengths_queried_snapshot_id")
+            == snapshot["snapshot_id"]
+        and snapshot.get("army_strengths_queried_revision")
+            == snapshot["revision"]
+    ):
+        return {**denied, "reason": "exact_army_query_frame_unavailable"}
+    armies = snapshot.get("player_armies")
+    strength_rows = snapshot.get("army_strengths")
+    wars = snapshot.get("active_wars")
+    if not isinstance(armies, list) or not isinstance(strength_rows, list) or not isinstance(wars, list):
+        return {**denied, "reason": "army_or_war_roster_unavailable"}
+    war_army_ids = {
+        army.get("army_id")
+        for war in wars if isinstance(war, Mapping) and _positive_int(war.get("war_id"))
+        for army in (war.get("allied_armies") if isinstance(war.get("allied_armies"), list) else [])
+        if isinstance(army, Mapping)
