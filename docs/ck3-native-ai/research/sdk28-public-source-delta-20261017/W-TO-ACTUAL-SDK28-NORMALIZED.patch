+def _bounded_committed_contact_plan(
+    *,
+    snapshot: dict[str, object],
+    army: dict[str, object],
+    army_id: int,
+    target_province_id: int,
+    move_intent: dict[str, object] | None,
+    contact_horizon: dict[str, object],
+    strength_balance: dict[str, object] | None,
+    controlled_armies: list[dict[str, object]],
+    hostile_army_ids: list[int],
+    available_steps: set[str],
+    sentinel_live_ready: bool,
+    timeline_speed: int,
+) -> dict[str, object] | None:
+    """Advance an already committed route only to its imminent first-hop contact.
+
+    A numerical margin is an explicit development-stage risk gate, never a
+    prediction of victory. The native decision sentinel still verifies the
+    route and stops on combat, retreat, a player decision, or the date bound.
+    """
+    date_raw = snapshot.get("date_raw")
+    subject = contact_horizon.get("subject_route")
+    hostiles = contact_horizon.get("hostile_routes")
+    conflicts = contact_horizon.get("conflicts")
+    route = army.get("route_province_ids")
+    first_hop = route[0] if isinstance(route, list) and route else None
+    arrivals = subject.get("arrival_date_raws") if isinstance(subject, dict) else None
+    if (
+        type(date_raw) is not int
+        or type(army_id) is not int
+        or type(target_province_id) is not int
+        or not sentinel_live_ready
+        or COMMITTED_ROUTE_SENTINEL_ADVANCE_STEP not in available_steps
+        or timeline_speed != 3
+        or army.get("controllable") is not True
+        or army.get("in_combat") is not False
+        or army.get("retreating") is not False
+        or _army_tactical_state(army) != "moving"
+        or army.get("move_target_province_id") != target_province_id
+        or army.get("route_read_status") != "complete_nonempty"
+        or not isinstance(route, list)
+        or not route
+        or route[-1] != target_province_id
+        or army.get("current_province_id") == target_province_id
+        or not isinstance(move_intent, dict)
+        or move_intent.get("status") != "active"
+        or move_intent.get("army_id") != army_id
+        or move_intent.get("target_province_id") != target_province_id
+        or len(controlled_armies) != 1
+        or controlled_armies[0].get("army_id") != army_id
+        or not 1 <= len(hostile_army_ids) <= 2
+        or not isinstance(strength_balance, dict)
+        or strength_balance.get("status") != "available"
+        or strength_balance.get("hostile_operational_overmatch") is not False
+        or strength_balance.get("friendly_army_ids") != [army_id]
+        or strength_balance.get("enemy_army_ids") != list(hostile_army_ids)
+        or contact_horizon.get("status") != "available"
+        or contact_horizon.get("subject_army_id") != army_id
+        or contact_horizon.get("target_province_id") != target_province_id
+        or contact_horizon.get("hostile_army_ids") != list(hostile_army_ids)
+        or contact_horizon.get("date_raw") != date_raw
+        or contact_horizon.get("snapshot_revision") != snapshot.get("native_revision")
+        or contact_horizon.get("one_day_contact_free") is not False
+        or contact_horizon.get("horizon_start_date_raw") != date_raw
+        or contact_horizon.get("horizon_end_date_raw") != date_raw + 24
+        or not isinstance(subject, dict)
+        or subject.get("army_id") != army_id
+        or subject.get("current_province_id") != army.get("current_province_id")
+        or subject.get("route_province_ids") != route
+        or not isinstance(arrivals, list)
+        or len(arrivals) != len(route)
+        or arrivals[0] != date_raw + 24
+        or (len(route) > 1 and subject.get("effective_origin_province_id") != first_hop)
+        or not isinstance(hostiles, list)
+        or len(hostiles) != len(hostile_army_ids)
+        or any(
+            not isinstance(hostile, dict)
+            or hostile.get("timeline_observable") is not True
+            or hostile.get("army_id") != hostile_id
+            or hostile.get("current_province_id") != first_hop
+            or hostile.get("effective_origin_province_id") != first_hop
+            or hostile.get("route_province_ids") != []
+            or hostile.get("arrival_date_raws") != []
+            for hostile, hostile_id in zip(hostiles, hostile_army_ids)
+        )
+        or not isinstance(conflicts, list)
+        or len(conflicts) != len(hostile_army_ids)
+        or {
+            conflict.get("hostile_army_id")
