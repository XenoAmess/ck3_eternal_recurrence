+def _guard_tactical_sentinel_native_armies_v1(
+    plan: dict[str, object], snapshot: dict[str, object] | None,
+    action_steps: set[str],
+) -> dict[str, object]:
+    """Require native CArmies for the exact A2 Arm watch IDs."""
+    step = plan.get("selected_step")
+    window = parse_advance_route_contact_window_step(step)
+    tactical = (
+        window is not None
+        or parse_committed_route_sentinel_advance_step(step) is not None
+        or parse_war_objective_hold_sentinel_advance_step(step) is not None
+        or parse_battle_decision_epoch_advance_step(step) is not None
+        or step in {
+            _BATTLE_DECISION_EPOCH_ADVANCE_STEP,
+            _BATTLE_TERMINAL_CRUISE_STEP,
+        }
+    )
+    if not tactical or not isinstance(snapshot, dict):
+        return plan
+    armies = snapshot.get("player_armies")
+    if not isinstance(armies, list):
+        return {**plan, "phase": "native_war_tactical_watch_roster_unavailable",
+                "selected_step": None}
+    own_ids = [_public_cunit_int(army.get("army_id"))
+               for army in armies if isinstance(army, dict)
+               and army.get("controllable") is True]
+    if (not own_ids or any(army_id is None for army_id in own_ids)
+            or len(set(own_ids)) != len(own_ids)):
+        return {**plan, "phase": "native_war_tactical_watch_roster_unavailable",
+                "selected_step": None}
+    hostiles = window[2] if window is not None else ()
+    watched = [(army_id, "player") for army_id in own_ids] + [
+        (army_id, "active_war_enemy") for army_id in hostiles
+    ]
+    strength_rows = snapshot.get("army_strengths")
+    exact_cache = (
+        snapshot.get("army_strengths_profile") == "ordinary_core_v1"
+        and snapshot.get("army_strengths_status") in {"available", "partial"}
+        and snapshot.get("army_strengths_queried_snapshot_id")
+            == snapshot.get("snapshot_id")
+        and snapshot.get("army_strengths_queried_revision")
+            == snapshot.get("revision")
+        and _native_int(snapshot.get("army_strengths_query_sequence"))
+            is not None
+        and isinstance(strength_rows, list)
+    )
+    indexed: dict[int, dict[str, object]] = {}
+    if exact_cache:
+        for row in strength_rows:
+            if not isinstance(row, dict):
+                continue
+            army_id = _public_cunit_int(row.get("army_id"))
+            if army_id is not None:
+                if army_id in indexed:
+                    exact_cache = False
+                    break
+                indexed[army_id] = row
+    if not exact_cache:
+        query_step = QUERY_ARMY_STRENGTHS_STEP
+        return {**plan, "phase": "native_war_tactical_watch_strength_query",
+                "selected_step": query_step if query_step in action_steps else None,
+                "required_step": query_step,
+                "tactical_watch_army_ids": sorted({army_id for army_id, _ in watched})}
+    unverified = []
+    for army_id, role in watched:
+        row = indexed.get(army_id)
+        if not (
+            isinstance(row, dict)
+            and row.get("scope_role") == role
+            and row.get("status") == "available"
+            and _native_int(row.get("native_carmy_id")) is not None
+        ):
+            unverified.append({
+                "army_id": army_id, "role": role,
+                "status": row.get("status") if isinstance(row, dict) else None,
+                "unavailable_reason": (
+                    row.get("unavailable_reason") if isinstance(row, dict)
+                    else "missing_same_frame_strength_row"
+                ),
+            })
+    if unverified:
+        return {**plan, "phase": "native_war_tactical_watch_army_unavailable",
+                "selected_step": None,
+                "reason": "the multi-day native sentinel fingerprints every watched CUnit; at least one lacks a verified native CArmy",
+                "tactical_watch_army_ids": sorted({army_id for army_id, _ in watched}),
+                "tactical_watch_unverified": unverified}
+    return plan
