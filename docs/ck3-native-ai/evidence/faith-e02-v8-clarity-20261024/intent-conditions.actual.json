  "narration_candidates": {
    "N13": "菜单里有两个叫“深思熟虑”的选项。一个属于活动选项里的朝圣态度，游戏栏名叫“忠诚”；另一个是朝圣意图。朝圣态度改变行进速度修正和主奖励计算，意图则让沿途偏向反思、行善或传播信仰。反思意图不要求先有耐心或朝圣者特质；那个门槛属于朝圣态度里的同名档位。",
    "N15": "这次主持朝圣，界面显示了深思熟虑、行善和热忱。原版主持者的意图池列着这三项：深思熟虑是默认项，后两项还检查高级活动功能，行善另检查人物存活且未被囚禁。这些显示条件不按天主教信仰或人物奉献等级筛选。若只是来宾，原版显式列出的候选只有深思熟虑。共享的娱乐定义能让事件响应，并不表示它自动成为菜单第四项。",
    "exact_localization_labels": [
      "深思熟虑",
      "行善",
      "热忱"
    ],
    "forbidden_overclaims": [
      "Catholic faith causes the three-item menu",
      "All three displayed options were proven selectable",
      "Character devotion level unlocks these intentions",
      "Generous is required for Altruism",
      "Zealous is required for Zealotry",
      "Recreation automatically becomes a fourth pilgrimage intent",
      "advanced_activities definitively means a named branded DLC"
    ]
  },
