,"bbox":[120,42,500,69]},{"text":"规则图解 · 图表27／28","font_px":30,"bbox":[2133,42,2440,72]},{"text":"动态特质处理","font_px":66,"bbox":[120,112,516,177]},{"text":"条目","font_px":32,"bbox":[144,270,208,302]},{"text":"资格／实际对象","font_px":32,"bbox":[744,270,968,303]},{"text":"具体影响／基础请求","font_px":32,"bbox":[1844,270,2132,302]},{"text":"当前罪恶选择器","font_px":36,"bbox":[224,342,476,378]},{"text":"当前礼仪将朝圣者视为罪恶，且实际候选中抽中","font_px":36,"bbox":[744,342,1500,379]},{"text":"可能删除朝圣者","font_px":36,"bbox":[1844,342,2096,377]},{"text":"当前美德选择器","font_px":36,"bbox":[224,438,476,474]},{"text":"当前礼仪视为美德，未拥有且无相反冲突，并被抽中","font_px":36,"bbox":[744,438,1572,475]},{"text":"可能授予朝圣者","font_px":36,"bbox":[1844,438,2096,474]},{"text":"先删罪恶再加美德","font_px":36,"bbox":[224,534,512,569]},{"text":"宗教决议事件对应沉思分支调用，实际抽选另判","font_px":36,"bbox":[744,534,1500,571]},{"text":"可能删或加，不是必然交换","font_px":36,"bbox":[1844,534,2276,570]},{"text":"悔改誓言的处理","font_px":36,"bbox":[224,630,476,667]},{"text":"朝圣者为名声类，当前视为罪恶，另满足誓言决议资格","font_px":36,"bbox":[744,630,1608,667]},{"text":"进入对应移除列表；","font_px":36,"bbox":[1844,630,2168,667]},{"text":"人格专属路径另排除","font_px":36,"bbox":[1844,676,2168,712]},{"text":"当前礼仪怎样评价朝圣者，也会影响动态授予和移除的候选。","font_px":30,"bbox":[120,1050,930,1081]},{"text":"朝圣者","font_px":36,"bbox":[1458,125,1566,160]}],"materials":[{"asset_id":"doctrine.forbidden","source":{"path":"C:\\Program Files (x86)\\Steam\\steamapps\\common\\Crusader Kings III\\game\\gfx\\interface\\icons\\faith_doctrines\\doctrine_pilgrimage_forbidden.dds","bytes":57728,"sha256":"7d682d77e84a2eb12e30b65ff86d59741abfbe314f7212cc94adb2b612aef12d"},"slot":[144,342,208,406],"actual_bounds":[144,342,208,406],"source_crop":null,"cropped_size":[120,120],"resized_size":[64,64],"alpha_bbox":[2,4,60,56],"rgba_sha256":"146f520a4d4ebdca00414e7f0b492aa0aff79adfa2776521390afe3587d71385","backplate_color":"#e8d8b5","contrast_mean_luma":0.0,"source_definition_refs":["common/religion/doctrine_types/20_doctrines.txt"],"source_gui_refs":["gui/window_faith.gui:2908"]},{"asse