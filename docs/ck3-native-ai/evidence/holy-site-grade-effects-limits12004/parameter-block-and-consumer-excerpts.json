      "relative": "common/religion/holy_site_types/_holy_site_types.info",
      "line": 22,
      "text": "\t# Trigger (barony scope): 'has_holy_site_parameter' where $TITLE$ inserts localized named of barony",
      "context": [
        "",
        "\t### Brief: parameters ( parameter list )",
        "\t# Arbitrary parameters to be checked in applying various effects.",
        "\t# Localization: \"holy_site_parameter_<parameter_name>\" where $PARAMETER_NAME$ inserts localized named of parameter",
        "\t# Trigger (barony scope): 'has_holy_site_parameter' where $TITLE$ inserts localized named of barony",
        "\t# Trigger (faith scope): 'controls_holy_site_with_parameter' where $FAITH$ inserts localized named of faith",
        "\t# ",
        "\t# Note: The above trigger just checks for existence, so it does not",
        "\t# matter if the value is set to 'yes' or 'no'."
      ]
    },
    {
      "relative": "common/religion/holy_site_types/_holy_site_types.info",
      "line": 23,
      "text": "\t# Trigger (faith scope): 'controls_holy_site_with_parameter' where $FAITH$ inserts localized named of faith",
      "context": [
