      "lines": [
        {
          "line": 1,
          "text": "# Scope: holy_site"
        },
        {
          "line": 2,
          "text": "# Returns: the sum of Artifact Rarity values of every artifact enshrined in"
        },
        {
          "line": 3,
          "text": "# the holy site whose is_holy_relic trigger passes for the controlling faith."
        },
        {
          "line": 4,
          "text": "# (And the controlling faith also has this holy site as one of their own)"
        },
        {
          "line": 5,
          "text": "# Each artifact contributes 1=Common, 2=Masterwork, 3=Famed, 4=Illustrious."
        },
        {
          "line": 6,
          "text": "# 0 if nothing qualifies."
        },
        {
          "line": 7,
          "text": "# Backed by the `total_active_artifact_rarity_sum` trigger registered in"
        },
        {
          "line": 8,
          "text": "# holy_site_artifact_trigger_impl.cpp."
        },
        {
          "line": 9,
          "text": "holy_site_total_artifact_rarity = {"
        },
        {
          "line": 10,
          "text": "\tvalue = root.total_active_artifact_rarity_sum"
        },
        {
          "line": 11,
          "text": "}"
        },
        {
          "line": 12,
          "text": ""
        },
        {
          "line": 13,
          "text": "# How long a ruler must wait between holy site actions, shared by the decisions and by holy site creation."
        },
        {
          "line": 14,
          "text": "holy_site_action_cooldown_years = {"
        },
        {
          "line": 15,
          "text": "\tvalue = 5"
        },
        {
          "line": 16,
          "text": "}"
        },
        {
          "line": 17,
          "text": ""
        },
        {
          "line": 18,
          "text": "# Scope: character taking one of the holy site decisions."
        },
        {
          "line": 19,
          "text": "# Cooldown in years, waived while the faith still has a free holy site action left. Decision cooldowns"
        },
        {
          "line": 20,
          "text": "# are evaluated with only the taking character in scope - no saved scopes - so this can read the faith"
        },
        {
          "line": 21,
          "text": "# but nothing about the selected holy site."
        },
        {
          "line": 22,
          "text": "holy_site_decision_cooldown_value = {"
        },
        {
          "line": 23,
          "text": "\tvalue = holy_site_action_cooldown_years"
        },
        {
          "line": 24,
          "text": "\tif = {"
        },
        {
          "line": 25,
          "text": "\t\tlimit = { faith = { faith_has_free_holy_site_action_trigger = yes } }"
        },
        {
          "line": 26,
          "text": "\t\tvalue = 0"
        }
      ]
    },
