          "text": "            readOnlyHint=True, destructiveHint=False, idempotentHint=False, openWorldHint=False))"
        },
        {
          "line": 2067,
          "text": "        def ck3_query_player_holy_site_relic_action_context_v1("
        },
        {
          "line": 2068,
          "text": "            expected_revision: Annotated[int, Field(strict=True, gt=0)],"
        },
        {
          "line": 2069,
          "text": "            holy_site_id: Annotated[int, Field(strict=True, ge=0, lt=2**32 - 1)],"
        },
        {
          "line": 2070,
          "text": "            artifact_id: Annotated[int, Field(strict=True, ge=0, lt=2**32 - 1)],"
        },
        {
          "line": 2071,
          "text": "        ) -> dict[str, object]:"
        },
        {
          "line": 2072,
          "text": "            \"\"\"Read native relic action context for two explicit full IDs; no selection or command.\"\"\""
        },
        {
          "line": 2073,
          "text": "            return service.query_player_holy_site_relic_action_context_v1("
        },
        {
          "line": 2074,
          "text": "                expected_revision=expected_revision, holy_site_id=holy_site_id,"
        },
        {
          "line": 2075,
          "text": "                artifact_id=artifact_id)"
