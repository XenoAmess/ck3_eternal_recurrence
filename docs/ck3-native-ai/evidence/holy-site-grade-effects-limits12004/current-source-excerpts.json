          "line": 230,
          "text": "    } else {out.inventory.artifact_ids.clear();out.inventory.slots.clear();out.inventory.unavailable_reason=\"inventory_reference_or_slot_array_unavailable\";}"
        },
        {
          "line": 231,
          "text": "    EvaluateCurrent(b,site,out);"
        },
        {
          "line": 232,
          "text": "    if (jomini_owner) {"
        },
        {
          "line": 233,
          "text": "      RecognitionMatrix matrix{};"
        },
        {
          "line": 234,
          "text": "      (void)ReadHolySiteRelicRecognitionMatrix12004(b,jomini_owner,c,requested,std::nullopt,&out,matrix);"
        },
        {
          "line": 235,
          "text": "      out.recognition_matrix=std::move(matrix);"
        },
        {
          "line": 236,
          "text": "      ModifierAggregateObservation modifiers{};"
        },
        {
          "line": 237,
          "text": "      (void)ReadHolySiteModifierAggregate12004(b,c,requested,modifiers);"
        },
        {
          "line": 238,
          "text": "      out.modifier_aggregate_observation=std::move(modifiers);"
        },
        {
          "line": 239,
          "text": "    }"
        },
        {
          "line": 240,
          "text": "    // The legacy counter keeps its original scope. Matrix calls are disclosed"
        },
        {
          "line": 241,
          "text": "    // separately, and all original post-evaluation identity/cache checks follow."
        },
        {
          "line": 242,
          "text": "    std::vector<std::uint32_t> after_ids,after_faiths;std::vector<Slot> after_slots;"
        },
        {
          "line": 243,
          "text": "    CountyContext after_county{};County(b,site,after_county);"
        },
        {
          "line": 244,
          "text": "    const bool county_same=after_county.available==out.county_context.available &&"
        },
        {
          "line": 245,
          "text": "        after_county.barony_title_id==out.county_context.barony_title_id &&"
        },
        {
          "line": 246,
          "text": "        after_county.county_title_id==out.county_context.county_title_id &&"
        },
        {
          "line": 247,
          "text": "        after_county.county_holder_id==out.county_context.county_holder_id &&"
        },
        {
          "line": 248,
          "text": "        after_county.county_holder_rite_id==out.county_context.county_holder_rite_id &&"
        },
        {
          "line": 249,
          "text": "        after_county.county_holder_faith_id==out.county_context.county_holder_faith_id;"
        },
        {
          "line": 250,
          "text": "    if (Resolve(b,b.holy_site_storage,requested,0x10)!=site||!county_same)"
        },
        {
          "line": 251,
          "text": "      return fail(\"holy_site_or_county_identity_changed\");"
        },
        {
          "line": 252,
          "text": "    if (out.associated_faith_ids_available&&(!Ids(b,site,0x98,after_faiths)||after_faiths!=out.associated_faith_ids))"
        },
        {
          "line": 253,
          "text": "      return fail(\"associated_faith_ids_changed\");"
        },
        {
          "line": 254,
          "text": "    if (out.inventory.available) {"
        }
      ]
    },
