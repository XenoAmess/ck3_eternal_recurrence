+        if op=='gs:[48h]':return 0xFFFF0048
+        expr=op[1:-1]
+        parts=re.split(r'(?=[+-])',expr)
+        total=self.reg[parts[0]]
+        for p in parts[1:]:
+            sign=-1 if p[0]=='-' else 1
+            total+=sign*self.number(p[1:])
+        return total&MASK
+    @staticmethod
+    def number(op):return int(op[:-1],16) if op.endswith('h') else int(op,10)
+    def read(self,op):
