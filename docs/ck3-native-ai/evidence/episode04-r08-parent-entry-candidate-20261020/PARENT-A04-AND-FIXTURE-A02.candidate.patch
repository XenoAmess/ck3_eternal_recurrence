+        if '[' in op:self.mem[self.address(op)]=value
+        elif op in ('eax','ecx','edx'):self.reg['r'+op[1:]]=value&0xffffffff
+        else:self.reg[op]=value
+    def arithmetic_flags(self,value):
+        self.zf=(value&MASK)==0
