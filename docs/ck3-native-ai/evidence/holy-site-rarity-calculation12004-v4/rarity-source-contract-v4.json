  "algorithm_steps": [
    {
      "step": 1,
      "rva": "265A3F6..409",
      "rule": "If site+8C owned-reference count equals0 return0 immediately; this is not slot count. Negative/corrupt counts are outside valid object contract and observers must refuse them."
    },
    {
      "step": 2,
      "rva": "265A40A..42E",
      "rule": "Use signed actual slot count site+74 and pointer site+68; stride24 bytes; sum starts0."
    },
    {
      "step": 3,
      "rva": "265A435..484",
      "rule": "Per slot artifact fullID at+10; FFFFFFFF empty skips. Storage5D1DE68 low24 index/capacity and fullID generation checks; engine fallback is then Arti-magic/fullID!=-1 tested. Bridge unresolved identity stays unknown, never default artifact as requested object."
    },
    {
      "step": 4,
      "rva": "265A48C ->2531320",
      "rule": "Resolve site barony->county->actual holder Character->current Rite->Faith; require that exact Faith fullID in site+98. Player Faith, eminent grade, original donor, county population Faith and top-liege Faith do not replace holderFaith."
    },
    {
      "step": 5,
      "rva": "2531427..467 ->2530EF0",
      "rule": "If holderFaith association fails returnfalse; otherwise original2530EF0(artifact,holderFaith,null)."
    },
    {
      "step": 6,
      "rva": "2530F24..F54;2531036..11AD",
      "rule": "Recognition is dynamic sanctified Faith membership OR template compiled trigger. With null tooltip a dynamic true returns immediately; otherwise template type+38 must be valid and template trigger count+3CC nonzero before evaluating template+380 with requested Faith root and artifact scope tag31."
    },
    {
      "step": 7,
      "rva": "265A491..49B",
      "rule": "Only true adds artifact+B0 signed32 raw rarity to ESI. Iterate each slot; no artifact deduplication and no extra weight from eminent grade. Native integer addition keeps low32; stock1..4 values under normal small slot counts do not overflow."
    },
    {
      "step": 8,
      "rva": "265A49B..4BF",
      "rule": "Return int32 sum. Cache/current Active corresponds to signed sum>0 where produced; this current function itself writes no site fields."
    }
  ],
