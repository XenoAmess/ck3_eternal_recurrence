          "line": 1,
          "text": "# Scope: holy_site"
        },
        {
          "line": 2,
          "text": "# Returns: the sum of Artifact Rarity values of every artifact enshrined in"
        },
        {
          "line": 3,
          "text": "# the holy site whose is_holy_relic trigger passes for the controlling faith."
        },
        {
          "line": 4,
          "text": "# (And the controlling faith also has this holy site as one of their own)"
        },
        {
          "line": 5,
          "text": "# Each artifact contributes 1=Common, 2=Masterwork, 3=Famed, 4=Illustrious."
        },
        {
          "line": 6,
          "text": "# 0 if nothing qualifies."
        },
        {
          "line": 7,
          "text": "# Backed by the `total_active_artifact_rarity_sum` trigger registered in"
        },
        {
          "line": 8,
          "text": "# holy_site_artifact_trigger_impl.cpp."
        },
        {
          "line": 9,
          "text": "holy_site_total_artifact_rarity = {"
        },
        {
          "line": 10,
          "text": "\tvalue = root.total_active_artifact_rarity_sum"
        },
        {
          "line": 11,
          "text": "}"
        }
      ]
