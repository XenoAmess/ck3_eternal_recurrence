          "source_id": "SC-GUI",
          "source_relative_to_game": "localization/simp_chinese/gui/holy_site_window_l_simp_chinese.yml",
          "source_sha256": "8def6ac874fd2bd63998a0cc372030d73770e4db853bdd48a9b33da870132a30",
          "key": "HOLY_SITE_COUNTY_MODIFIER_CHANGE_HEADER",
          "line": 44,
          "original_line": " HOLY_SITE_COUNTY_MODIFIER_CHANGE_HEADER: \"\\n#bold [holy_site|E]伯爵领：#!#weak （[holy_relic|E]总稀有度变化：#high $CURRENT_SUM$#!变为#high $NEW_SUM$#!）#!\\n\"",
