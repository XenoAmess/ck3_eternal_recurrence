    {
      "id": "poststate_defines_success",
      "rule": "ACK is dispatch evidence. Independently reread scaled wallet, Faith/site association, membership and cooldown; preserve unresolved outcome and do not resubmit when poststate is missing."
    },
    {
      "id": "benefit_requires_more_observation",
