      "claim": "Exact installed4 same-transaction create/holder/resolve and original title scope use",
      "lines": [
        "set_up_dynamic_temporal_hof_title_effect = {",
        "\tfaith = { save_scope_as = my_faith }",
        "\tcreate_dynamic_title = {",
        "\t\ttier = duchy",
        "\t\tname = REL_HEAD_TITLE_NAME",
        "\t\tadj = REL_HEAD_TITLE_ADJ",
        "\t}",
        "\tcreate_title_and_vassal_change = {",
        "\t\ttype = created",
        "\t\tsave_scope_as = change",
        "\t\tadd_claim_on_loss = no",
        "\t}",
        "\tscope:new_title = {",
        "\t\tset_destroy_if_invalid_heir = yes",
        "\t\tset_no_automatic_claims = yes",
        "\t\tset_definitive_form = yes",
        "\t\tset_always_follows_primary_heir = yes",
        "\t\tchange_title_holder = {",
        "\t\t\tholder = $NEW_HOLDER$",
        "\t\t\tchange = scope:change",
        "\t\t}",
        "\t}",
        "\tresolve_title_and_vassal_change = scope:change",
        "\tfaith = { set_religious_head_title = scope:new_title }",
        "\tif = {",
        "\t\tlimit = {",
        "\t\t\tNOT = { has_realm_law = same_faith_succession_law }",
        "\t\t}",
        "\t\tadd_realm_law_skip_effects = same_faith_succession_law",
        "\t}",
        "\tscope:new_title = {",
        "\t\tgenerate_coa = religious_title",
        "\t\tadd_title_law = temporal_head_of_faith_succession_law",
        "\t}"
      ]
    },
