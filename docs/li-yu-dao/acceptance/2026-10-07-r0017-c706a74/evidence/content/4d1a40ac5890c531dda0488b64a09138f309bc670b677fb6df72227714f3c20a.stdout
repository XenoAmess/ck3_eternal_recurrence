7c2cf955659681a7c29b67db6393c40e986f4ec9bd187237e98bc19ac42f24\",\r\n+    \"events/lyd_i3b_institution_events.txt\": \"906c9b689418157bf29bac201c8ca5a2cf1ba99b6802da896caf64ae61213e02\",\r\n+    \"history/faiths/lyd_faith_history.txt\": \"d3f44db69e11ad49f4707e3433df6c4c542073bc245042578ded3c30940df19d\",\r\n+    \"localization/english/lyd_c2_consent_l_english.yml\": \"4c1be606b3bb24324c1f6552a234b0e8fc109cd6aef7db529bcf88d427b15d35\",\r\n+    \"localization/english/lyd_c3_leadership_l_english.yml\": \"bc292b3251cd606acbbc031ab9626845efe929f9be9c01a3521d41a934bdce77\",\r\n+    \"localization/english/lyd_content_l_english.yml\": \"287498e26ddd657db91d1fded99ca671628ef2409f7f56aa86110cabd63d4a78\",\r\n+    \"localization/english/lyd_i3b_institution_l_english.yml\": \"7fb7976bef47c74c456ad0237e90e0d0f5f0510b0605168e53c89f1e3798a2f2\",\r\n+    \"localization/english/lyd_runtime_l_english.yml\": \"f2959daa69931f05633bb5c2280b36a2789858b0977360301388efe0794e0199\",\r\n+    \"localization/simp_chinese/lyd_c2_consent_l_simp_chinese.yml\": \"a14b163909579be11559dda1b7b076103593a5e3c35063bc18db51cb2f9db504\",\r\n+    \"localization/simp_chinese/lyd_c3_leadership_l_simp_chinese.yml\": \"c9b7a294c4113fe1df1b3065a58db9fdd2cd87e0f548cda8cabbefad05b54ea6\",\r\n+    \"localization/simp_chinese/lyd_content_l_simp_chinese.yml\": \"4e93e04d6c894eb549f807bbde9ea1f13a0d43cac202ca30efbcf18221db799f\",\r\n+    \"localization/simp_chinese/lyd_i3b_institution_l_simp_chinese.yml\": \"9bfa7f430d16ab6c42ea61a698a9e57ca4b05cad72d65f49c47f0a1fc02a7439\",\r\n+    \"localization/simp_chinese/lyd_runtime_l_simp_chinese.yml\": \"cdfe4417a8dbd32e04c69a025c5adce08741c22526c4e647069169018c6a6fca\"\r\n+  },\r\n+  \"localization_key_count\": 902,\r\n+  \"event_count\": 70,\r\n+  \"parser\": \"repository Clausewitz structural AST\",\r\n+  \"live\": \"NOT_RUN\",\r\n+  \"not_proven\": [\r\n+    \"native scope/effect semantics\",\r\n+    \"faith/rite migration\",\r\n+    \"authorization consent\",\r\n+    \"NPC chain state\",\r\n+    \"DLC/UI\",\r\n+    \"save reload\",\r\n+    \"installed-game identity\"\r\n+  ]\r\n+}\r"},{"sha":"5e28ec9e0d51235fdf8e34edea225773fbf029e2","filename":"mod_li_yu_dao/common/scripted_effects/lyd_c3_head_factory.txt","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/blob/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt","raw_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/raw/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt","contents_url":"https://api.github.com/repos/XenoAmess/ck3_eternal_recurrence/contents/mod_li_yu_dao%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt?ref=c706a74f9d00dd842b7edce8901fb3417344fd9c","patch":"@@ -29,10 +29,12 @@ lyd_c3_create_owned_temporal_head_effect = {\n             set_no_automatic_claims = yes\n             set_definitive_form = yes\n             set_always_follows_primary_heir = yes\n+        }\n+        faith = { set_religious_head_title = scope:new_title }\n+        scope:new_title = {\n             change_title_holder = { holder = root change = scope:lyd_c3_head_change }\n         }\n         resolve_title_and_vassal_change = scope:lyd_c3_head_change\n-        faith = { set_religious_head_title = scope:new_title }\n         scope:new_title = { generate_coa = religious_title add_title_law = temporal_head_of_faith_succession_law }\n         # Preserve a preexisting law; remove only the law newly added by this factory's native path.\n         # Future native maintenance/reload may re-add it: full political AST protection remains mandatory."},{"sha":"e957247b8489aaf7d81ed1ef9e8f8c9ac2865edb","filename":"mod_li_yu_dao/tools/leadership_templates/common/scripted_effects/lyd_c3_head_factory.txt.in","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/blob/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Ftools%2Fleadership_templates%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt.in","raw_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/raw/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Ftools%2Fleadership_templates%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt.in","contents_url":"https://api.github.com/repos/XenoAmess/ck3_eternal_recurrence/contents/mod_li_yu_dao%2Ftools%2Fleadership_templates%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt.in?ref=c706a74f9d00dd842b7edce8901fb3417344fd9c","patch":"@@ -28,10 +28,12 @@ lyd_c3_create_owned_temporal_head_effect = {\n             set_no_automatic_claims = yes\n             set_definitive_form = yes\n             set_always_follows_primary_heir = yes\n+        }\n+        faith = { set_religious_head_title = scope:new_title }\n+        scope:new_title = {\n             change_title_holder = { holder = root change = scope:lyd_c3_head_change }\n         }\n         resolve_title_and_vassal_change = scope:lyd_c3_head_change\n-        faith = { set_religious_head_title = scope:new_title }\n         scope:new_title = { generate_coa = religious_title add_title_law = temporal_head_of_faith_succession_law }\n         # Preserve a preexisting law; remove only the law newly added by this factory's native path.\n         # Future native maintenance/reload may re-add it: full political AST protection remains mandatory."},{"sha":"e957247b8489aaf7d81ed1ef9e8f8c9ac2865edb","filename":"mod_li_yu_dao/tools/school_consent_templates/common/scripted_effects/lyd_c3_head_factory.txt","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/blob/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Ftools%2Fschool_consent_templates%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt","raw_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/raw/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Ftools%2Fschool_consent_templates%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt","contents_url":"https://api.github.com/repos/XenoAmess/ck3_eternal_recurrence/contents/mod_li_yu_dao%2Ftools%2Fschool_consent_templates%2Fcommon%2Fscripted_effects%2Flyd_c3_head_factory.txt?ref=c706a74f9d00dd842b7edce8901fb3417344fd9c","patch":"@@ -28,10 +28,12 @@ lyd_c3_create_owned_temporal_head_effect = {\n             set_no_automatic_claims = yes\n             set_definitive_form = yes\n             set_always_follows_primary_heir = yes\n+        }\n+        faith = { set_religious_head_title = scope:new_title }\n+        scope:new_title = {\n             change_title_holder = { holder = root change = scope:lyd_c3_head_change }\n         }\n         resolve_title_and_vassal_change = scope:lyd_c3_head_change\n-        faith = { set_religious_head_title = scope:new_title }\n         scope:new_title = { generate_coa = religious_title add_title_law = temporal_head_of_faith_succession_law }\n         # Preserve a preexisting law; remove only the law newly added by this factory's native path.\n         # Future native maintenance/reload may re-add it: full political AST protection remains mandatory."},{"sha":"69be7de0ca3abbed3403bcfad2ebc9cee93f4cf7","filename":"mod_li_yu_dao/tools/test_c3_head_factory_law_protection.py","status":"modified","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/blob/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Ftools%2Ftest_c3_head_factory_law_protection.py","raw_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/raw/c706a74f9d00dd842b7edce8901fb3417344fd9c/mod_li_yu_dao%2Ftools%2Ftest_c3_head_factory_law_protection.py","contents_url":"https://api.github.com/repos/XenoAmess/ck3_eternal_recurrence/contents/mod_li_yu_dao%2Ftools%2Ftest_c3_head_factory_law_protection.py?ref=c706a74f9d00dd842b7edce8901fb3417344fd9c","patch":"@@ -144,6 +144,27 @@ def test_entire_original_factory_AST_unchanged_after_pruning_new_guard(self):\n         original = replace(original, entries=[e for e in original.entries\n                             if e is not None and e.key != 'save_scope_value_as'\n                             and not (e.key == 'if' and (entries(e.value, 'save_scope_value_as') or entries(e.value, 'remove_realm_law')))])\n+        # Only this declared candidate reordering is normalized back before\n+        # comparison to the frozen original factory. No effect value may change.\n+        body = list(original.entries)\n+        faith_heads = [(i, e) for i, e in enumerate(body)\n+                       if e.key == 'faith' and entries(e.value, 'set_religious_head_title')]\n+        holder_scopes = [(i, e) for i, e in enumerate(body)\n+                         if e.key == 'scope:new_title' and entries(e.value, 'change_title_holder')]\n+        self.assertEqual(len(faith_heads), 1)\n+        self.assertEqual(len(holder_scopes), 1)\n+        fi, faith_entry = faith_heads[0]\n+        hi, holder_entry = holder_scopes[0]\n+        self.assertEqual([e.key for e in holder_entry.value.entries], ['change_title_holder'])\n+        self.assertEqual(hi, fi + 1)\n+        self.assertEqual(body[fi - 1].key, 'scope:new_title')\n+        props = body[fi - 1]\n+        combined = replace(props, value=replace(props.value,\n+                           entries=[*props.value.entries, *holder_entry.value.entries]))\n+        body[fi - 1:hi + 1] = [combined]\n+        ri = next(i for i,e in enumerate(body) if e.key == 'resolve_title_and_vassal_change')\n+        body.insert(ri + 1, faith_entry)\n+        original = replace(original, entries=body)\n         actual = hashlib.sha256(json.dumps(fingerprint(original), ensure_ascii=True, separators=(',',':')).encode()).hexdigest()\n         self.assertEqual(actual, 'd79fad675555e5ed4082f48a16086615e1a5ed5e7e6cd8b0308e201991c8e213')\n \n@@ -159,5 +180,26 @@ def test_missing_scope_fallback_regression_is_detected(self):\n         mutant = single(mutant_cleanup, 'limit')\n         self.assertTrue(should_cleanup(mutant, {}, {LAW}))\n \n+    def test_declared_head_before_holder_ordering_keeps_law_after_resolve(self):\n+        body = self.body.entries\n+        fi = next(i for i,e in enumerate(body)\n+                  if e.key == 'faith' and entries(e.value, 'set_religious_head_title'))\n+        hi = next(i for i,e in enumerate(body)\n+                  if e.key == 'scope:new_title' and entries(e.value, 'change_title_holder'))\n+        ri = next(i for i,e in enumerate(body) if e.key == 'resolve_title_and_vassal_change')\n+        li = next(i for i,e in enumerate(body)\n+                  if e.key == 'scope:new_title' and entries(e.value, 'add_title_law'))\n+        self.assertLess(fi, hi)\n+        self.assertLess(hi, ri)\n+        self.assertLess(ri, li)\n+        props = body[fi - 1]\n+        self.assertEqual(props.key, 'scope:new_title')\n+        self.assertEqual([e.key for e in props.value.entries],\n+            ['set_variable','set_variable','set_destroy_if_invalid_heir',\n+             'set_no_automatic_claims','set_definitive_form','set_always_follows_primary_heir'])\n+        self.assertEqual([single(e.value,'name') for e in props.value.entries if e.key == 'set_variable'],\n+                         ['lyd_c2_owned_head_title','lyd_c2_owner_faith'])\n+        self.assertEqual(single(body[li].value, 'add_title_law'), 'temporal_head_of_faith_succession_law')\n+\n if __name__ == '__main__':\n     unittest.main()"}]}]