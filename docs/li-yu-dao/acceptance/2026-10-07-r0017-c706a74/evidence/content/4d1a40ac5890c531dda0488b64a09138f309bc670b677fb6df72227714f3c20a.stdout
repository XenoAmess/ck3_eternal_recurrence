time_20261004/screen-lease-live-r0016\",\n+      \"READY.json\": {\n+        \"path\": \"C:/workspace/ck3_lyd_runtime_20261004/screen-lease-live-r0016/READY.json\",\n+        \"bytes\": 750,\n+        \"sha256\": \"a74775669aad279cd9cf4aac5acfb91dde6b50650edfa2ddd730db97fb7ac595\"\n+      },\n+      \"role\": \"keeper\",\n+      \"handle_value\": 504,\n+      \"handle_local_to_holder_pid\": 17076,\n+      \"handle_access\": 1052672,\n+      \"process_creation_filetime_100ns\": 134358021584882606,\n+      \"handle_retained_before_close\": true,\n+      \"initial_wait_result\": 258,\n+      \"initial_exit_code\": 259,\n+      \"captured_at_utc\": \"2026-10-06T23:39:21.872817+00:00\"\n+    }\n+  ],\n+  \"client_session_id\": \"56ceb473d6c148819c8a046167c4d926\",\n+  \"native_session_id\": \"3f4fc4cafba44dc88b85f99ba4ac1caa\",\n+  \"source_revision\": \"9208b46c95b9dc13ab70bd2d11a0c146dd1fd412\",\n+  \"epoch_id\": \"r16-root-political-cold-20261007-001\",\n+  \"screen_task\": \"ck3-lyd-r16-political-cold-20261007-001\",\n+  \"game_original_handle_owner\": {\n+    \"component\": \"existing SDK NativeProfileService in actual Client-owned native MCP server\",\n+    \"native_session_id\": \"3f4fc4cafba44dc88b85f99ba4ac1caa\",\n+    \"client_session_id\": \"56ceb473d6c148819c8a046167c4d926\",\n+    \"server_process\": {\n+      \"pid\": 14972,\n+      \"create_time\": 1791329487.666042,\n+      \"exe\": \"C:\\\\Users\\\\Administrator\\\\AppData\\\\Local\\\\Programs\\\\Python\\\\Python313\\\\python.exe\",\n+      \"cmdline\": [\n+        \"C:\\\\Users\\\\Administrator\\\\AppData\\\\Local\\\\Programs\\\\Python\\\\Python313\\\\python.exe\",\n+        \"-X\",\n+        \"utf8\",\n+        \"C:\\\\lr16s6\\\\tools\\\\ck3_native_profile_mcp.py\",\n+        \"--profile\",\n+        \"C:\\\\workspace\\\\ck3_lyd_runtime_20261004\\\\live-attempt-016\\\\native-profile-with-exit-inventory.json\",\n+        \"--confucian-challenger-tools\",\n+        \"--grant-title-picker-tools\"\n+      ]\n+    },\n+    \"server_source\": {\n+      \"path\": \"C:/lr16s6/tools/ck3_native_profile_mcp.py\",\n+      \"bytes\": 77955,\n+      \"sha256\": \"b2022b3afbe6c82d3455bdea10b2e4a4560492f32b00c0f87d29fda524253882\"\n+    },\n+    \"original_attach_receipt\": {\n+      \"path\": \"C:/workspace/ck3_lyd_runtime_20261004/live-attempt-016/native-evidence/3f4fc4cafba44dc88b85f99ba4ac1caa/0001-attach.json\",\n+      \"bytes\": 19910,\n+      \"sha256\": \"9060e79726fe816507e5cc560e4e99d62d5c947e6424440c29f83023cd8137f9\"\n+    },\n+    \"actual_game_identity\": {\n+      \"pid\": 16416,\n+      \"process_create_time\": 1791328744.0605772\n+    },\n+    \"actual_connection_generation\": 1,\n+    \"game_handle_value\": null,\n+    \"retained_game_handle_capture_in_attach_receipt\": null,\n+    \"authority\": \"Actual attached SDK session/process identity only; original attach receipt has no exported HANDLE value/capture field. Passive helper observer opens no game HANDLE.\"\n+  },\n+  \"game_handle_opened\": false,\n+  \"close_requested\": false,\n+  \"stop_requested\": false,\n+  \"SDK_calls\": 0,\n+  \"game_calls\": 0\n+}"},{"sha":"63cf32b42025851893ce994567812bf4fdbc56e4","filename":"docs/li-yu-dao/acceptance/2026-10-07-r0016-9208b46/closure/retained-retained_holder_final.json","status":"added","additions":106,"deletions":0,"changes":106,"blob_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/blob/c706a74f9d00dd842b7edce8901fb3417344fd9c/docs%2Fli-yu-dao%2Facceptance%2F2026-10-07-r0016-9208b46%2Fclosure%2Fretained-retained_holder_final.json","raw_url":"https://github.com/XenoAmess/ck3_eternal_recurrence/raw/c706a74f9d00dd842b7edce8901fb3417344fd9c/docs%2Fli-yu-dao%2Facceptance%2F2026-10-07-r0016-9208b46%2Fclosure%2Fretained-retained_holder_final.json","contents_url":"https://api.github.com/repos/XenoAmess/ck3_eternal_recurrence/contents/docs%2Fli-yu-dao%2Facceptance%2F2026-10-07-r0016-9208b46%2Fclosure%2Fretained-retained_holder_final.json?ref=c706a74f9d00dd84