 \"key\": null,\n+                \"value\": \"37244\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"38098\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"36445\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"36663\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"36873\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"31692\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"34973\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"40259\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"35598\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"36638\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"32536\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"38561\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"39045\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"39171\"\n+              },\n+              {\n+                \"key\": null,\n+                \"value\": \"39352\"\n+              }\n+            ]\n+          ],\n+          \"succession_result_type\": [\n+            \"inheritance_child_line\"\n+          ],\n+          \"succession_laws\": [],\n+          \"laws\": []\n+        },\n+        \"saved_R15_B5_RED\": {\n+          \"holder\": 31254,\n+          \"full_AST_sha256\": \"c3989692ff88f71cd665ab03bc74e9858bf7994cb12fd5abe8dcadfd733d8a92\",\n+          \"heir_raw_rows\"