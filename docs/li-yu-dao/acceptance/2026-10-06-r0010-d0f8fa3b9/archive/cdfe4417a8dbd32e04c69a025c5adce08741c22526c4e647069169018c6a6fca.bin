l_simp_chinese:
 # GENERATED FILE: edit tools/gen_runtime.py
 lyd_common_faith:0 "儒家共宗"
 lyd_common_faith_adj:0 "儒家共宗"
 lyd_common_faith_adherent:0 "儒者"
 lyd_common_faith_adherent_plural:0 "儒者"
 lyd_common_faith_desc:0 "诸儒以经典、礼仪与修身为共同根基。各家可以同尊先圣而解释天、性、心与祭礼有别；共宗不要求诸家只存一说。"
 lyd_enter_decision:0 "入儒门，习经礼"
 lyd_not_current_faith_head_tt:0 "当前角色不是当前信仰的领袖"
 lyd_not_current_rite_head_tt:0 "当前角色不是当前礼仪的领袖"
 lyd_enter_decision_desc:0 "立志以经典、礼仪与修身为本，加入儒家共宗，从孔门经礼开始问学。"
 lyd_enter_decision_tooltip:0 "加入儒家共宗的孔门经礼"
 lyd_enter_decision_confirm:0 "由我践行"
 lyd_change_school_decision:0 "择师问道"
 lyd_change_school_decision_desc:0 "审读诸家经说，选择自己信从的礼仪与学统。"
 lyd_change_school_decision_tooltip:0 "选择礼仪与学统"
 lyd_change_school_decision_confirm:0 "考察诸家"
 lyd_study_decision:0 "践礼修身"
 lyd_study_decision_desc:0 "将所学用于祭礼、讲学与日常省察。依自己所从学统决定此次修习的方式。"
 lyd_study_decision_tooltip:0 "依当前礼仪进行一次修习"
 lyd_study_decision_confirm:0 "躬行所学"
 lyd_welcome_t:0 "学为君子"
 lyd_welcome_desc:0 "读经不只是识字，奉祀不只是陈列供品。仁、敬与礼须在日用之间践行。我当问师求义，又将所得反诸自身。"
 lyd_welcome_continue:0 "学而时习之"
 lyd_choose_school_t:0 "诸儒之学"
 lyd_choose_school_desc:0 "同读圣贤之书，诸家所重各有不同：仁与礼、性与教、天与祭、理与心。此番改从学统，当先明其义。"
 lyd_adopt_school_tt:0 "改从此礼仪；一年内不能再次择师。"
 lyd_study_cooldown_tt:0 "完成此次修习后，180 天内不能再次践礼修身。"
 lyd_admission_failed_t:0 "尚未改从学统"
 lyd_admission_failed_desc:0 "此次未能改从所选学统，我仍奉行原先礼仪。待处理当前宗主职责或礼仪限制后，再行问学。此次不会开始择师或修习的等待期。"
 lyd_choose_school_previous_page:0 "看前一页学统"
 lyd_choose_school_next_page:0 "看后一页学统"
 lyd_cancel:0 "容我再思"
