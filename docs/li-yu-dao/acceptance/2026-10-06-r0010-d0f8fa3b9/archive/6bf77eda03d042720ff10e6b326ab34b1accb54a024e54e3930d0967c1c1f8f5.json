  "exact_target_vote_source_block": "lyd_c2_target_vote_effect = {\n    if = {\n        limit = { lyd_c2_target_ballot_trigger = yes }\n        set_variable = { name = lyd_c2_vote_owner value = scope:lyd_c2_actor }\n        set_variable = { name = lyd_c2_vote_serial value = scope:lyd_c2_event_serial }\n        set_variable = { name = lyd_c2_vote_nonce value = scope:lyd_c2_event_nonce }\n        set_variable = { name = lyd_c2_vote_yes value = $YES$ }\n        # Same post-write presence gate for receiving-school ballots.\n        if = { limit = { has_variable = lyd_c2_vote_yes }\n            if = {\n                limit = { var:lyd_c2_vote_yes = 1 }\n                rite = { change_variable = { name = lyd_c2_target_yes add = 1 } }\n                scope:lyd_c2_actor = {\n                    change_variable = { name = lyd_c2_target_yes add = 1 }\n                    lyd_c2_request_target_consent_effect = yes\n                }\n            }\n        }\n    }\n}\n",
