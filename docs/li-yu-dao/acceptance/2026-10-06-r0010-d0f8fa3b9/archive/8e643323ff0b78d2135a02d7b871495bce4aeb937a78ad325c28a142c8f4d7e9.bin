-# Default closed in this authored candidate. The dedicated external cold-probe
-# render can opt in; that opt-in is not a release/runtime admission receipt.
-lyd_c3_native_challenger_admitted_trigger = { always = no }
+# Character ROOT. A runtime permission, not an offline/native acceptance receipt.
+# The legitimate office must already exist; creating a challenger never appoints
+# its holder to that office. No fixture flag or primitive-only receipt admits it.
+lyd_c3_native_challenger_admitted_trigger = {
+    lyd_c3_player_actor_trigger = yes
+    lyd_c3_native_challenger_eligible_trigger = yes
+    NOT = { has_variable = lyd_c3_active }
+    NOT = { has_variable = lyd_c3_claim_title }
+    faith = {
+        NOT = { any_faith_rite = { OR = { has_variable = lyd_c2_proposal_owner has_variable = lyd_c3_proposal_owner has_variable = lyd_i3b_owner } } }
+    }
+}
