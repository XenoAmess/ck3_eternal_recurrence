     exists = faith.religious_head
-    this != faith.religious_head
+    exists = faith.religious_head_title
+    trigger_if = { limit = { exists = faith.religious_head exists = faith.religious_head_title exists = faith.religious_head_title.holder }
+        faith.religious_head = { is_alive = yes faith = root.faith }
+        faith.religious_head_title = { holder = root.faith.religious_head }
+        this != faith.religious_head
+    }
+    trigger_else = { always = no }
+    # Stock Character/Faith collection queries: preserve existing foreign roles.
+    pam_is_antipope_trigger = no
+    pam_is_antipope_sponsor_trigger = no
     highest_held_title_tier >= tier_duchy
     exists = capital_county
     faith = { OR = { has_doctrine_parameter = temporal_head_of_faith has_doctrine_parameter = spiritual_head_of_faith } }
