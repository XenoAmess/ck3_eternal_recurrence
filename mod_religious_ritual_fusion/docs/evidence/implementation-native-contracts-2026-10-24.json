  "candidate_self_exclusion_and_local_lists": {
    "finding": "Native can_pick assumes selected_doctrines contains the other selected items, excluding the candidate being evaluated. Including the candidate itself makes unique-family predicates reject even a lone family member.",
    "examples": [
      "unique_syncretism_trigger NOR includes all six syncretism tenets, including the candidate itself.",
      "unique_christology_trigger NOR likewise includes its own family members."
    ],
    "implementation_consequence": "Before each selected candidate can_pick check, remove that candidate from the local selected_doctrines list; evaluate; restore it afterward. Clear local lists before rebuilding them so repeated validation in one effect chain cannot retain previous selections.",
    "local_list_clear_syntax": "every_in_list = { list = selected_doctrines remove_from_list = selected_doctrines }",
    "local_list_clear_scope": "Iterator current scope is the item to remove. This is a local list operation, not clear_variable_list and not an invented clear_list effect.",
