# The native draft edits the one already-created result.
widget = {
	name = "rrf_native_setup_launcher"
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[GetScriptedGui( 'rrf_native_launch_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	state = {
		name = _show
		on_start = "[GetScriptedGui( 'rrf_native_open_ack_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		on_start = "[OpenGameViewData( 'rite_creation', GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).Rite )]"
	}
}

# A native X/ESC close keeps the paid session alive. This recovery control has
# no RiteCreationWindow data context; it only requests the original game view.
widget = {
	name = "rrf_native_setup_recovery"
	parentanchor = bottom|right
	position = { -30 -100 }
	size = { 260 46 }
	layer = top
	visible = "[And( Not( IsGameViewOpen( 'rite_creation' ) ), GetScriptedGui( 'rrf_native_recovery_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
	button_standard = {
		size = { 260 46 }
		text = "RRF_RESUME_SETUP"
		tooltip = "[Localize( 'RRF_RESUME_SETUP_TT' )] [GetScriptedGui( 'rrf_resume_native_setup_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		enabled = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}
}

window = {
	name = "rrf_result_window"
	parentanchor = center
	size = { 95% 95% }
	maximumsize = { 1300 950 }
	layer = middle
	movable = yes
	visible = "[And( GetPlayer.IsValid, GetScriptedGui( 'rrf_result_window_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
	datacontext = "[GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).Rite]"
	using = Window_Background
	using = Window_Decoration
	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }
	vbox = {
		using = Window_Margins
		spacing = 8
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" { text = "RRF_RESULT_COMPLETE_TITLE" }
			blockoverride "button_close" {
				onclick = "[GetScriptedGui( 'rrf_close_result_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		text_multi = { layoutpolicy_horizontal = expanding text = "RRF_RESULT_COMPLETE_GUIDANCE" max_width = 880 autoresize = yes }
		text_multi = {
			name = "rrf_native_mode_blocker"
			visible = "[GetScriptedGui( 'rrf_native_mode_unavailable_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			text = "RRF_REQUIRE_NATIVE_EDIT_MODE"
			layoutpolicy_horizontal = expanding
			max_width = 880
			autoresize = yes
			default_format = "#N"
		}
		text_multi = {
			visible = "[GetScriptedGui( 'rrf_final_configuration_invalid_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			text = "RRF_FINAL_CONFIGURATION_INVALID_DESC"
			layoutpolicy_horizontal = expanding
			max_width = 880
			autoresize = yes
			default_format = "#N"
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 12
			vbox = {
				name = "rrf_result_details_column"
				size = { 320 100% }
				minimumsize = { 320 0 }
				maximumsize = { 320 -1 }
				layoutpolicy_vertical = expanding
				scrollbox = {
					name = "rrf_result_details_scroll"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					blockoverride "scrollbox_background" {}
					blockoverride "scrollbox_margins" { margin = { 0 0 } }
					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							hbox = {
								spacing = 12
								button_rite_icon = { size = { 80 80 } }
								text_multi = { text = "[Rite.GetNameNoTooltip]" layoutpolicy_horizontal = expanding max_width = 220 autoresize = yes using = Font_Size_Big default_format = "#high" }
							}
							text_label_left = { text = "RITE_CREATION_VIEW_NAMING_ADJECTIVE" }
							text_multi = { text = "[Rite.GetAdjectiveNoTooltip]" layoutpolicy_horizontal = expanding max_width = 300 autoresize = yes }
							text_label_left = { text = "RITE_CREATION_VIEW_NAMING_FOLLOWER" }
							text_multi = { text = "[Rite.GetAdherentNameNoTooltip]" layoutpolicy_horizontal = expanding max_width = 300 autoresize = yes }
							text_label_left = { text = "RITE_CREATION_VIEW_NAMING_FOLLOWERS" }
							text_multi = { text = "[Rite.GetAdherentNamePluralNoTooltip]" layoutpolicy_horizontal = expanding max_width = 300 autoresize = yes }
							divider = { layoutpolicy_horizontal = expanding }
							button_primary = {
								name = "rrf_result_resume_setup"
								visible = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								layoutpolicy_horizontal = expanding
								text = "RRF_RESUME_SETUP"
								enabled = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								tooltip = "[Localize( 'RRF_RESUME_SETUP_TT' )] [GetScriptedGui( 'rrf_resume_native_setup_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								onclick = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							button_standard = {
								name = "rrf_result_keep_defaults"
								visible = "[GetScriptedGui( 'rrf_keep_defaults_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								layoutpolicy_horizontal = expanding
								text = "RRF_NATIVE_SETUP_SKIP"
								tooltip = "RRF_NATIVE_SETUP_SKIP_TT"
								onclick = "[GetScriptedGui( 'rrf_keep_defaults_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							text_label_left = { text = "RRF_FINAL_CORE_PREVIEW" }
							scrollbox = {
								name = "rrf_result_core_scroll"
								size = { 100% 220 }
								minimumsize = { 0 220 }
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								blockoverride "scrollbox_content" {
									vbox = {
										layoutpolicy_horizontal = expanding
										datacontext = "[Rite.GetFaith]"
										spacing = 6
										datamodel = "[Rite.GetTenets]"
										item = {
											hbox = {
												spacing = 8
												proportional_icon = { size = { 32 40 } texture = "[TenetType.GetIcon( Faith.Self )]" tooltipwidget = { using = tenet_type_tooltip } }
												text_multi = { text = "[TenetType.GetNameNoTooltip( Rite.Self )]" layoutpolicy_horizontal = expanding max_width = 225 autoresize = yes }
											}
										}
									}
								}
							}
						}
					}
				}
			}
			divider = { layoutpolicy_vertical = expanding }
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_background" { background = { using = Background_Area alpha = 0.75 } }
				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 12 10 }
						spacing = 10
						text_label_left = { text = "RRF_RESULT_FAMILY" }
						vbox = {
							layoutpolicy_horizontal = expanding
							datamodel = "[GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).GetList( 'rrf_expected_family' )]"
							item = { rrf_result_character = {} }
						}
						text_multi = {
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).GetList( 'rrf_expected_family' ) )]"
							layoutpolicy_horizontal = expanding text = "RRF_RESULT_EMPTY" max_width = 440 autoresize = yes default_format = "#weak"
						}
						vbox = {
							visible = "[GetScriptedGui( 'rrf_configured_result_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							layoutpolicy_horizontal = expanding
							spacing = 10
							divider = { layoutpolicy_horizontal = expanding }
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rrf_vassal_converts' ) ) )]"
								text_label_left = { text = "RRF_RESULT_ACCEPTS" }
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8
									datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_converts' )]"
									item = { rrf_result_character = {} }
								}
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rrf_vassal_players' ) ) )]"
								text_label_left = { text = "RRF_RESULT_PLAYERS" }
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8
									datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_players' )]"
									item = { rrf_result_character = {} }
								}
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rrf_vassal_declines' ) ) )]"
								text_label_left = { text = "RRF_RESULT_DECLINES" }
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8
									datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_declines' )]"
									item = { rrf_result_character = {} }
								}
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rrf_vassal_ineligible' ) ) )]"
								text_label_left = { text = "RRF_RESULT_INELIGIBLE" }
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8
									datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_ineligible' )]"
									item = { rrf_result_character = {} }
								}
							}
							divider = { layoutpolicy_horizontal = expanding }
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rrf_vassal_converted' ) ) )]"
								text_label_left = { text = "RRF_RESULT_CONVERTED" }
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8
									datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_converted' )]"
									item = { rrf_result_character = {} }
								}
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'rrf_vassal_pending' ) ) )]"
								text_label_left = { text = "RRF_RESULT_PENDING" }
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8
									datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_pending' )]"
									item = { rrf_result_character = {} }
								}
							}
						}
					}
				}
			}
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 12
			button_standard = {
				text = "RRF_RESULT_CLOSE"
				onclick = "[GetScriptedGui( 'rrf_close_result_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			expand = {}
			button_standard = {
				text = "RRF_REFRESH_RESULT"
				enabled = "[GetScriptedGui( 'rrf_refresh_result_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "RRF_REFRESH_RESULT_TT"
				onclick = "[GetScriptedGui( 'rrf_refresh_result_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_primary = {
				text = "RRF_INVITE_VASSALS"
				enabled = "[GetScriptedGui( 'rrf_invite_vassals_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "[Localize( 'RRF_INVITE_VASSALS_TT' )] [GetScriptedGui( 'rrf_invite_vassals_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui( 'rrf_invite_vassals_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
	}
}

types rrf_result_types {
	type rrf_result_character = hbox {
		datacontext = "[Scope.Char]"
		layoutpolicy_horizontal = expanding
		minimumsize = { 0 90 }
		spacing = 12
		portrait_head_small = {}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_multi = { layoutpolicy_horizontal = expanding max_width = 330 autoresize = yes text = "[Character.GetUINameNoTooltip]" default_format = "#high" }
			text_multi = { layoutpolicy_horizontal = expanding max_width = 330 autoresize = yes text = "[Character.GetRite.GetNameNoTooltip]" default_format = "#weak" }
		}
	}
}

