# The native draft edits the one already-created result.
widget = {
	name = "rrf_native_setup_launcher"
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[And( Not( IsGameViewOpen( 'rite_creation' ) ), GetScriptedGui( 'rrf_native_launch_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
	state = {
		name = _show
		on_start = "[GetScriptedGui( 'rrf_native_open_ack_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		on_start = "[OpenGameViewData( 'rite_creation', GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).Rite )]"
	}
}

window = {
	name = "rrf_result_window"
	parentanchor = center
	size = { 1300 950 }
	layer = middle
	movable = yes
	visible = "[And( GetPlayer.IsValid, GetScriptedGui( 'rrf_result_window_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
	datacontext = "[GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).Rite]"
	using = Window_Background
	using = Window_Decoration
	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }
	vbox = {
		using = Window_Margins
		spacing = 12
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" { text = "RRF_RESULT_COMPLETE_TITLE" }
			blockoverride "button_close" {
				onclick = "[GetScriptedGui( 'rrf_close_result_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		text_multi = { text = "RRF_RESULT_COMPLETE_GUIDANCE" max_width = 1200 autoresize = yes }
		text_multi = {
			visible = "[GetScriptedGui( 'rrf_final_configuration_invalid_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			text = "RRF_FINAL_CONFIGURATION_INVALID_DESC"
			max_width = 1200
			autoresize = yes
			default_format = "#N"
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 16
			vbox = {
				size = { 410 100% }
				spacing = 12
				hbox = {
					spacing = 12
					button_rite_icon = { size = { 80 80 } }
					text_multi = { text = "[Rite.GetNameNoTooltip]" max_width = 300 autoresize = yes using = Font_Size_Big default_format = "#high" }
				}
				text_label_left = { text = "RITE_CREATION_VIEW_NAMING_ADJECTIVE" }
				text_multi = { text = "[Rite.GetAdjectiveNoTooltip]" max_width = 400 autoresize = yes }
				text_label_left = { text = "RITE_CREATION_VIEW_NAMING_FOLLOWER" }
				text_multi = { text = "[Rite.GetAdherentNameNoTooltip]" max_width = 400 autoresize = yes }
				text_label_left = { text = "RITE_CREATION_VIEW_NAMING_FOLLOWERS" }
				text_multi = { text = "[Rite.GetAdherentNamePluralNoTooltip]" max_width = 400 autoresize = yes }
				divider = { layoutpolicy_horizontal = expanding }
				button_primary = {
					visible = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					layoutpolicy_horizontal = expanding
					text = "RRF_RESUME_SETUP"
					tooltip = "RRF_RESUME_SETUP_TT"
					onclick = "[GetScriptedGui( 'rrf_resume_native_setup_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				text_label_left = { text = "RRF_FINAL_CORE_PREVIEW" }
				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							datacontext = "[Rite.GetFaith]"
							spacing = 6
							datamodel = "[Rite.GetTenets]"
							item = {
								hbox = {
									spacing = 8
									proportional_icon = { size = { 32 40 } texture = "[TenetType.GetIcon( Faith.Self )]" tooltipwidget = { using = tenet_type_tooltip } }
									text_multi = { text = "[TenetType.GetNameNoTooltip( Rite.Self )]" max_width = 330 autoresize = yes }
								}
							}
						}
					}
				}
			}
			divider = { layoutpolicy_vertical = expanding }
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_background" { background = { using = Background_Area alpha = 0.75 } }
				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 12 10 }
						spacing = 10
						text_label_left = { text = "RRF_RESULT_FAMILY" }
						vbox = {
							layoutpolicy_horizontal = expanding
							datamodel = "[GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).GetList( 'rrf_expected_family' )]"
							item = { rrf_result_character = {} }
						}
						text_multi = {
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.Var( 'rrf_last_result_rite' ).GetList( 'rrf_expected_family' ) )]"
							text = "RRF_RESULT_EMPTY" max_width = 720 autoresize = yes default_format = "#weak"
						}
						vbox = {
							visible = "[GetScriptedGui( 'rrf_configured_result_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							layoutpolicy_horizontal = expanding
							spacing = 10
							divider = { layoutpolicy_horizontal = expanding }
							text_label_left = { text = "RRF_RESULT_ACCEPTS" }
							vbox = { datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_converts' )]" item = { rrf_result_character = {} } }
							text_label_left = { text = "RRF_RESULT_PLAYERS" }
							vbox = { datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_players' )]" item = { rrf_result_character = {} } }
							text_label_left = { text = "RRF_RESULT_DECLINES" }
							vbox = { datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_declines' )]" item = { rrf_result_character = {} } }
							text_label_left = { text = "RRF_RESULT_INELIGIBLE" }
							vbox = { datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_ineligible' )]" item = { rrf_result_character = {} } }
							divider = { layoutpolicy_horizontal = expanding }
							text_label_left = { text = "RRF_RESULT_CONVERTED" }
							vbox = { datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_converted' )]" item = { rrf_result_character = {} } }
							text_label_left = { text = "RRF_RESULT_PENDING" }
							vbox = { datamodel = "[GetPlayer.MakeScope.GetList( 'rrf_vassal_pending' )]" item = { rrf_result_character = {} } }
						}
					}
				}
			}
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 12
			button_standard = {
				text = "RRF_RESULT_CLOSE"
				onclick = "[GetScriptedGui( 'rrf_close_result_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			expand = {}
			button_standard = {
				text = "RRF_REFRESH_RESULT"
				enabled = "[GetScriptedGui( 'rrf_refresh_result_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "RRF_REFRESH_RESULT_TT"
				onclick = "[GetScriptedGui( 'rrf_refresh_result_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_primary = {
				text = "RRF_INVITE_VASSALS"
				enabled = "[GetScriptedGui( 'rrf_invite_vassals_gui' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "[Localize( 'RRF_INVITE_VASSALS_TT' )] [GetScriptedGui( 'rrf_invite_vassals_gui' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui( 'rrf_invite_vassals_gui' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
	}
}

types rrf_result_types {
	type rrf_result_character = hbox {
		datacontext = "[Scope.Char]"
		layoutpolicy_horizontal = expanding
		spacing = 12
		portrait_head_small = {}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = { text = "[Character.GetUINameNoTooltip]" default_format = "#high" }
			text_single = { text = "[Character.GetRite.GetNameNoTooltip]" default_format = "#weak" }
		}
	}
}

