window = {
	name = "court_window"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	allow_outside = yes

	using = Window_Size_MainTab

	datacontext = "[GetVariableSystem]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab

		on_start = "[GetVariableSystem.Set( 'council_tabs', 'my_council' )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	margin_widget = {
		size = { 100% 100% }
		margin_top = 30
		margin_bottom = 20
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "COURT_WINDOW_TITLE"
					}

					blockoverride "button_close"
					{
						onclick = "[CourtWindow.Close]"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding

					button_tab = {
						name = "court_positions_tab_button_tutorial_uses_this"
						shortcut = "tab_1"

						onclick = "[CourtWindow.SetShowPositions]"
						down = "[CourtWindow.IsShowPositions]"

						alwaystransparent = "[CourtWindow.IsShowPositions]"

						blockoverride "tab_label"
						{
							text = COURT_WINDOW_COURT_POSITIONS
							max_width = 110
						}

						blockoverride "icon_visible" {}

						blockoverride "tab_icon"
						{
							texture = "gfx/interface/icons/flat_icons/court_position.dds"
							down = "[CourtWindow.IsShowPositions]"
							size = { 37 37 }
						}

						blockoverride "extra_info"
						{
							text_single = {
								text = "[GetDataModelSize(CourtWindow.GetCourtOwner.GetEmployedCourtPositions)]"
								align = nobaseline
								default_format = "#low"

								margin_top = 3

								alpha = "[Select_float( GreaterThan_int32(GetDataModelSize(CourtWindow.GetCourtOwner.GetEmployedCourtPositions), '(int32)0'), '(float)1.0', '(float)0.5' )]"
							}
						}
					}

					button_tab = {
						onclick = "[CourtWindow.SetShowCourt]"
						down = "[CourtWindow.IsShowCourt]"
						shortcut = "tab_2"

						alwaystransparent = "[CourtWindow.IsShowCourt]"

						blockoverride "tab_label"
						{
							text = "COURT_WINDOW_YOUR_COURTIERS"
							max_width = 130
						}

						blockoverride "icon_visible" {}

						blockoverride "tab_icon"
						{
							texture = "gfx/interface/icons/flat_icons/three_people.dds"
							size = { 37 37 }
							down = "[CourtWindow.IsShowCourt]"
						}
					}

					button_tab = {
						layoutpolicy_horizontal = expanding
						onclick = "[CourtWindow.SetShowPrison]"
						down = "[CourtWindow.IsShowPrison]"
						shortcut = "tab_3"

						alwaystransparent = "[CourtWindow.IsShowPrison]"

						blockoverride "tab_label"
						{
							text = "INTRIGUE_WINDOW_PRISONERS"
							max_width = 100
							alpha = "[Select_float( GreaterThan_int32(CourtWindow.GetPrisoners.GetTotalNumber, '(int32)0'), '(float)1.0', '(float)0.5' )]"
						}

						blockoverride "icon_visible" {}

						blockoverride "tab_icon"
						{
							texture = "gfx/interface/icons/flat_icons/prisoner.dds"
							size = { 37 37 }
							down = "[CourtWindow.IsShowPrison]"
							alpha = "[Select_float( GreaterThan_int32(CourtWindow.GetPrisoners.GetTotalNumber, '(int32)0'), '(float)1.0', '(float)0.5' )]"
						}

						blockoverride "extra_info"
						{
							text_single = {
								text = "[CourtWindow.GetPrisoners.GetTotalNumber]"
								align = nobaseline
								default_format = "#low"

								margin_top = 3

								alpha = "[Select_float( GreaterThan_int32(CourtWindow.GetPrisoners.GetTotalNumber, '(int32)0'), '(float)1.0', '(float)0.5' )]"
							}
						}
					}
				}

				##### YOUR COURTIERS #####
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[CourtWindow.IsShowCourt]"

					using = Animation_Tab_Switch

					vbox = {
						name = "court"

						vbox = {
							visible = "[Not(IsDataModelEmpty(GetPlayer.GetCourt))]"
							layoutpolicy_horizontal = expanding
							spacing = 15
							margin_top = 15

							hbox = {
								spacing = 10

								button_decision_entry = {
									name = "invite_knights_decision"
									datacontext = "[GetDecisionWithKey('invite_knights_decision')]"
									visible = "[Decision.IsShownForPlayer]"

									onclick = "[OpenGameViewData( 'decision_detail', Decision.Self)]"
									using = tooltip_se

									blockoverride "button_size"
									{
										size = { 210 30 }
									}
								}

								button_decision_entry = {
									name = "invite_claimants_decision"
									datacontext = "[GetDecisionWithKey('invite_claimants_decision')]"
									visible = "[Decision.IsShownForPlayer]"

									onclick = "[OpenGameViewData( 'decision_detail', Decision.Self)]"
									using = tooltip_se

									blockoverride "button_size"
									{
										size = { 210 30 }
									}
								}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 5

								text_label_center = {
									text = "COUNCIL_WINDOW_GUESTS_AND_COURTIERS"
									layoutpolicy_horizontal = expanding
									autoresize = no
								}

								vbox_character_list = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									minimumsize = { -1 800 }
									datacontext = "[CourtWindow.GetCourt]"

									blockoverride "sort_dropdown" {
										dropdown_sort_characterlist = {
											name = "court_sort_options"
										}
									}

									blockoverride "scrollbox_empty_visibility"
									{
										layoutpolicy_vertical = expanding
										visible = "[And(Not(CharacterSelectionList.IsBuildingList), IsDataModelEmpty(CharacterSelectionList.GetList) )]"
										text = "COURT_WINDOW_NO_GUESTS_OR_COURTIERS"
									}

									blockoverride "container_implementation" {
										fixedgridbox = {
											name = "characters_grid"
											datamodel = "[CharacterSelectionList.GetList]"
											visible = "[Not(CharacterSelectionList.IsBuildingList)]"
											addcolumn = 520
											addrow = 130
											setitemsizefromcell = yes

											item = {
												widget_courtier_item = {
													datacontext = "[CharacterListItem.GetCharacter]"

													blockoverride "description_relation_text" {
														text = "[SelectLocalization(Character.IsGuest, Character.GetRelationAndGuestDesc, Character.GetRelationToString(GetPlayer.Self))]"
														tooltip = "EXTENDED_RELATIONS_TOOLTIP"
													}
												}
											}
										}
									}
								}
							}
						}

						expand = {
							layoutpolicy_vertical = expanding
						}
					}
				}

				## POSITONS
				vbox_court_positions = {
					name = "court_positions_subtab_tutorial_uses_this"
					widgetid = "court_positions_subtab_tutorial_uses_this"
					datacontext = "[CourtWindow.AccessCourtPositionWindow]"
					visible = "[CourtWindow.IsShowPositions]"

					using = Animation_Tab_Switch

					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
				}

				## PRISONERS
				vbox = {
					datacontext = "[CourtWindow.GetPrisoners]"
					visible = "[CourtWindow.IsShowPrison]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					using = Animation_Tab_Switch

					state = {
						name = _show
						using = Animation_FadeIn_Quick
					}

					state = {
						name = _hide
						alpha = 0
					}

					vbox = {
						visible = "[LessThanOrEqualTo_int32( CharacterSelectionList.GetTotalNumber, '(int32)0' )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 0 15 }
						margin_left = 10

						expand = {}

						text_multi = {
							text = "PRISON_EMPTY"
							default_format = "#weak"
							autoresize = yes
							max_width = 400
						}

						expand = {}

						divider = {
							size = { 0 5 }
							layoutpolicy_horizontal = expanding
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							margin_top = 7
							margin_left = 15
							margin_bottom = -7

							hbox_mass_prison_actions = {}

							expand = {}
						}
					}

					background = {
						visible = "[LessThanOrEqualTo_int32( CharacterSelectionList.GetTotalNumber, '(int32)0' )]"
						texture = "gfx/interface/skinned/illustrations/dungeon.dds"
						fittype = centercrop
						framesize = { 700 800 }
						frame = 2

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					background = {
						visible = "[GreaterThan_int32( CharacterSelectionList.GetTotalNumber, '(int32)0' )]"
						texture = "gfx/interface/skinned/illustrations/dungeon.dds"
						fittype = end
						alpha = 0.4

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					## Layout with more than MAX_PRISONER_COUNT_GRID(4) prisoners
					vbox_character_list = {
						visible = "[GreaterThan_int32( CourtWindow.GetPrisoners.GetTotalNumber, GetDefine( 'NGui', 'MAX_PRISONER_COUNT_GRID' ) )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "container_implementation"
						{
							fixedgridbox = {
								name = "characters_grid"
								datamodel = "[CharacterSelectionList.GetList]"
								visible = "[Not(CharacterSelectionList.IsBuildingList)]"
								layoutpolicy_horizontal = expanding
								addcolumn = 530
								addrow = 148
								datamodel_reuse_widgets = yes

								item = {
									vbox = {
										maximumsize = { 530 148 }

										widget_character_list_item_finder = {
											layoutpolicy_horizontal = expanding
											blockoverride "divider" {}
											blockoverride "character_relation" {}
											blockoverride "character_name_width" {
												max_width = 200
											}

											blockoverride "gridbox_items"
											{
												datamodel_wrap = 4
												maxverticalslots = 2
											}
										}

										hbox = {
											name = "prisoner_data"
											layoutpolicy_horizontal = expanding
											margin = { 8 4 }
											spacing = 5

											background = {
												using = Background_Area_Dark
												alpha = 0.5
											}

											hbox = {
												name = "info_text"
												layoutpolicy_horizontal = expanding
												layoutpolicy_vertical = expanding

												spacing = 8

												text_single = {
													name = "type"
													layoutpolicy_horizontal = expanding
													text = "[CharacterListItem.GetText('tooltip')]"
													default_format = "#low"
													autoresize = no
													align = nobaseline
												}

												text_single = {
													name = "imprisoned_time"
													layoutpolicy_horizontal = expanding
													text = "[CharacterListItem.GetText('imprisoned_time')]"
													autoresize = no
													align = nobaseline
													default_format = "#low"
												}
											}

											button_checkbox = {
												name = "lock_from_mass_actions"
												checked = "[CharacterListItem.GetBool('is_mass_action_locked')]"
												onclick = "[CharacterListItem.OnClick('mass_action_lock')]"
												tooltip = "[CharacterListItem.GetText('mass_action_lock_tooltip')]"
											}

											prison_interactions_hbox = {}
										}
									}
								}
							}
						}

						blockoverride "bottom_bar"
						{
							hbox_mass_prison_actions = {}
						}
					}

					## Layout with MAX_PRISONER_COUNT_GRID(4) or fewer prisoners
					vbox = {
						visible = "[And( GreaterThan_int32( CourtWindow.GetPrisoners.GetTotalNumber, '(int32)0' ), LessThanOrEqualTo_int32( CourtWindow.GetPrisoners.GetTotalNumber, GetDefine( 'NGui', 'MAX_PRISONER_COUNT_GRID' ) ) )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 0 15 }
						margin_left = 10

						fixedgridbox = {
							datamodel = "[CharacterSelectionList.GetList]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							addcolumn = 262
							addrow = 405
							datamodel_wrap = 2
							flipdirection = yes

							item = {
								widget = {
									size = { 262 395}
									datacontext = "[CharacterListItem.GetCharacter]"

									background = {
										texture = "gfx/interface/skinned/illustrations/dungeon.dds"
										margin = { -5 0 }
										fittype = centercrop
										alpha = 0.3

										using = Mask_Rough_Edges
									}

									background = {
										using = Background_Frame
										alpha = 0.5
									}

									widget = {
										size = { 100% 100% }
										scissor = yes

										portrait_body = {
											parentanchor = bottom|hcenter
											position = { 0 -70 }

											blockoverride "coa" {}
											blockoverride "opinion_box" {}
											blockoverride "status_icons" {}
										}
									}

									vbox = {
										expand = {}

										hbox = {
											layoutpolicy_horizontal = expanding
											margin = { 5 5 }

											expand = {}

											hbox = {
												spacing = 5

												background = {
													using = Background_Area
												}

												vbox = {
													margin_bottom = 3

													expand = {}

													portrait_status_icons = {}
												}

												vbox = {
													layoutpolicy_vertical = expanding

													expand = {}

													coa_realm_tiny_crown = {
														visible = "[Character.HasLandedTitles]"
													}

													portrait_opinion = {}
												}
											}
										}

										vbox = {
											layoutpolicy_horizontal = expanding
											margin = { 5 5 }

											background = {
												using = Background_Area
												margin_bottom = 3
											}

											text_single = {
												text = "[Character.GetShortUINameNoTooltip]"
												default_format = "#high"
												using = Font_Size_Medium
											}

											text_single = {
												visible = "[Character.IsImprisoned]"
												name = "type"
												text = "[CharacterListItem.GetText('tooltip')]"
											}
										}

										spacer = {
											size = { 3 3 }
										}

										### Actions
										vbox = {
											name = "actions"
											layoutpolicy_horizontal = expanding
											visible = "[And( CharacterListItem.GetCharacter.IsAlive, CharacterListItem.GetCharacter.IsImprisoned )]"
											spacing = 10
											margin = { 10 5 }
											margin_bottom = 15

											background = {
												using = Background_Area_Dark
											}

											hbox = {
												spacing = 5

												icon = {
													texture = "gfx/interface/icons/portraits/punishment.dds"
													size = { 20 20 }
												}

												text_single = {
													name = "imprisoned_time"
													layoutpolicy_horizontal = expanding
													text = "[CharacterListItem.GetText('imprisoned_time')]"
												}
											}

											prison_interactions_hbox = {}
										}
									}
								}
							}
						}

						divider = {
							size = { 0 5 }
							layoutpolicy_horizontal = expanding
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							margin_top = 7
							margin_left = 15
							margin_bottom = -7

							hbox_mass_prison_actions = {}

							expand = {}
						}
					}
				}
			}
		}
	}

	# 【1. 批量吞噬二次确认弹窗】
	widget = {
		name = "mass_devour_confirm_modal"
		parentanchor = center
		position = { -720 -50 }
		size = { 480 200 }
		visible = "[GetVariableSystem.Exists('mass_devour_confirm')]"
		datacontext = "[GetScriptedGui('mass_devour_all_prisoners')]"
		alwaystransparent = no

		background = {
			using = Background_Area_Solid
			margin = { 5 5 }
		}
		background = {
			texture = "gfx/interface/component_tiles/tile_background_window.dds"
			spriteType = Corneredtiled
			spriteborder = { 80 80 }
			margin = { 2 2 }
			texture_density = 2
		}
		background = {
			using = Background_Frame
			margin = { 2 2 }
		}

		vbox = {
			margin = { 20 15 }
			margin_bottom = 20

			header_standard = {
				layoutpolicy_horizontal = expanding
				size = { 0 35 }
				
				blockoverride "header_text"
				{
					text = "mass_devour_title"
					align = center
				}
				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('mass_devour_confirm')]"
				}
			}

			spacer = { size = { 0 15 } }

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5

				text_single = {
					text = "mass_devour_desc_1"
					default_format = "#high"
					align = center
				}

				text_single = {
					text = "mass_devour_desc_2"
					default_format = "#weak"
					align = center
				}
			}

			expand = {}

			hbox = {
				spacing = 25

				button_standard = {
					size = { 160 38 }
					text = "CANCEL"
					onclick = "[GetVariableSystem.Clear('mass_devour_confirm')]"
				}

				button_primary = {
					size = { 160 38 }
					text = "mass_devour_confirm"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Clear('mass_devour_confirm')]"
				}
			}
		}
	}

	# 【2. 饕餮手账主窗口】
	window = {
		name = "window_devour_ledger"
		parentanchor = center
		position = { -580 0 }
		size = { 700 1000 }
		layer = top
		visible = "[GetVariableSystem.Exists('devour_ledger_window_open')]"
		alwaystransparent = no
		movable = yes
		allow_outside = yes

		background = {
			using = Background_Area_Solid
		}
		background = {
			texture = "gfx/interface/component_tiles/tile_background_window.dds"
			spriteType = Corneredtiled
			spriteborder = { 80 80 }
			texture_density = 2
		}
		background = {
			using = Background_Frame
		}

		vbox = {
			margin = { 20 20 }
			spacing = 10

			header_standard = {
				layoutpolicy_horizontal = expanding
				blockoverride "header_text" {
					text = "devour_ledger_title"
				}
				blockoverride "button_close" {
					onclick = "[GetVariableSystem.Clear('devour_ledger_window_open')]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				text_single = {
					text = "devour_ledger_stat_prefix"
					default_format = "#high"
					align = nobaseline
				}
				text_single = {
					text = "#devour_gray [GetPlayer.MakeScope.Var('devour_count_commoner').GetValue|0]#!"
					align = nobaseline
				}
				text_single = {
					text = "devour_ledger_stat_commoner"
					default_format = "#high"
					align = nobaseline
				}
				text_single = {
					text = "#devour_white [GetPlayer.MakeScope.Var('devour_count_county').GetValue|0]#!"
					align = nobaseline
				}
				text_single = {
					text = "devour_ledger_stat_county"
					default_format = "#high"
					align = nobaseline
				}
				text_single = {
					text = "#devour_green [GetPlayer.MakeScope.Var('devour_count_duchy').GetValue|0]#!"
					align = nobaseline
				}
				text_single = {
					text = "devour_ledger_stat_duchy"
					default_format = "#high"
					align = nobaseline
				}
				text_single = {
					text = "#devour_blue [GetPlayer.MakeScope.Var('devour_count_kingdom').GetValue|0]#!"
					align = nobaseline
				}
				text_single = {
					text = "devour_ledger_stat_kingdom"
					default_format = "#high"
					align = nobaseline
				}
				text_single = {
					text = "#devour_purple [GetPlayer.MakeScope.Var('devour_count_empire').GetValue|0]#!"
					align = nobaseline
				}
				text_single = {
					text = "devour_ledger_stat_empire"
					default_format = "#high"
					align = nobaseline
				}

				expand = {}
			}

			divider_light = { layoutpolicy_horizontal = expanding }

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						text_single = {
							visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('devoured_ledger_list'))]"
							text = "devour_ledger_empty"
							default_format = "#low"
							margin = { 0 50 }
						}

						datamodel = "[GetPlayer.MakeScope.GetList('devoured_ledger_list')]"

						item = {
							widget = {
								layoutpolicy_horizontal = expanding
								size = { 620 40 }
								datacontext = "[Scope.GetCharacter]"

								background = {
									using = Background_Area_Dark
									alpha = 0.7
								}

								hbox = {
									margin = { 10 0 }

									# 1. 名字（固定宽 170，靠左贴边）
									widget = {
										size = { 170 40 }

										button_group = {
											parentanchor = left|vcenter
											onclick = "[DefaultOnCharacterClick(Character.GetID)]"
											tooltipwidget = {
												character_tooltip = {}
											}
											using = tooltip_se

											text_single = {
												text = "#underline;color_yellow [Character.GetShortUIName]#!"
												align = nobaseline
												max_width = 160
											}
										}
									}

									# 2. 基础属性与特质无缝连缀（自定义 devour_gold 纯金高亮）
									widget = {
										size = { 260 40 }

										flowcontainer = {
											parentanchor = center
											direction = horizontal
											ignoreinvisible = yes
											spacing = 0

											# 基础属性
											text_single = {
												visible = "[Character.HasTrait(GetTrait('devour_stat_5'))]"
												text = "devour_stat_5_label"
												align = nobaseline
											}
											text_single = {
												visible = "[Character.HasTrait(GetTrait('devour_stat_4'))]"
												text = "devour_stat_4_label"
												align = nobaseline
											}
											text_single = {
												visible = "[Character.HasTrait(GetTrait('devour_stat_3'))]"
												text = "devour_stat_3_label"
												align = nobaseline
											}
											text_single = {
												visible = "[Character.HasTrait(GetTrait('devour_stat_2'))]"
												text = "devour_stat_2_label"
												align = nobaseline
											}
											text_single = {
												visible = "[Not(Or(Character.HasTrait(GetTrait('devour_stat_5')), Or(Character.HasTrait(GetTrait('devour_stat_4')), Or(Character.HasTrait(GetTrait('devour_stat_3')), Character.HasTrait(GetTrait('devour_stat_2'))))))]"
												text = "devour_stat_1_label"
												align = nobaseline
											}

											# 遗传特质（自定义纯金色）
											text_single = { visible = "[Character.HasTrait(GetTrait('intellect_good_3'))]" text = "#devour_gold +天才#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('intellect_good_2'))]" text = "#devour_gold +聪慧#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('intellect_good_1'))]" text = "#devour_gold +敏锐#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('physique_good_3'))]" text = "#devour_gold +海格力斯#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('physique_good_2'))]" text = "#devour_gold +健壮#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('physique_good_1'))]" text = "#devour_gold +硬朗#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('beauty_good_3'))]" text = "#devour_gold +倾国倾城#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('beauty_good_2'))]" text = "#devour_gold +貌美如花#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('beauty_good_1'))]" text = "#devour_gold +眉清目秀#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('pure_blooded'))]" text = "#devour_gold +纯血#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('fecund'))]" text = "#devour_gold +多产#!" align = nobaseline }

											# 将领特质（自定义纯金色）
											text_single = { visible = "[Character.HasTrait(GetTrait('military_engineer'))]" text = "#devour_gold +攻城专家#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('organizer'))]" text = "#devour_gold +组织者#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('logistician'))]" text = "#devour_gold +后勤专家#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('flexible_leader'))]" text = "#devour_gold +灵活将领#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('aggressive_attacker'))]" text = "#devour_gold +进攻者#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('unyielding_defender'))]" text = "#devour_gold +防御者#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('cautious_leader'))]" text = "#devour_gold +谨慎将领#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('reckless'))]" text = "#devour_gold +鲁莽#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('holy_warrior'))]" text = "#devour_gold +虔信之剑#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('forder'))]" text = "#devour_gold +涉水者#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('open_terrain_expert'))]" text = "#devour_gold +开阔专家#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('rough_terrain_expert'))]" text = "#devour_gold +崎岖专家#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('forest_fighter'))]" text = "#devour_gold +森林斗士#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('desert_warrior'))]" text = "#devour_gold +沙漠战士#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('jungle_stalker'))]" text = "#devour_gold +丛林追猎#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('winter_soldier'))]" text = "#devour_gold +冬将军#!" align = nobaseline }
											text_single = { visible = "[Character.HasTrait(GetTrait('reaver'))]" text = "#devour_gold +劫掠者#!" align = nobaseline }
										}
									}

									# 3. 食用日期（固定宽 170，靠右贴边）
									widget = {
										size = { 170 40 }

										text_single = {
											parentanchor = right|vcenter
											text = "devour_eaten_date"
											default_format = "#high"
											align = nobaseline
										}
									}
								}
							}
						}
					}
				}
			}

			button_standard = {
				size = { 140 36 }
				text = "devour_ledger_close"
				onclick = "[GetVariableSystem.Clear('devour_ledger_window_open')]"
			}
		}
	}
}

types PrisonTypes
{
	type prison_interactions_hbox = hbox {
		spacing = 1

		button_round  = {
			name = "ransom"
			enabled = "[CharacterListItem.GetBool('can_ransom')]"

			button_prison_ransom = {
				parentanchor = center
				onclick = "[CharacterListItem.OnClick('ransom')]"
				enabled = "[CharacterListItem.GetBool('can_ransom')]"
				tooltip = "[CharacterListItem.GetText('ransom_tooltip')]"
				using = tooltip_se
			}
		}

		button_round  = {
			name = "release"
			enabled = "[CharacterListItem.GetBool('can_release')]"

			button_prison_release = {
				parentanchor = center
				onclick = "[CharacterListItem.OnClick('release')]"
				enabled = "[CharacterListItem.GetBool('can_release')]"
				tooltip = "[CharacterListItem.GetText('release_tooltip')]"
				using = tooltip_se
			}
		}

		button_round  = {
			name = "execute"
			enabled = "[CharacterListItem.GetBool('can_execute')]"

			button_prison_execute = {
				parentanchor = center
				onclick = "[CharacterListItem.OnClick('execute')]"
				enabled = "[CharacterListItem.GetBool('can_execute')]"
				tooltip = "[CharacterListItem.GetText('execute_tooltip')]"
				using = tooltip_se
			}
		}

		divider_light = {
			layoutpolicy_vertical = expanding
		}

		button_round = {

			datacontext = "[CharacterListItem.GetCharacter]"

			tooltip = "PRISON_INTERACTIONS_BUTTON_TOOLTIP"
			tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, 'interaction_category_prison'))]"
			using = tooltip_se

			onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'interaction_category_prison')]"

			button_icon = {
				alwaystransparent = yes
				parentanchor = center
				size = { 30 30 }
				texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
			}
		}
	}
	
	type hbox_mass_prison_actions = hbox {
		margin = { 10 0 }
		spacing = 3

		text_single = {
			text = "MASS_PRISONER_ACTIONS"
			default_format = "#low"
			align = nobaseline
		}

		spacer = {
			size = { 5 5 }
		}

		# 1. 批量赎金
		button_round  = {
			name = "ransom"
			enabled = "[CourtWindow.CanDoMassPrisonerAction('ransom')]"

			button_prison_ransom = {
				shortcut = "sub_tab_1"
				parentanchor = center
				onclick = "[CourtWindow.MassPrisonerAction('ransom')]"
				tooltip = "[CourtWindow.GetMassPrisonerActionTooltip('ransom')]"
				using = tooltip_se
			}
		}

		# 2. 批量释放
		button_round  = {
			name = "release"
			enabled = "[CourtWindow.CanDoMassPrisonerAction('release')]"

			button_prison_release = {
				shortcut = "sub_tab_2"
				parentanchor = center
				onclick = "[CourtWindow.MassPrisonerAction('release')]"
				tooltip = "[CourtWindow.GetMassPrisonerActionTooltip('release')]"
				using = tooltip_se
			}
		}

		# 3. 批量斩首
		button_round  = {
			name = "execute"
			enabled = "[CourtWindow.CanDoMassPrisonerAction('execute')]"

			button_prison_execute = {
				shortcut = "sub_tab_3"
				parentanchor = center
				onclick = "[CourtWindow.MassPrisonerAction('execute')]"
				tooltip = "[CourtWindow.GetMassPrisonerActionTooltip('execute')]"
				using = tooltip_se
			}
		}

		# 【第 4 个按钮：批量吞噬】
		button_round = {
			name = "mass_devour"
			datacontext = "[GetScriptedGui('mass_devour_all_prisoners')]"
			visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			tooltip = "mass_devour_button_tooltip"
			using = tooltip_se
			onclick = "[GetVariableSystem.Toggle('mass_devour_confirm')]"

			button_icon = {
				alwaystransparent = yes
				parentanchor = center
				size = { 26 26 }
				texture = "gfx/interface/icons/traits/cannibal.dds"
			}
		}

		# 【第 5 个按钮：随时打开饕餮手账】
		button_round = {
			name = "open_ledger_btn"
			tooltip = "devour_ledger_button_tooltip"
			using = tooltip_se
			onclick = "[GetScriptedGui('refresh_devour_counts').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			onclick = "[GetVariableSystem.Toggle('devour_ledger_window_open')]"

			button_icon = {
				alwaystransparent = yes
				parentanchor = center
				size = { 26 26 }
				texture = "gfx/interface/icons/flat_icons/history.dds"
			}
		}
	}
}