<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.xar.ck3.control</groupId><artifactId>ck3-control-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>g2-research</artifactId>
  <description>Pure source-bound G2 research composition for the existing single Quarkus host.</description>
  <dependencies>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>contracts</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>admission-contracts</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-governance</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave3-governance</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>planning-runtime</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-planning</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave3-planning</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-development</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave3-development</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-finance</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>finance-policy</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>war-budget</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>war-policy</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-military</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-prisoners</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>event-policy</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-events</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>wave2-runtime</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.xar.ck3.control</groupId><artifactId>ck3-control-build-tools</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>../event-policy/src/test/resources</directory><includes><include>mandatorychoice/producer-golden-v1.json</include></includes></testResource>
      <testResource>
        <directory>../wave2-events/src/test/resources</directory>
        <includes>
          <include>unhandledevent/*.json.gz</include>
          <include>interactionbefore/*.json.gz</include>
          <include>interactionreceipt/*.json.gz</include>
        </includes>
      </testResource>
      <testResource><directory>../wave2-planning/src/test/resources</directory><includes><include>jointintake/producer-golden-v1.json.gz</include></includes></testResource>
      <testResource><directory>../war-policy/src/test/resources</directory><includes><include>org/xar/ck3/control/warpolicy/war_outcome_stakes_golden_v1.jsonl</include></includes></testResource>
          <testResource><directory>../wave2-events/src/test/resources</directory><includes><include>interactionreceipt/legacy-producer-golden-v1.json</include></includes></testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*NativeIT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
