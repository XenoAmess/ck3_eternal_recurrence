<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.xar.ck3.control</groupId>
  <artifactId>ck3-control-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CK3 Control</name>
  <description>Typed control contracts and a local, side-effect-free Quarkus adapter.</description>

  <modules>
    <module>contracts</module>
    <module>continuity-core</module>
    <module>governance-policy</module>
    <module>wave2-governance</module>
    <module>closed-failure-recovery</module>
    <module>admission-contracts</module>
    <module>late-outcome-reconciliation</module>
    <module>build-tools</module>
    <module>wave2-runtime</module>
    <module>wave2-development</module>
    <module>wave3-governance</module>
    <module>planning-runtime</module>
    <module>finance-policy</module>
    <module>campaign-score</module>
    <module>war-budget</module>
    <module>wave2-finance</module>
    <module>wave2-planning</module>
    <module>military-policy</module>
    <module>war-policy</module>
    <module>replenishment-policy</module>
    <module>wave2-military</module>
    <module>wave3-planning</module>
    <module>g2-research</module>
    <module>local-service</module>
    <module>native-diagnostics</module>
    <module>event-policy</module>
    <module>wave2-events</module>
    <module>wave2-prisoners</module>
    <module>wave3-development</module>
    <module>wave3-runtime</module>
    <module>wave3-military</module>
    <module>adapters-storage</module>
    <module>application</module>
    <module>native-transport</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-10-22T00:00:00Z</project.build.outputTimestamp>
    <ck3.build.root>${maven.multiModuleProjectDirectory}/target/ck3-control</ck3.build.root>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
    <jna.version>5.19.1</jna.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna-platform</artifactId>
        <version>${jna.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <directory>${ck3.build.root}/${project.artifactId}</directory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>${quarkus.platform.group-id}</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>xar-compile-diagnostics</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>-XDshould-stop.ifError=FLOW</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
