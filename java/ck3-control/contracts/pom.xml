  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <xar.legacy.windows.python>${xar.legacy.windows.python}</xar.legacy.windows.python>
            <xar.legacy.windows.riteSource>${xar.legacy.windows.riteSource}</xar.legacy.windows.riteSource>
