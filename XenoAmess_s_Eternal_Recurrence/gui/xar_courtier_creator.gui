# Paid custom courtier creator. The transparent root prevents invalid-player
# evaluations; only the gated child modal captures input.
types XARCourtierCreatorTypes {
	type xar_cc_action_button = button_standard {
		min_width = 72
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}

	type xar_cc_numeric_row = hbox {
		layoutpolicy_horizontal = expanding
		size = { 0 48 }
		spacing = 8

		block "numeric_icon" {
			spacer = { size = { 38 38 } }
		}

		text_single = {
			min_width = 150
			max_width = 150
			align = nobaseline
			default_format = "#high"
			block "numeric_label" { raw_text = "-" }
		}

		progressbar_standard = {
			layoutpolicy_horizontal = expanding
			min_width = 420
			max_width = 610
			size = { 0 26 }
			min = 0
			block "numeric_max" { max = 100 }
			block "numeric_value" { value = 0 }

			text_single = {
				parentanchor = center
				align = center|nobaseline
				default_format = "#V"
				using = Font_Size_Medium
				block "numeric_text" { raw_text = "0" }
			}
		}

		block "numeric_actions" {}
	}

	type xar_cc_trait_catalog_grid = dynamicgridbox {
		layoutpolicy_horizontal = expanding
		datamodel_wrap = 4
		flipdirection = yes
		ignoreinvisible = yes

		item = {
			container = {
				datacontext = "[Scope.Trait]"

				button_standard_hover = {
					size = { 334 64 }
					parentanchor = center
					enabled = "[GetScriptedGui('xar_cc_toggle_trait_gui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'trait', Trait.MakeScope ).End )]"
					onclick = "[GetScriptedGui('xar_cc_toggle_trait_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'trait', Trait.MakeScope ).End )]"
					down = "[GetScriptedGui('xar_cc_trait_selected_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'trait', Trait.MakeScope ).End )]"

					hbox = {
						margin = { 7 5 }
						spacing = 8

						# Keep the native widget untouched so its complete trait tooltip survives.
						icon_trait = {}

						text_single = {
							layoutpolicy_horizontal = expanding
							max_width = 205
							text = "[Trait.GetNameNoTooltip( Character.Self )]"
							default_format = "#clickable"
							autoresize = no
							scissor = yes
							align = nobaseline
						}

						expand = {}

						text_single = {
							min_width = 48
							text = "[Trait.GetRulerDesignerCost|=]"
							default_format = "#V"
							align = right|nobaseline
						}
					}
				}
			}
		}
	}

	type xar_cc_culture_catalog_list = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 8

		item = {
			vbox = {
				datacontext = "[Scope.Culture.GetHeritage]"
				layoutpolicy_horizontal = expanding
				spacing = 2

				text_single = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 28 }
					margin_left = 10
					text = "[CulturePillar.GetNameNoTooltip]"
					default_format = "#T"
					align = nobaseline
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[CulturePillar.GetCulturesWithPillar]"
					spacing = 2

					item = {
						hbox = {
							datacontext = "[Culture.GetTemplate]"
							layoutpolicy_horizontal = expanding

							button_standard_hover = {
								layoutpolicy_horizontal = expanding
								size = { 0 38 }
								enabled = "[GetScriptedGui('xar_cc_select_culture_gui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'culture', Culture.MakeScope ).End )]"
								onclick = "[GetScriptedGui('xar_cc_select_culture_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'culture', Culture.MakeScope ).End )]"
								down = "[GetScriptedGui('xar_cc_culture_selected_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'culture', Culture.MakeScope ).End )]"

								hbox = {
									margin_left = 50

									text_single = {
										layoutpolicy_horizontal = expanding
										margin = { 5 0 }
										text = "[Culture.GetNameNoTooltip]"
										default_format = "#clickable"
										align = nobaseline
										autoresize = no
										scissor = yes
									}

									expand = {}
								}
							}
						}
					}
			}
		}
	}
}

	type xar_cc_faith_catalog_list = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 3

		item = {
			hbox = {
				datacontext = "[Scope.Faith]"
				layoutpolicy_horizontal = expanding

				button_standard_hover = {
					name = "faith_item"
					layoutpolicy_horizontal = expanding
					size = { 0 52 }
					onclick = "[GetScriptedGui('xar_cc_select_faith_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'faith', Faith.MakeScope ).End )]"
					down = "[GetScriptedGui('xar_cc_faith_selected_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'faith', Faith.MakeScope ).End )]"

					hbox = {
						margin = { 8 3 }
						spacing = 10
						alwaystransparent = yes

						icon = {
							size = { 42 42 }
							texture = "[Faith.GetIcon]"
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "[Faith.GetName]"
							default_format = "#clickable"
							align = nobaseline
							autoresize = no
							scissor = yes
						}
					}
				}
			}
		}
	}
}

window = {
	name = "xar_courtier_creator_window"
	size = { 100% 100% }
	layer = confirmation
	visible = "[GetPlayer.IsValid]"
	alwaystransparent = yes

	widget = {
		name = "xar_courtier_creator_modal"
		size = { 100% 100% }
		visible = "[GetScriptedGui('xar_cc_window_gate_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		alwaystransparent = no
		filter_mouse = all
		using = Background_Full_Dim
		using = Animation_ShowHide_Quick

		state = {
			name = _show
			on_start = "[GetVariableSystem.Set('xar_cc_tab', 'basic')]"
		}
		state = {
			name = _hide
			on_finish = "[GetVariableSystem.Clear('xar_cc_tab')]"
		}

		button_normal = {
			size = { 100% 100% }
			onclick = "[GetScriptedGui('xar_cc_cancel_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		widget = {
			name = "xar_courtier_creator_panel"
			datacontext = "[GetPlayer]"
			size = { 1500 900 }
			parentanchor = center
			alwaystransparent = no
			filter_mouse = all
			using = Window_Background
			using = Window_Decoration_Spike

			vbox = {
				using = Window_Margins
				spacing = 8

				header_pattern = {
					layoutpolicy_horizontal = expanding
					blockoverride "header_text" {
						text = "[Localize('xar.cc.title')]"
					}
					blockoverride "button_close" {
						onclick = "[GetScriptedGui('xar_cc_cancel_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}
				}

				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					text = "[Localize('xar.cc.intro')]"
					fontsize = 16
					default_format = "#high"
					margin = { 20 0 }
				}

				hbox = {
					name = "xar_cc_tabs"
					layoutpolicy_horizontal = expanding

					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.basic')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'basic')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'basic')]"
					}
					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.education')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'education')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'education')]"
					}
					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.commander')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'commander')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'commander')]"
					}
					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.physical')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'physical')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'physical')]"
					}
					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.personality')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'personality')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'personality')]"
					}
					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.other')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'other')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'other')]"
					}
					button_tab = {
						layoutpolicy_horizontal = expanding
						text = "[Localize('xar.cc.tab.origin')]"
						onclick = "[GetVariableSystem.Set('xar_cc_tab', 'origin')]"
						down = "[GetVariableSystem.HasValue('xar_cc_tab', 'origin')]"
					}
				}

				vbox = {
					name = "xar_cc_basic_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'basic')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 6

					hbox = {
						layoutpolicy_horizontal = expanding
						size = { 0 46 }
						spacing = 8

						spacer = { size = { 38 38 } }
						text_single = {
							min_width = 150
							max_width = 150
							text = "[Localize('xar.cc.sex')]"
							default_format = "#high"
							align = nobaseline
						}
						button_standard = {
							min_width = 250
							text = "SEX_MALE"
							datacontext = "[GetScriptedGui('xar_cc_choose_male_gui')]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('xar_cc_female').GetValue, '(CFixedPoint)0' )]"
						}
						button_standard = {
							min_width = 250
							text = "SEX_FEMALE"
							datacontext = "[GetScriptedGui('xar_cc_choose_female_gui')]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('xar_cc_female').GetValue, '(CFixedPoint)1' )]"
						}
						expand = {}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_label" { text = "[Localize('xar.cc.age')]" }
						blockoverride "numeric_max" { max = 120 }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_age').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_age').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_age_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_age_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_age_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_age_plus_10_gui')]" }
						}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_icon" { icon = { texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 1 size = { 38 38 } } }
						blockoverride "numeric_label" { text = "[Localize('xar.cc.skill.diplomacy')]" }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_diplomacy').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_diplomacy').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_diplomacy_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_diplomacy_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_diplomacy_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_diplomacy_plus_10_gui')]" }
						}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_icon" { icon = { texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 2 size = { 38 38 } } }
						blockoverride "numeric_label" { text = "[Localize('xar.cc.skill.martial')]" }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_martial').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_martial').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_martial_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_martial_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_martial_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_martial_plus_10_gui')]" }
						}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_icon" { icon = { texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 3 size = { 38 38 } } }
						blockoverride "numeric_label" { text = "[Localize('xar.cc.skill.stewardship')]" }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_stewardship').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_stewardship').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_stewardship_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_stewardship_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_stewardship_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_stewardship_plus_10_gui')]" }
						}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_icon" { icon = { texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 4 size = { 38 38 } } }
						blockoverride "numeric_label" { text = "[Localize('xar.cc.skill.intrigue')]" }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_intrigue').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_intrigue').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_intrigue_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_intrigue_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_intrigue_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_intrigue_plus_10_gui')]" }
						}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_icon" { icon = { texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 5 size = { 38 38 } } }
						blockoverride "numeric_label" { text = "[Localize('xar.cc.skill.learning')]" }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_learning').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_learning').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_learning_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_learning_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_learning_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_learning_plus_10_gui')]" }
						}
					}

					xar_cc_numeric_row = {
						blockoverride "numeric_icon" { icon = { texture = "gfx/interface/icons/icon_prowess.dds" size = { 38 38 } } }
						blockoverride "numeric_label" { text = "[Localize('xar.cc.skill.prowess')]" }
						blockoverride "numeric_value" { value = "[GetPlayer.MakeScope.Var('xar_cc_prowess').GetValue]" }
						blockoverride "numeric_text" { raw_text = "[GetPlayer.MakeScope.Var('xar_cc_prowess').GetValue|0]" }
						blockoverride "numeric_actions" {
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_10')]" datacontext = "[GetScriptedGui('xar_cc_prowess_minus_10_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.minus_1')]" datacontext = "[GetScriptedGui('xar_cc_prowess_minus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_1')]" datacontext = "[GetScriptedGui('xar_cc_prowess_plus_1_gui')]" }
							xar_cc_action_button = { text = "[Localize('xar.cc.numeric.plus_10')]" datacontext = "[GetScriptedGui('xar_cc_prowess_plus_10_gui')]" }
						}
					}

					expand = {}
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.base_stats')]"
						default_format = "#low"
					}
				}

				vbox = {
					name = "xar_cc_education_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'education')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.education.help')]"
						default_format = "#high"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							xar_cc_trait_catalog_grid = {
								datamodel = "[GetPlayer.MakeScope.GetList('xar_cc_catalog_education')]"
							}
						}
					}
				}

				vbox = {
					name = "xar_cc_commander_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'commander')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.commander.help')]"
						default_format = "#high"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							xar_cc_trait_catalog_grid = {
								datamodel = "[GetPlayer.MakeScope.GetList('xar_cc_catalog_commander')]"
							}
						}
					}
				}

				vbox = {
					name = "xar_cc_physical_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'physical')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.physical.help')]"
						default_format = "#high"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							xar_cc_trait_catalog_grid = {
								datamodel = "[GetPlayer.MakeScope.GetList('xar_cc_catalog_physical')]"
							}
						}
					}
				}

				vbox = {
					name = "xar_cc_personality_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'personality')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.personality.help')]"
						default_format = "#high"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							xar_cc_trait_catalog_grid = {
								datamodel = "[GetPlayer.MakeScope.GetList('xar_cc_catalog_personality')]"
							}
						}
					}
				}

				vbox = {
					name = "xar_cc_other_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'other')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.other.help')]"
						default_format = "#high"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content" {
							xar_cc_trait_catalog_grid = {
								datamodel = "[GetPlayer.MakeScope.GetList('xar_cc_catalog_other')]"
							}
						}
					}
				}

				vbox = {
					name = "xar_cc_origin_tab"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					visible = "[GetVariableSystem.HasValue('xar_cc_tab', 'origin')]"
					using = Animation_Tab_Switch
					margin = { 25 12 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Localize('xar.cc.origin.help')]"
						default_format = "#high"
					}

					text_single = {
						text = "[Localize('xar.cc.dynasty_house')]"
						default_format = "#T"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						button_standard = {
							layoutpolicy_horizontal = expanding
							text = "[Localize('xar.cc.lowborn')]"
							datacontext = "[GetScriptedGui('xar_cc_choose_lowborn_gui')]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[GetScriptedGui('xar_cc_lowborn_selected_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						}
						button_standard = {
							layoutpolicy_horizontal = expanding
							text = "[Localize('xar.cc.same_house')]"
							datacontext = "[GetScriptedGui('xar_cc_choose_same_house_gui')]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[GetScriptedGui('xar_cc_same_house_selected_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 16

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 5

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "[Localize('xar.cc.culture')]"
								default_format = "#T"
								align = center|nobaseline
							}

							scrollbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
							blockoverride "scrollbox_content" {
								xar_cc_culture_catalog_list = {
									datamodel = "[GetGlobalList('xar_cc_catalog_culture_heritages')]"
								}
								}
							}
						}

						divider_light = {
							layoutpolicy_vertical = expanding
							size = { 2 0 }
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 5

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "[Localize('xar.cc.faith')]"
								default_format = "#T"
								align = center|nobaseline
							}

							scrollbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								blockoverride "scrollbox_content" {
									xar_cc_faith_catalog_list = {
										datamodel = "[GetPlayer.MakeScope.GetList('xar_cc_catalog_faiths')]"
									}
								}
							}
						}
					}
				}

				divider_light = {
					layoutpolicy_horizontal = expanding
					size = { 0 2 }
				}

				hbox = {
					name = "xar_cc_purchase_row"
					layoutpolicy_horizontal = expanding
					spacing = 10
					margin = { 20 2 }

					text_single = { text = "[Localize('xar.cc.price')]" default_format = "#high" align = nobaseline }
					text_single = {
						raw_text = "[GetPlayer.MakeScope.ScriptValue('xar_courtier_creator_cost')|0]"
						default_format = "#V"
						using = Font_Size_Medium
						align = nobaseline
					}
					text_single = { raw_text = "/" default_format = "#low" align = nobaseline }
					icon = { texture = "gfx/interface/icons/icon_gold.dds" size = { 28 28 } }
					text_single = {
						raw_text = "[GetPlayer.GetGold|0]"
						default_format = "#high"
						using = Font_Size_Medium
						align = nobaseline
					}

					expand = {}

					button_standard = {
						min_width = 210
						text = "[Localize('xar.cc.cancel')]"
						datacontext = "[GetScriptedGui('xar_cc_cancel_gui')]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}
					button_primary_big = {
						min_width = 260
						text = "[Localize('xar.cc.confirm')]"
						datacontext = "[GetScriptedGui('xar_cc_confirm_gui')]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}
				}
			}
		}
	}
}
