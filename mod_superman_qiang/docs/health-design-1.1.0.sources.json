            },
            {
              "line": 199,
              "text": "\tHEALTH_STATE_LEVELS_TEXTS = {"
            },
            {
              "line": 200,
              "text": "\t\t\"HEALTH_DYING\""
            },
            {
              "line": 201,
              "text": "\t\t\"HEALTH_NEAR_DEATH\""
