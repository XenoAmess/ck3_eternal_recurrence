            }
          ]
        },
        {
          "first": 325,
          "last": 338,
          "lines": [
            {
              "line": 325,
              "text": "NOldAge = {"
            },
            {
              "line": 326,
              "text": "\tLOWER_HEALTH_START_AGE = 25 # At this age characters start getting the chance to lose health each year"
            },
            {
              "line": 327,
              "text": "\tLOWER_HEALTH_BASE_CHANCE = 0.075 # This is the base chance of losing health at the START_AGE"
            },
            {
              "line": 328,
              "text": "\tLOWER_HEALTH_YEARLY_INCREASE = 0.022 # This is the yearly increase of the chance to lose health"
            },
            {
              "line": 329,
              "text": "\tLOWER_HEALTH_AMOUNT = -0.125 # This is the health change on each failed yearly health roll"
            },
            {
              "line": 330,
              "text": "\tHEALTH_PENALTY_PER_YEAR_IN_POOL = 0.1 # For each year in the pool, your effective health is this much lower. This disappears entirely when you leave the pool"
            },
            {
              "line": 331,
              "text": "\tELDERLY_POOL_HEALTH_PENALTY = 2.0 # Elderly characters in the pool will have their effective health reduced by this amount for death checks"
            },
            {
              "line": 332,
              "text": ""
            },
            {
              "line": 333,
              "text": "\t# This DIE values are used with a quadratic chance."
            },
            {
              "line": 334,
              "text": "\tDIE_HEALTH_TRESHOLD = 3.0 # Characters have a chance to die each month they have less health than this"
            },
            {
              "line": 335,
              "text": "\tDIE_HEALTH_CHANCE_ZERO = 0.25 # This is the month chance that a character dies at zero health (or lower)"
            },
            {
              "line": 336,
              "text": ""
            },
            {
              "line": 337,
              "text": "\tDEATH_MINIMUM_DELAY = 15 # If marked for death, they will die at least this many days after the check"
            },
            {
              "line": 338,
              "text": "\tDEATH_MAXIMUM_DELAY = 20 # If marked for death, they will die no more than this many days after the check. With these numbers, that means if someone becomes deathly ill, they have a high chance of dying between 7 and 40 days (30 days from the death check) after contracting the health penalty"
            }
          ]
        },
        {
          "first": 387,
          "last": 389,
          "lines": [
            {
              "line": 387,
              "text": "\tNEWBORN_HEALTH_BASE = 4.5"
            },
            {
              "line": 388,
              "text": "\tNEWBORN_HEALTH_SPAN = 0.5"
            },
            {
              "line": 389,
              "text": "\tNEWBORN_HEALTH_FEMALE_BONUS = 0.5"
            }
          ]
        }
      ]
