          "lines": [
            {
              "line": 113,
              "text": "\tRANDOM_CHARACTER_MIN_HEALTH = 4.0"
            },
            {
              "line": 114,
              "text": "\tRANDOM_CHARACTER_MAX_HEALTH = 5.0"
            },
            {
              "line": 115,
              "text": "\tRANDOM_CHARACTER_AGE_MIN_HEALTH = 2.5 # This is the minimum starting base health characters get after adjustments for age"
            }
          ]
