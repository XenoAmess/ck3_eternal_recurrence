      "excerpts": [
        {
          "first": 12,
          "last": 23,
          "lines": [
            {
              "line": 12,
              "text": "\t# Modifier can have scale that'll be calculated once when effect assigns a modifier, and later"
            },
            {
              "line": 13,
              "text": "\t# remains unchanged for the entire modifier duration"
            },
            {
              "line": 14,
              "text": "\tscale = {"
            },
            {
              "line": 15,
              "text": ""
            },
            {
              "line": 16,
              "text": "\t\t# Scripted value - can be named value or direct math here"
            },
            {
              "line": 17,
              "text": "\t\t# Root scope is the object that's going to get the modifier"
            },
            {
              "line": 18,
              "text": "\t\t# Scripted value top level description will be added to modifier description"
            },
            {
              "line": 19,
              "text": "\t\tvalue = scale_scripted_value"
            },
            {
              "line": 20,
              "text": ""
            },
            {
              "line": 21,
              "text": "\t\t# Loc key that's used for base level entry, to show alongside with the scaled value"
            },
            {
              "line": 22,
              "text": "\t\tdesc = base_value_description"
            },
            {
              "line": 23,
              "text": "\t}"
            }
          ]
        }
      ]
    },
