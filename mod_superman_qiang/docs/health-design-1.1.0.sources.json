            {
              "line": 1,
              "text": "# Dependencies:"
            },
            {
              "line": 2,
              "text": "#\t_basic_values.txt"
            },
            {
              "line": 3,
              "text": ""
            },
            {
              "line": 4,
              "text": "# When their health drop too low and they're slated for death, a character will die within 15-50 days (based on DEATH_MAXIMUM_DELAY , DEATH_MINIMUM_DELAY and DEATH_CHECK_INTERVAL in defines)"
            }
          ]
        },
        {
          "first": 21,
          "last": 26,
          "lines": [
