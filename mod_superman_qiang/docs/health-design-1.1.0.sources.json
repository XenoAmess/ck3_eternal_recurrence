    {
      "path": "C:\\SteamLibrary\\steamapps\\common\\Crusader Kings III\\game\\common\\scripted_triggers\\20_health_triggers.txt",
      "bytes": 23193,
      "sha256": "2846f0591e692814a907bb111c161bb8124798af5a972bd2d3344de69799c883",
      "excerpts": [
        {
          "first": 25,
          "last": 56,
          "lines": [
            {
              "line": 25,
              "text": "# Will this character suffer age-related health issues, factoring how healthy they actually are vs. what their age is?"
            },
            {
              "line": 26,
              "text": "age_ranked_health_vulnerability_threshold_trigger = {"
            },
            {
              "line": 27,
              "text": "\tOR = {"
            },
            {
              "line": 28,
              "text": "\t\t# If you're already having problems..."
            },
            {
              "line": 29,
              "text": "\t\thas_trait = infirm"
            },
            {
              "line": 30,
              "text": "\t\t# Otherwise, we check health crossed against age."
            },
            {
              "line": 31,
              "text": "\t\t## Characters that are this old are vulnerable regardless of health."
            },
            {
              "line": 32,
              "text": "\t\tage >= 80"
            },
            {
              "line": 33,
              "text": "\t\t## Else, the higher your health is, the older you need to be to suffer age-related health problems."
            },
            {
              "line": 34,
              "text": "\t\tAND = {"
            },
            {
              "line": 35,
              "text": "\t\t\thealth <= good_health"
            },
            {
              "line": 36,
              "text": "\t\t\tage >= 70"
            },
            {
              "line": 37,
              "text": "\t\t}"
            },
            {
              "line": 38,
              "text": "\t\tAND = {"
            },
            {
              "line": 39,
              "text": "\t\t\thealth <= medium_health"
            },
            {
              "line": 40,
              "text": "\t\t\tage >= 60"
            },
            {
              "line": 41,
              "text": "\t\t}"
            },
            {
              "line": 42,
              "text": "\t\tAND = {"
            },
            {
              "line": 43,
              "text": "\t\t\thealth <= fine_health"
            },
            {
              "line": 44,
              "text": "\t\t\tage >= 50"
            },
            {
              "line": 45,
              "text": "\t\t}"
            },
            {
              "line": 46,
              "text": "\t\tAND = {"
            },
            {
              "line": 47,
              "text": "\t\t\thealth <= poor_health"
            },
            {
              "line": 48,
              "text": "\t\t\tage >= 40"
            },
            {
              "line": 49,
              "text": "\t\t}"
            },
            {
              "line": 50,
              "text": "\t\tAND = {"
            },
            {
              "line": 51,
              "text": "\t\t\thealth <= dying_health"
            },
            {
              "line": 52,
              "text": "\t\t\tage >= 30"
            },
            {
              "line": 53,
              "text": "\t\t}"
            },
            {
              "line": 54,
              "text": "\t}"
            },
            {
              "line": 55,
              "text": "\tNOT = { has_trait_with_flag = is_immortal }"
            },
            {
              "line": 56,
              "text": "}"
            }
          ]
        },
        {
