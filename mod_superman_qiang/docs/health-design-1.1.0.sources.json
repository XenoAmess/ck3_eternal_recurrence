              "line": 21,
              "text": ""
            },
            {
              "line": 22,
              "text": "### RECOVERY TIMES ###"
            },
            {
              "line": 23,
              "text": "minimum_recovery_time = 51 #Needs to be higher than 50 (the longest amount of days between health change and death, so that a character can't recover before they're slated to be checked for death)"
            },
            {
              "line": 24,
              "text": ""
            },
            {
              "line": 25,
              "text": "ill_recovery_min = minimum_recovery_time"
            },
            {
              "line": 26,
              "text": "ill_recovery_max = 365"
            }
          ]
        }
      ]
