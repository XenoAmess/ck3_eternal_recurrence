    {
      "path": "C:\\SteamLibrary\\steamapps\\common\\Crusader Kings III\\game\\common\\script_values\\10_health_values.txt",
      "bytes": 15014,
      "sha256": "787d22ed5a482e2abaf5bd6f7a4a2ef257f77fc3b0636104108a62020fb7e90a",
