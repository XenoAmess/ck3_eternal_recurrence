          "first": 150,
          "last": 150,
          "lines": [
            {
              "line": 150,
              "text": "\tBASE_HEALTH = 5.0"
            }
          ]
        },
        {
          "first": 192,
          "last": 205,
          "lines": [
            {
              "line": 192,
              "text": "\tHEALTH_STATE_LEVELS_VALUES = {"
            },
            {
              "line": 193,
              "text": "\t\t0.0"
